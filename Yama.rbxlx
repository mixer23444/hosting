local function fmtTime(seconds)
	seconds = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function ratio(value, maxValue)
	if not maxValue or maxValue <= 0 then
		return 0
	end
	return math.clamp(value / maxValue, 0, 1)
end

local function paintBox(box, titleText, seconds, locked, lockLabel)
	box.title.Text = titleText
	if locked then
		box.cd.Text = lockLabel
		box.cd.TextColor3 = MUTED
		box.frame.BackgroundColor3 = Color3.fromRGB(32, 34, 30)
	elseif seconds and seconds > 0.05 then
		box.cd.Text = string.format("%d сек", math.ceil(seconds))
		box.cd.TextColor3 = GOLD
		box.frame.BackgroundColor3 = Color3.fromRGB(48, 40, 28)
	else
		box.cd.Text = "готово"
		box.cd.TextColor3 = Color3.fromRGB(154, 204, 132)
		box.frame.BackgroundColor3 = Color3.fromRGB(28, 42, 30)
	end
end

local function paintSlot(slot, owned, seconds)
	if not owned then
		slot.state.Text = "нет"
		slot.state.TextColor3 = MUTED
		slot.frame.BackgroundColor3 = Color3.fromRGB(26, 30, 26)
		return
	end
	if seconds and seconds > 0.05 then
		slot.state.Text = string.format("%d c", math.ceil(seconds))
		slot.state.TextColor3 = GOLD
		slot.frame.BackgroundColor3 = Color3.fromRGB(48, 40, 28)
	else
		slot.state.Text = "готово"
		slot.state.TextColor3 = Color3.fromRGB(154, 204, 132)
		slot.frame.BackgroundColor3 = Color3.fromRGB(28, 42, 30)
	end
end

local function applyState(packet)
	if typeof(packet) ~= "table" then
		return
	end
	status.Text = packet.status or ""
	if packet.phase == "fight" then
		timer.Text = fmtTime(packet.timeLeft or 0)
	elseif packet.phase == "countdown" then
		timer.Text = "старт"
	else
		timer.Text = "парк открыт"
	end
	local you = packet.you
	local picked = you and you.fighter
	picker.Visible = packet.phase ~= "ending" and (not picked or packet.phase == "lobby" or packet.phase == "countdown")
	dock.Visible = not picker.Visible
	if you and picked then
		nameLabel.Text = DISPLAY[you.fighter] or you.fighter
		accent.BackgroundColor3 = FIGHTER_COLOR[you.fighter] or MOSS
		local nextXp = you.nextXp or you.xp
		if you.level >= 6 then
			levelLabel.Text = "уровень 6"
			xpFill.Size = UDim2.fromScale(1, 1)
		else
			levelLabel.Text = string.format("уровень %d     %d / %d", you.level, you.xp, nextXp)
			xpFill.Size = UDim2.fromScale(ratio(you.xp, nextXp), 1)
		end
		hpFill.Size = UDim2.fromScale(ratio(you.hp, you.maxHp), 1)
		manaFill.Size = UDim2.fromScale(ratio(you.mana, you.maxMana), 1)
		hpText.Text = string.format("жизнь  %d / %d", you.hp or 0, you.maxHp or 0)
		manaText.Text = string.format("мана  %d / %d", you.mana or 0, you.maxMana or 0)
		local extra = ""
		if you.shield and you.shield > 0 then
			extra ..= "щит " .. you.shield
		end
		if you.rooted then
			extra ..= (extra ~= "" and "   " or "") .. "врос"
		end
		if you.items and you.items.baton then
			extra ..= (extra ~= "" and "   " or "") .. "батон"
		end
		stateLabel.Text = extra
		goldLabel.Text = tostring(you.gold) .. " золота"
		killLabel.Text = tostring(you.kills) .. " убийств     смертей " .. tostring(you.deaths)
		local names = NAMES[you.fighter] or { "Q", "E", "R" }
		paintBox(boxes.q, names[1], you.cd.q, false, "")
		paintBox(boxes.e, names[2], you.cd.e, you.lockE, "со 2 уровня")
		paintBox(boxes.r, names[3], you.cd.r, you.lockR, "с 4 уровня")
		paintSlot(slots.jacket, you.items and you.items.jacket, you.cd.jacket)
		paintSlot(slots.whistle, you.items and you.items.whistle, you.cd.whistle)
		paintSlot(slots.energy, you.items and you.items.energy, you.cd.energy)
		slots.tap.state.Text = "жми"
		slots.tap.state.TextColor3 = GOLD
		shop.Visible = you.nearShop == true and packet.phase == "fight" and not picker.Visible
		for id, widget in shopButtons do
			local owned = you.items and you.items[id]
			widget.price.Text = owned and "есть" or widget.price.Text
			if not owned then
				for _, spec in shopItems do
					if spec.id == id then
						widget.price.Text = spec.price
					end
				end
			end
			widget.button.AutoButtonColor = not owned
			widget.button.BackgroundColor3 = owned and Color3.fromRGB(48, 56, 46) or Color3.fromRGB(36, 52, 34)
		end
	else
		nameLabel.Text = "Боец не выбран"
		accent.BackgroundColor3 = MOSS
		levelLabel.Text = "выбери карточку"
		goldLabel.Text = ""
		killLabel.Text = ""
		stateLabel.Text = ""
		hpText.Text = "жизнь"
		manaText.Text = "мана"
		hpFill.Size = UDim2.fromScale(0, 1)
		manaFill.Size = UDim2.fromScale(0, 1)
		xpFill.Size = UDim2.fromScale(0, 1)
		shop.Visible = false
	end
	for index = 1, 8 do
		local row = packet.board and packet.board[index]
		local line = boardRows[index]
		if row then
			line.Text = string.format("%d     %s     %s", row.kills or 0, row.fighter or "", row.name or "")
			line.TextColor3 = (row.name == player.DisplayName) and GOLD or INK
		else
			line.Text = ""
		end
	end
end

local function aimPoint()
	local camera = workspace.CurrentCamera
	local viewport = camera.ViewportSize
	local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, workspace:FindFirstChild("YamaFx") }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	if hit then
		return hit.Position
	end
	return ray.Origin + ray.Direction * 80
end

local function bindCamera(character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end
	humanoid.CameraOffset = Vector3.new(1.75, 0.35, 0)
	humanoid.AutoRotate = false
	player.CameraMinZoomDistance = 10
	player.CameraMaxZoomDistance = 16
	local camera = workspace.CurrentCamera
	camera.CameraSubject = humanoid
	camera.CameraType = Enum.CameraType.Custom
end

player.CharacterAdded:Connect(function(character)
	task.defer(function()
		bindCamera(character)
	end)
end)
if player.Character then
	task.defer(function()
		bindCamera(player.Character)
	end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local action = nil
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		action = "attack"
	else
		action = KEYS[input.KeyCode]
	end
	if action then
		actionRemote:FireServer(action, aimPoint())
	end
end)

stateRemote.OnClientEvent:Connect(applyState)

RunService:BindToRenderStep("YamaShiftLock", Enum.RenderPriority.Camera.Value + 1, function()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	local menu = picker.Visible or shop.Visible
	if menu or not humanoid or not root or humanoid.Health <= 0 then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		cross.Visible = false
		if humanoid then
			humanoid.AutoRotate = true
		end
		return
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false
	humanoid.AutoRotate = false
	humanoid.CameraOffset = Vector3.new(1.75, 0.35, 0)
	cross.Visible = true
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 0.05 then
		root.CFrame = CFrame.new(root.Position, root.Position + flat)
	end
end)

RunService.RenderStepped:Connect(function()
	for _, other in Players:GetPlayers() do
		local character = other.Character
		if character then
			local hidden = character:GetAttribute("YamaInvis") == true
			for _, piece in character:GetDescendants() do
				if piece:IsA("BasePart") then
					if hidden then
						piece.LocalTransparencyModifier = other == player and 0.55 or 1
					else
						piece.LocalTransparencyModifier = 0
					end
				end
			end
		end
	end
end)]]></ProtectedString>
      </Properties>
    </Item>
    </Item>
