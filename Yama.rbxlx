				color = Color3.fromRGB(255, 206, 120),
				material = Enum.Material.Neon,
				collide = false,
				query = false,
			})
		end
	end

	local shopCf = CFrame.lookAt(Vector3.new(shopPos.X, 3.3, shopPos.Z), Vector3.new(0, 3.3, 0))
	part({
