<roblox version="4">
  <Item class="Workspace" referent="0">
    <Properties>
      <string name="Name">Workspace</string>
    </Properties>
  </Item>
  <Item class="Lighting" referent="1">
    <Properties>
      <string name="Name">Lighting</string>
      <float name="ClockTime">13.5</float>
      <float name="GeographicLatitude">20</float>
      <token name="Technology">4</token>
    </Properties>
  </Item>
  <Item class="ServerScriptService" referent="2">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="3">
      <Properties>
        <string name="Name">Yama</string>
        <ProtectedString name="Source"><![CDATA[-- Яма. Отдельный плейс, без Rojo. Открой Yama.rbxlx в Studio и нажми Play.
-- Гараж этот скрипт не трогает. Бой считает сервер.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")

Players.RespawnTime = 6
Players.CharacterAutoLoads = true

local MATCH_LEN = 480
local CREATURE_AT = 240
local COUNTDOWN = 3
local WIN_KILLS = 20
local LEVEL_XP = { 0, 50, 120, 220, 360, 540 }

local FIGHTERS = {
	dictor = { name = "Диктор", color = Color3.fromRGB(92, 154, 230), hp = 860, speed = 17, ranged = true, basic = 26, reach = 8, cd = 0.42 },
	tumba = { name = "Тумба", color = Color3.fromRGB(198, 114, 66), hp = 1280, speed = 14, ranged = false, basic = 44, reach = 8, cd = 0.52 },
	otrazhatel = { name = "Отражатель", color = Color3.fromRGB(224, 198, 92), hp = 980, speed = 16, ranged = false, basic = 34, reach = 8, cd = 0.46 },
	dvornik = { name = "Дворник", color = Color3.fromRGB(86, 168, 112), hp = 1040, speed = 15, ranged = false, basic = 32, reach = 8, cd = 0.5 },
}

local ABILITIES = {
	dictor = { q = { 20, 8 }, e = { 15, 12 }, r = { 40, 18 } },
	tumba = { q = { 10, 11 }, e = { 15, 8 }, r = { 20, 10 } },
	otrazhatel = { q = { 15, 9 }, e = { 20, 7 }, r = { 25, 11 } },
	dvornik = { q = { 25, 7 }, e = { 20, 10 }, r = { 35, 14 } },
}

local ITEMS = {
	baton = { name = "Батон", price = 250 },
	jacket = { name = "Куртка", price = 500 },
	whistle = { name = "Свисток", price = 350 },
	energy = { name = "Энергетик", price = 200 },
}

local pickRemote = Instance.new("RemoteEvent")
pickRemote.Name = "YamaPick"
pickRemote.Parent = ReplicatedStorage
local actionRemote = Instance.new("RemoteEvent")
actionRemote.Name = "YamaAction"
actionRemote.Parent = ReplicatedStorage
local stateRemote = Instance.new("RemoteEvent")
stateRemote.Name = "YamaState"
stateRemote.Parent = ReplicatedStorage

local mapFolder = Instance.new("Folder")
mapFolder.Name = "Park"
mapFolder.Parent = workspace
local fxFolder = Instance.new("Folder")
fxFolder.Name = "YamaFx"
fxFolder.Parent = workspace

local phase = "lobby"
local countdownEnd = 0
local matchEnd = 0
local creatureTime = 0
local winnerText = ""
local roundSerial = 0
local shopPos = Vector3.new(118, 3, 40)
local playersState = {}
local dummyByModel = {}
local turrets = {}
local projectiles = {}
local creature = nil
local creatureCd = {}
local pushStamp = 0

local function part(props)
	local item = Instance.new(props.class or "Part")
	item.Name = props.name or "Part"
	item.Anchored = props.anchored ~= false
	item.CanCollide = props.collide ~= false
	item.CanQuery = props.query ~= false
	item.Size = props.size or Vector3.new(4, 1, 4)
	item.CFrame = props.cf or CFrame.new()
	item.Color = props.color or Color3.fromRGB(220, 220, 220)
	item.Material = props.material or Enum.Material.Concrete
	item.TopSurface = Enum.SurfaceType.Smooth
	item.BottomSurface = Enum.SurfaceType.Smooth
	item.Transparency = props.transparency or 0
	if props.shape then
		item.Shape = props.shape
	end
	item.Parent = props.parent or mapFolder
	return item
end

local function buildWorld()
	-- Парк собирается заново при каждом Play. Картинок нет: только материалы Studio.
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(150, 160, 148)
	Lighting.OutdoorAmbient = Color3.fromRGB(172, 182, 166)
	Lighting.EnvironmentDiffuseScale = 0.55
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.GlobalShadows = true
	Lighting.GeographicLatitude = 18
	Lighting.FogColor = Color3.fromRGB(198, 220, 214)
	Lighting.FogStart = 280
	Lighting.FogEnd = 640

	local oldSky = Lighting:FindFirstChildOfClass("Sky")
	if oldSky then
		oldSky:Destroy()
	end

	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.26
	atmo.Offset = 0.25
	atmo.Color = Color3.fromRGB(206, 224, 220)
	atmo.Decay = Color3.fromRGB(196, 214, 206)
	atmo.Glare = 0.12
	atmo.Haze = 1.35
	atmo.Parent = Lighting

	local sun = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect")
	sun.Intensity = 0.04
	sun.Spread = 0.55
	sun.Parent = Lighting

	local base = workspace:FindFirstChild("Baseplate")
	if base then
		base:Destroy()
	end

	local function folder(name)
		local item = Instance.new("Folder")
		item.Name = name
		item.Parent = mapFolder
		return item
	end

	local ground = folder("Ground")
	local paths = folder("Paths")
	local water = folder("Water")
	local trees = folder("Trees")
	local cover = folder("Cover")
	local props = folder("Props")
	local cliffs = folder("Cliffs")
	local lobby = folder("Lobby")
	local shopFolder = folder("Shop")

	local function disk(name, parent, diameter, thickness, topY, color, material)
		part({
			name = name,
			parent = parent,
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(thickness, diameter, diameter),
			cf = CFrame.new(0, topY - thickness / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
			color = color,
			material = material,
		})
	end

	disk("Meadow", ground, 980, 10, 1, Color3.fromRGB(118, 148, 74), Enum.Material.Grass)
	disk("Lawn", ground, 360, 0.7, 1.2, Color3.fromRGB(132, 168, 82), Enum.Material.Grass)
	disk("Clearing", ground, 46, 0.35, 1.42, Color3.fromRGB(214, 196, 148), Enum.Material.Sand)

	part({
		name = "PathEW",
		parent = paths,
		size = Vector3.new(300, 0.28, 12),
		cf = CFrame.new(0, 1.34, 0),
		color = Color3.fromRGB(164, 142, 108),
		material = Enum.Material.Cobblestone,
	})
	part({
		name = "PathNS",
		parent = paths,
		size = Vector3.new(12, 0.28, 300),
		cf = CFrame.new(0, 1.34, 0),
		color = Color3.fromRGB(156, 136, 104),
		material = Enum.Material.Cobblestone,
	})

	local pond = Vector3.new(-88, 0, 62)
	part({
		name = "Shore",
		parent = water,
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.4, 64, 64),
		cf = CFrame.new(pond.X, 1.32, pond.Z) * CFrame.Angles(0, 0, math.rad(90)),
		color = Color3.fromRGB(206, 186, 140),
		material = Enum.Material.Sand,
		collide = false,
		query = false,
	})
	part({
		name = "Pond",
		parent = water,
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.5, 46, 46),
		cf = CFrame.new(pond.X, 1.42, pond.Z) * CFrame.Angles(0, 0, math.rad(90)),
		color = Color3.fromRGB(72, 142, 168),
		material = Enum.Material.Glass,
		transparency = 0.15,
		collide = false,
		query = false,
	})

	local function blocked(x, z, radius)
		local flat = Vector3.new(x, 0, z)
		if (flat - pond).Magnitude < radius + 20 then
			return true
		end
		if (flat - Vector3.new(shopPos.X, 0, shopPos.Z)).Magnitude < radius + 14 then
			return true
		end
		if math.abs(x) < 10 or math.abs(z) < 10 then
			return true
		end
		return false
	end

	local function tree(x, z, scale)
		if blocked(x, z, 6) then
			return
		end
		local trunkH = 8 + scale * 1.4
		part({
			name = "Trunk",
			parent = trees,
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(trunkH, 1.5 + scale * 0.08, 1.5 + scale * 0.08),
			cf = CFrame.new(x, 1.2 + trunkH / 2, z) * CFrame.Angles(0, 0, math.rad(90)),
			color = Color3.fromRGB(118, 82, 50),
			material = Enum.Material.Wood,
		})
		local crown = 1.2 + trunkH
		local greens = {
			Color3.fromRGB(46, 96, 44),
			Color3.fromRGB(70, 124, 58),
			Color3.fromRGB(98, 150, 68),
			Color3.fromRGB(58, 108, 50),
		}
		part({
			name = "Canopy",
			parent = trees,
			shape = Enum.PartType.Ball,
			size = Vector3.new(6.2 + scale * 0.6, 4.4 + scale * 0.2, 6.2 + scale * 0.6),
			cf = CFrame.new(x, crown + 1.1, z),
			color = greens[1],
			material = Enum.Material.Grass,
			collide = false,
			query = false,
		})
		for i = 1, 6 do
			local yaw = (i / 6) * math.pi * 2 + scale * 0.35
			local ring = 2.1 + (i % 2) * 1.15
			local lift = ((i % 3) - 1) * 1.05
			part({
				name = "Leaf",
				parent = trees,
				shape = Enum.PartType.Ball,
				size = Vector3.new(3.1 + (i % 2) * 0.8, 2.2, 3.1 + (i % 2) * 0.8),
				cf = CFrame.new(x + math.cos(yaw) * ring, crown + 1.5 + lift, z + math.sin(yaw) * ring),
				color = greens[(i % #greens) + 1],
				material = Enum.Material.Grass,
				collide = false,
				query = false,
			})
		end
		for i = 1, 3 do
			local yaw = (i / 3) * math.pi * 2 + 0.4
			part({
				name = "LeafTip",
				parent = trees,
				class = "WedgePart",
				size = Vector3.new(1.3, 2.4, 2.8),
				cf = CFrame.new(x + math.cos(yaw) * 3.1, crown + 2.4, z + math.sin(yaw) * 3.1) * CFrame.Angles(0, -yaw, math.rad(78)),
				color = greens[(i % #greens) + 1],
				material = Enum.Material.Grass,
				collide = false,
				query = false,
			})
		end
	end

	for n = 1, 10 do
		local angle = (n / 10) * math.pi * 2 + 0.35
		tree(math.cos(angle) * 78, math.sin(angle) * 78, 2 + (n % 3))
	end
	for n = 1, 16 do
		local angle = (n / 16) * math.pi * 2 + 0.1
		local radius = 112 + (n % 3) * 12
		tree(math.cos(angle) * radius, math.sin(angle) * radius, 3 + (n % 4))
	end
	for n = 1, 20 do
		local angle = (n / 20) * math.pi * 2 + 0.22
		local radius = 152 + (n % 4) * 6
		tree(math.cos(angle) * radius, math.sin(angle) * radius, 2 + (n % 3))
	end

	for n = 1, 8 do
		local angle = (n / 8) * math.pi * 2 + 0.5
		local x = math.cos(angle) * 46
		local z = math.sin(angle) * 46
		if not blocked(x, z, 4) then
			local height = 5 + (n % 3) * 2
			part({
				name = "Boulder",
				parent = cover,
				size = Vector3.new(7 + (n % 2) * 3, height, 8 + (n % 3)),
				cf = CFrame.new(x, 1.2 + height / 2, z) * CFrame.Angles(0, angle, math.rad((n % 5) - 2)),
				color = Color3.fromRGB(150, 146, 138),
				material = Enum.Material.Slate,
			})
		end
	end

	for n = 1, 8 do
		local angle = (n / 8) * math.pi * 2
		local cf = CFrame.lookAt(Vector3.new(math.cos(angle) * 62, 1.6, math.sin(angle) * 62), Vector3.new(0, 1.6, 0))
		part({
			name = "Bench",
			parent = props,
			size = Vector3.new(5.2, 0.35, 1.4),
			cf = cf * CFrame.new(0, 0.55, 0),
			color = Color3.fromRGB(150, 104, 64),
			material = Enum.Material.WoodPlanks,
		})
		part({
			name = "BenchBack",
			parent = props,
			size = Vector3.new(5.2, 1.4, 0.28),
			cf = cf * CFrame.new(0, 1.25, 0.6),
			color = Color3.fromRGB(132, 90, 54),
			material = Enum.Material.Wood,
			collide = false,
		})
	end

	for n = 1, 28 do
		local angle = (n / 28) * math.pi * 2
		local radius = 168 + (n % 3) * 4
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		part({
			name = "Bush",
			parent = props,
			shape = Enum.PartType.Ball,
			size = Vector3.new(3.6, 2.4, 3.6),
			cf = CFrame.new(x, 2.3, z),
			color = (n % 2 == 0) and Color3.fromRGB(70, 128, 64) or Color3.fromRGB(96, 150, 74),
			material = Enum.Material.Grass,
			collide = false,
			query = false,
		})
		local bloom = {
			Color3.fromRGB(214, 96, 102),
			Color3.fromRGB(236, 196, 92),
			Color3.fromRGB(236, 236, 232),
		}
		part({
			name = "Flower",
			parent = props,
			shape = Enum.PartType.Ball,
			size = Vector3.new(0.9, 0.9, 0.9),
			cf = CFrame.new(x + 0.6, 3.4, z),
			color = bloom[(n % 3) + 1],
			material = Enum.Material.SmoothPlastic,
			collide = false,
			query = false,
		})
	end

	local function cliff(parent, angle, radius, height, width, depth, color, material)
		local pos = Vector3.new(math.cos(angle) * radius, height / 2 - 6, math.sin(angle) * radius)
		local cf = CFrame.lookAt(pos, Vector3.new(0, pos.Y, 0))
		part({
			name = "Cliff",
			parent = parent,
			size = Vector3.new(width, height, depth),
			cf = cf,
			color = color,
			material = material,
		})
		return cf, height
	end

	for i = 1, 36 do
		local angle = (i / 36) * math.pi * 2
		local radius = 232 + (i % 5) * 6
		local height = 46 + (i % 7) * 8
		local tone = 142 + (i % 4) * 10
		local cf = cliff(cliffs, angle, radius, height, 52, 36, Color3.fromRGB(tone, tone - 6, tone - 12), Enum.Material.Slate)
		part({
			name = "Cap",
			parent = cliffs,
			size = Vector3.new(30, height * 0.42, 22),
			cf = cf * CFrame.new((i % 2 == 0) and 8 or -8, height * 0.28, 4),
			color = Color3.fromRGB(tone - 18, tone - 20, tone - 22),
			material = Enum.Material.Basalt,
		})
		part({
			name = "Shoulder",
			parent = cliffs,
			size = Vector3.new(24, height * 0.55, 28),
			cf = cf * CFrame.new((i % 2 == 0) and -20 or 20, -height * 0.12, 8),
			color = Color3.fromRGB(tone + 6, tone, tone - 4),
			material = Enum.Material.Slate,
		})
	end

	for i = 1, 22 do
		local angle = (i / 22) * math.pi * 2 + 0.07
		local height = 92 + (i % 5) * 16
		local tone = 118 + (i % 3) * 8
		cliff(cliffs, angle, 318 + (i % 3) * 8, height, 78, 48, Color3.fromRGB(tone, tone - 4, tone - 8), Enum.Material.Basalt)
	end

	for i = 1, 42 do
		local angle = (i / 42) * math.pi * 2
		local pos = Vector3.new(math.cos(angle) * 186, 1.05, math.sin(angle) * 186)
		local cf = CFrame.lookAt(pos, Vector3.new(0, 1.05, 0))
		part({
			name = "Walk",
			parent = lobby,
			size = Vector3.new(32, 0.9, 18),
			cf = cf,
			color = Color3.fromRGB(158, 150, 140),
			material = Enum.Material.Cobblestone,
		})
		part({
			name = "Rail",
			parent = lobby,
			size = Vector3.new(30, 2.4, 0.6),
			cf = cf * CFrame.new(0, 1.6, -7),
			color = Color3.fromRGB(132, 92, 58),
			material = Enum.Material.Wood,
			collide = false,
		})
	end

	local shopCf = CFrame.lookAt(Vector3.new(shopPos.X, 3.3, shopPos.Z), Vector3.new(0, 3.3, 0))
	part({
		name = "Deck",
		parent = shopFolder,
		size = Vector3.new(16, 0.28, 11),
		cf = shopCf * CFrame.new(0, -2.15, -0.6),
		color = Color3.fromRGB(118, 84, 50),
		material = Enum.Material.WoodPlanks,
		collide = false,
		query = false,
	})
	local function stallPost(offset)
		part({
			name = "Post",
			parent = shopFolder,
			size = Vector3.new(0.5, 7.4, 0.5),
			cf = shopCf * CFrame.new(offset),
			color = Color3.fromRGB(102, 70, 42),
			material = Enum.Material.Wood,
		})
	end
	stallPost(Vector3.new(-6.4, 1.3, -3.6))
	stallPost(Vector3.new(6.4, 1.3, -3.6))
	stallPost(Vector3.new(-6.4, 1.3, 2.2))
	stallPost(Vector3.new(6.4, 1.3, 2.2))
	part({
		name = "Beam",
		parent = shopFolder,
		size = Vector3.new(13.6, 0.4, 0.4),
		cf = shopCf * CFrame.new(0, 4.85, -3.6),
		color = Color3.fromRGB(92, 62, 38),
		material = Enum.Material.Wood,
		collide = false,
	})
	part({
		name = "Awning",
		parent = shopFolder,
		size = Vector3.new(14.2, 0.16, 7.2),
		cf = shopCf * CFrame.new(0, 4.55, -1.1) * CFrame.Angles(math.rad(-7), 0, 0),
		color = Color3.fromRGB(72, 122, 78),
		material = Enum.Material.Fabric,
		collide = false,
		query = false,
	})
	part({
		name = "AwningStripe",
		parent = shopFolder,
		size = Vector3.new(14.2, 0.14, 1.15),
		cf = shopCf * CFrame.new(0, 4.28, -3.8) * CFrame.Angles(math.rad(-7), 0, 0),
		color = Color3.fromRGB(214, 196, 118),
		material = Enum.Material.Fabric,
		collide = false,
		query = false,
	})
	part({
		name = "BackWall",
		parent = shopFolder,
		size = Vector3.new(12.6, 3.4, 0.35),
		cf = shopCf * CFrame.new(0, 0.15, 2.15),
		color = Color3.fromRGB(142, 98, 58),
		material = Enum.Material.WoodPlanks,
	})
	local counter = part({
		name = "Counter",
		parent = shopFolder,
		size = Vector3.new(11.2, 3.6, 2.6),
		cf = shopCf * CFrame.new(0, -0.2, -0.2),
		color = Color3.fromRGB(164, 114, 68),
		material = Enum.Material.Wood,
	})
	part({
		name = "CounterTop",
		parent = shopFolder,
		size = Vector3.new(11.8, 0.28, 3.1),
		cf = shopCf * CFrame.new(0, 1.7, -0.15),
		color = Color3.fromRGB(214, 208, 198),
		material = Enum.Material.Marble,
		collide = false,
	})
	part({
		name = "Shelf",
		parent = shopFolder,
		size = Vector3.new(10.4, 0.24, 1.4),
		cf = shopCf * CFrame.new(0, 0.55, 1.35),
		color = Color3.fromRGB(132, 92, 54),
		material = Enum.Material.WoodPlanks,
	})
	part({
		name = "Loaf",
		parent = shopFolder,
		shape = Enum.PartType.Ball,
		size = Vector3.new(1.15, 0.7, 0.75),
		cf = shopCf * CFrame.new(-3.4, 1.05, 1.35),
		color = Color3.fromRGB(214, 176, 112),
		material = Enum.Material.SmoothPlastic,
		collide = false,
		query = false,
	})
	part({
		name = "Jacket",
		parent = shopFolder,
		size = Vector3.new(1.35, 0.4, 0.95),
		cf = shopCf * CFrame.new(-1.2, 0.9, 1.35),
		color = Color3.fromRGB(78, 112, 156),
		material = Enum.Material.Fabric,
		collide = false,
		query = false,
	})
	part({
		name = "Whistle",
		parent = shopFolder,
		shape = Enum.PartType.Ball,
		size = Vector3.new(0.42, 0.42, 0.42),
		cf = shopCf * CFrame.new(1.15, 0.85, 1.35),
		color = Color3.fromRGB(196, 198, 202),
		material = Enum.Material.Metal,
		collide = false,
		query = false,
	})
	part({
		name = "Bottle",
		parent = shopFolder,
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(1.25, 0.42, 0.42),
		cf = shopCf * CFrame.new(3.3, 1.15, 1.35) * CFrame.Angles(0, 0, math.rad(90)),
		color = Color3.fromRGB(86, 196, 112),
		material = Enum.Material.Glass,
		transparency = 0.15,
		collide = false,
		query = false,
	})
	part({
		name = "Crate",
		parent = shopFolder,
		size = Vector3.new(2.2, 2.2, 2.2),
		cf = shopCf * CFrame.new(-5.2, -1.05, -2.4),
		color = Color3.fromRGB(148, 102, 60),
		material = Enum.Material.WoodPlanks,
	})
	part({
		name = "Crate",
		parent = shopFolder,
		size = Vector3.new(1.6, 1.6, 1.6),
		cf = shopCf * CFrame.new(-5.1, 0.85, -2.5),
		color = Color3.fromRGB(136, 94, 56),
		material = Enum.Material.WoodPlanks,
	})
	part({
		name = "Barrel",
		parent = shopFolder,
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(2.3, 1.7, 1.7),
		cf = shopCf * CFrame.new(5.3, -0.95, -2.2) * CFrame.Angles(0, 0, math.rad(90)),
