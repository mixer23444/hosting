local function pitCFrame(index)
	local angle = (index % 8) / 8 * math.pi * 2
	local pos = Vector3.new(math.cos(angle) * 58, 6, math.sin(angle) * 58)
	return CFrame.lookAt(pos, Vector3.new(0, 6, 0))
end

local function lobbyCFrame(index)
	local angle = (index % 10) / 10 * math.pi * 2
	local pos = Vector3.new(math.cos(angle) * 186, 6, math.sin(angle) * 186)
	return CFrame.lookAt(pos, Vector3.new(0, 4, 0))
end

local function newState()
	return {
		fighter = nil,
		hp = 900,
		maxHp = 900,
		mana = 100,
		maxMana = 100,
		gold = 0,
		kills = 0,
		deaths = 0,
		level = 1,
		xp = 0,
		alive = false,
		pendingSpawn = false,
		baseSpeed = 16,
		cd = { attack = 0, q = 0, e = 0, r = 0, jacket = 0, whistle = 0, energy = 0 },
		items = {},
		stunUntil = 0,
		silenceUntil = 0,
		disarmUntil = 0,
		slowUntil = 0,
		hasteUntil = 0,
		hasteMul = 1,
		energyUntil = 0,
		immuneUntil = 0,
		reflectUntil = 0,
		shield = 0,
		shieldUntil = 0,
		rooted = false,
		rootUntil = 0,
		bashReady = false,
		bashUntil = 0,
		invisibleUntil = 0,
		whistleAt = 0,
		channel = nil,
		castCount = 0,
		castBoost = false,
		lastCast = nil,
		xpTick = 0,
	}
end

local function clearControl(st)
	st.stunUntil = 0
	st.silenceUntil = 0
	st.disarmUntil = 0
	st.slowUntil = 0
	st.hasteUntil = 0
	st.energyUntil = 0
	st.immuneUntil = 0
	st.reflectUntil = 0
	st.shield = 0
	st.shieldUntil = 0
	st.rooted = false
	st.rootUntil = 0
	st.bashReady = false
	st.channel = nil
	st.invisibleUntil = 0
	st.whistleAt = 0
	st.castBoost = false
end

local function rootPart(model)
	return model and model:FindFirstChild("HumanoidRootPart")
end

local function posOfModel(model)
	if not model then
		return nil
	end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	return root and root.Position
end

local function teleport(character, cf)
	local root = rootPart(character)
	if not root then
		return
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = cf
end

local function paint(character, color, title, hp, maxHp)
	local shirt = character:FindFirstChildOfClass("Shirt")
	if shirt then
		shirt:Destroy()
	end
	local pants = character:FindFirstChildOfClass("Pants")
	if pants then
		pants:Destroy()
	end
	local graphic = character:FindFirstChildOfClass("ShirtGraphic")
	if graphic then
		graphic:Destroy()
	end
	local body = character:FindFirstChildOfClass("BodyColors")
	if body then
		body.HeadColor3 = color
		body.TorsoColor3 = color
		body.LeftArmColor3 = color
		body.RightArmColor3 = color
		body.LeftLegColor3 = color
		body.RightLegColor3 = color
	end
	for _, child in character:GetChildren() do
		if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
			child.Color = color
		end
	end
	local old = character:FindFirstChild("FighterTag")
	if old then
		old:Destroy()
	end
	local head = character:FindFirstChild("Head") or rootPart(character)
	if not head then
		return
	end
	local board = Instance.new("BillboardGui")
	board.Name = "FighterTag"
	board.Size = UDim2.fromOffset(140, 36)
	board.StudsOffset = Vector3.new(0, 3.2, 0)
	board.AlwaysOnTop = true
	board.Parent = head
	local name = Instance.new("TextLabel")
	name.Name = "Name"
	name.Size = UDim2.new(1, 0, 0, 18)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBold
	name.TextSize = 14
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.4
	name.Text = title
	name.Parent = board
	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.new(1, -10, 0, 8)
	back.Position = UDim2.fromOffset(5, 22)
	back.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	back.BorderSizePixel = 0
	back.Parent = board
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(math.clamp(hp / math.max(maxHp, 1), 0, 1), 0, 1, 0)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = back
end

local function refreshBar(model, hp, maxHp)
	local fill = model and model:FindFirstChild("Fill", true)
	if fill and fill:IsA("Frame") and fill.Parent and fill.Parent.Name == "Back" then
		fill.Size = UDim2.new(math.clamp(hp / math.max(maxHp, 1), 0, 1), 0, 1, 0)
	end
end

local function burst(position, color, size, life)
	local blob = Instance.new("Part")
	blob.Name = "Burst"
	blob.Shape = Enum.PartType.Ball
	blob.Size = Vector3.new(size, size, size)
	blob.CFrame = CFrame.new(position)
	blob.Anchored = true
	blob.CanCollide = false
	blob.CanQuery = false
	blob.Material = Enum.Material.Neon
	blob.Color = color
	blob.Parent = fxFolder
	Debris:AddItem(blob, life or 0.25)
end

local ANIM_ID = {
	slash = "rbxassetid://522635514",
	lunge = "rbxassetid://522638767",
	point = "rbxassetid://507770453",
	cheer = "rbxassetid://507770677",
	wave = "rbxassetid://507770239",
}

local SOUND_ID = {
	slash = "rbxasset://sounds/swordslash.wav",
	lunge = "rbxasset://sounds/swordlunge.wav",
	magic = "rbxasset://sounds/electronicpingshort.wav",
	snap = "rbxasset://sounds/snap.wav",
	water = "rbxasset://sounds/impact_water.mp3",
	button = "rbxasset://sounds/button.wav",
	switch = "rbxasset://sounds/switch.wav",
	bass = "rbxasset://sounds/bass.wav",
	rocket = "rbxasset://sounds/Rocket shot.wav",
	glass = "rbxasset://sounds/glassbreak.wav",
	splat = "rbxasset://sounds/splat.wav",
}

local liveTrack = setmetatable({}, { __mode = "k" })

local function playAnim(model, kind, speed)
	local id = ANIM_ID[kind]
	local humanoid = model and model:FindFirstChildOfClass("Humanoid")
	if not id or not humanoid or not model:FindFirstChild("UpperTorso") then
		return
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local previous = liveTrack[model]
	if previous then
		pcall(function()
			previous:Stop(0.05)
		end)
	end
	local ok, track = pcall(function()
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local loaded = animator:LoadAnimation(anim)
		anim:Destroy()
		return loaded
	end)
	if not ok or not track then
		return
	end
	liveTrack[model] = track
	track.Priority = Enum.AnimationPriority.Action
	track:Play(0.05, 1, speed or 1)
end

local function sfx(position, name, volume, pitch)
	local id = SOUND_ID[name]
	if not id or typeof(position) ~= "Vector3" then
		return
	end
	local host = Instance.new("Part")
	host.Name = "Sfx"
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.Transparency = 1
	host.Size = Vector3.new(0.2, 0.2, 0.2)
	host.CFrame = CFrame.new(position)
	host.Parent = fxFolder
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.55
	sound.PlaybackSpeed = pitch or 1
	sound.RollOffMaxDistance = 140
	sound.Parent = host
	sound:Play()
	Debris:AddItem(host, 4)
end

local function cue(entry, animKind, soundName, pitch, speed)
	if not entry or not entry.model then
		return
	end
	local pos = posOfModel(entry.model)
	if pos then
		sfx(pos, soundName, 0.6, pitch)
	end
	playAnim(entry.model, animKind, speed)
end

local function beamVisual(a, b, color, life)
	local delta = b - a
	local length = delta.Magnitude
	if length < 0.2 then
		return
	end
	local beam = Instance.new("Part")
	beam.Name = "Beam"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.Material = Enum.Material.Neon
	beam.Color = color
	beam.Size = Vector3.new(0.35, 0.35, length)
	beam.CFrame = CFrame.lookAt(a:Lerp(b, 0.5), b)
	beam.Parent = fxFolder
	Debris:AddItem(beam, life or 0.16)
end

local function floatText(position, text, color)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.4, 0.4, 0.4)
	anchor.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
	anchor.Parent = fxFolder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120, 28)
	gui.AlwaysOnTop = true
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.Text = text
	label.Parent = gui
	Debris:AddItem(anchor, 0.7)
end

local function distToSegment(point, a, b)
	local ab = b - a
	local denom = ab:Dot(ab)
	local t = 0
	if denom > 0.001 then
		t = math.clamp((point - a):Dot(ab) / denom, 0, 1)
	end
	return (point - (a + ab * t)).Magnitude
end

local function fighterOf(st)
	return st and st.fighter and FIGHTERS[st.fighter]
end

local function entryOfPlayer(player)
	local st = playersState[player]
	local character = player.Character
	if not st or not character or not rootPart(character) then
		return nil
	end
	return { kind = "player", player = player, state = st, model = character }
end

local function enemiesOf(source)
	local list = {}
	if source.kind == "player" then
		for _, player in Players:GetPlayers() do
			local st = playersState[player]
			local character = player.Character
			if player ~= source.player and st and st.alive and st.fighter and character and rootPart(character) then
				table.insert(list, { kind = "player", player = player, state = st, model = character })
			end
		end
		for model, st in dummyByModel do
			if st.alive and model.Parent and rootPart(model) then
				table.insert(list, { kind = "dummy", state = st, model = model })
			end
		end
	else
		for _, player in Players:GetPlayers() do
			local st = playersState[player]
			local character = player.Character
			if st and st.alive and st.fighter and character and rootPart(character) then
				table.insert(list, { kind = "player", player = player, state = st, model = character })
			end
		end
	end
	return list
end

local function face(entry, aim)
	local root = rootPart(entry.model)
	if not root or typeof(aim) ~= "Vector3" then
		return
	end
	local flat = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
	if flat.Magnitude < 0.2 then
		return
	end
	root.CFrame = CFrame.new(root.Position, root.Position + flat)
end

local function breakInvis(st)
	st.invisibleUntil = 0
	st.whistleAt = 0
end

local function dmgMul(st)
	local mul = 1 + (st.level - 1) * 0.08
	if st.castBoost then
		mul *= 1.4
	end
	if st.fighter == "dvornik" then
		for _, turret in turrets do
			if turret.owner == st.ownerPlayer then
				mul *= 1.15
				break
			end
		end
	end
	return mul
end

local function takeMul(st)
	local mul = dmgMul(st)
	st.castBoost = false
	return mul
end

local function speedOf(st, now)
	if not st.alive or now < st.stunUntil or (st.rooted and now < st.rootUntil) then
		return 0
	end
	local mul = 1
	if now < st.slowUntil then
		mul *= 0.55
	end
	if now < st.hasteUntil then
		mul *= st.hasteMul
	end
	if now < st.energyUntil then
		mul *= 1.35
	end
	return st.baseSpeed * mul
end

local function statusLine()
	if phase == "lobby" then
		return "Выбери бойца"
	end
	if phase == "countdown" then
		return string.format("Старт через %d", math.max(0, math.ceil(countdownEnd - os.clock())))
	end
	if phase == "ending" then
		return winnerText
	end
	if creature then
		return "Хомяк в центре. Подойди и жми F"
	end
	return "8 минут. Победа — 20 убийств или лидер таблицы"
end

local function timeLeft()
	local now = os.clock()
	if phase == "fight" then
		return math.max(0, matchEnd - now)
	end
	if phase == "countdown" then
		return math.max(0, countdownEnd - now)
	end
	return 0
end

local function grantXp(st, amount)
	st.xp += amount
	while st.level < 6 and st.xp >= LEVEL_XP[st.level + 1] do
		st.level += 1
		st.maxHp += 40
		st.hp = math.min(st.maxHp, st.hp + 40)
		st.maxMana += 10
		st.mana = math.min(st.maxMana, st.mana + 10)
	end
end

local function unlocked(st, key)
	if key == "q" then
		return true
	end
	if key == "e" then
		return st.level >= 2
	end
	if key == "r" then
		return st.level >= 4
	end
	return true
end

local endMatch
local applyDamage
local tapCreature
local spawnDummy

local function kill(source, target)
	local st = target.state
	if not st.alive then
		return
	end
	st.alive = false
	st.hp = 0
	st.channel = nil
	st.rooted = false
	local deathPos = posOfModel(target.model)
	if target.kind == "player" then
		st.deaths += 1
		st.pendingSpawn = phase == "fight"
		local humanoid = target.model:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			humanoid.Health = 0
		end
	else
		local model = target.model
		local respawnIndex = st.slot or 1
		local serial = st.serial
		dummyByModel[model] = nil
		model:Destroy()
		task.delay(8, function()
			if phase == "fight" and serial == roundSerial then
				spawnDummy(respawnIndex, serial)
			end
		end)
	end
	if source and source.kind == "player" and source.state then
		source.state.kills += 1
		source.state.gold += 60
		grantXp(source.state, 120)
		if deathPos then
			floatText(deathPos, "+1", Color3.fromRGB(255, 220, 140))
		end
		if source.state.kills >= WIN_KILLS then
			endMatch()
		end
	end
end

local function immune(st, now, selfCast)
	return now < st.immuneUntil and not selfCast
end

local function cc(target, kind, duration, source)
	local st = target.state
	if not st or not st.alive then
		return false
	end
	local now = os.clock()
	local selfCast = source and source.model == target.model
	if immune(st, now, selfCast) then
		floatText(posOfModel(target.model) or Vector3.zero, "мимо", Color3.fromRGB(200, 200, 210))
		return false
	end
	local untilT = now + duration
	if kind == "stun" then
		st.stunUntil = math.max(st.stunUntil, untilT)
		st.channel = nil
		st.rooted = false
		floatText(posOfModel(target.model) or Vector3.zero, "стан", Color3.fromRGB(255, 230, 120))
	elseif kind == "silence" then
		st.silenceUntil = math.max(st.silenceUntil, untilT)
		floatText(posOfModel(target.model) or Vector3.zero, "тишина", Color3.fromRGB(170, 140, 255))
	elseif kind == "disarm" then
		st.disarmUntil = math.max(st.disarmUntil, untilT)
		floatText(posOfModel(target.model) or Vector3.zero, "выбил", Color3.fromRGB(255, 160, 120))
	elseif kind == "slow" then
		st.slowUntil = math.max(st.slowUntil, untilT)
		floatText(posOfModel(target.model) or Vector3.zero, "вязко", Color3.fromRGB(140, 190, 255))
	end
	return true
end

applyDamage = function(source, target, amount, kind, flags)
	flags = flags or {}
	if phase ~= "fight" or not target or amount <= 0 then
		return
	end
	if target.kind == "creature" then
		if source and source.kind == "player" then
			tapCreature(source.player)
		end
		return
	end
	local st = target.state
	if not st or not st.alive then
		return
	end
	local now = os.clock()
	local spell = kind ~= "physical" or flags.projectile
	if st.reflectUntil > now and not flags.reflected and spell and source and source.model ~= target.model then
		st.reflectUntil = 0
		st.hasteUntil = now + 1.2
		st.hasteMul = 1.3
		local back = posOfModel(target.model)
		if back then
			burst(back, Color3.fromRGB(255, 230, 120), 4, 0.3)
			floatText(back, "опа", Color3.fromRGB(255, 230, 120))
		end
		applyDamage(target, source, amount, kind, { reflected = true, projectile = flags.projectile })
		return
	end
	if now < st.immuneUntil and kind == "magic" then
		return
	end
	if st.shield > 0 and now < st.shieldUntil then
		local absorbed = math.min(st.shield, amount)
		st.shield -= absorbed
		amount -= absorbed
	end
	if st.rooted and now < st.rootUntil then
		amount *= 0.75
	end
	if amount <= 0 then
		return
	end
	st.hp -= amount
	local where = posOfModel(target.model)
	if where then
		burst(where + Vector3.new(0, 1.5, 0), kind == "magic" and Color3.fromRGB(150, 120, 255) or Color3.fromRGB(255, 120, 90), 1.4, 0.15)
	end
	if st.hp <= 0 then
		kill(source, target)
	end
end

tapCreature = function(player)
	local st = playersState[player]
	if not creature or not creature.PrimaryPart or not st or phase ~= "fight" then
		return
	end
	local character = player.Character
	local root = rootPart(character)
	if not root or not st.alive then
		return
	end
	if (root.Position - creature.PrimaryPart.Position).Magnitude > 12 then
		return
	end
	if (creatureCd[player] or 0) > os.clock() then
		return
	end
	creatureCd[player] = os.clock() + 0.45
	st.gold += 80
	burst(creature.PrimaryPart.Position, Color3.fromRGB(255, 190, 80), 3, 0.2)
	floatText(creature.PrimaryPart.Position, "+80", Color3.fromRGB(255, 210, 90))
	sfx(creature.PrimaryPart.Position, "splat", 0.5, 1.25)
	playAnim(character, "cheer", 1)
end

local function nearestEnemy(entry, reach)
	local origin = posOfModel(entry.model)
	if not origin then
		return nil
	end
	local best = nil
	local bestDist = reach
	for _, enemy in enemiesOf(entry) do
		local pos = posOfModel(enemy.model)
		if pos then
			local dist = (pos - origin).Magnitude
			if dist <= bestDist then
				best = enemy
				bestDist = dist
			end
		end
	end
	return best
end

local function coneEnemies(entry, reach, dotMin)
	local root = rootPart(entry.model)
	if not root then
		return {}
	end
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if look.Magnitude < 0.1 then
		return {}
	end
	look = look.Unit
	local hits = {}
	for _, enemy in enemiesOf(entry) do
		local pos = posOfModel(enemy.model)
		if pos then
			local delta = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
			if delta.Magnitude <= reach and delta.Magnitude > 0.1 and delta.Unit:Dot(look) >= dotMin then
				table.insert(hits, enemy)
			end
		end
	end
	return hits
end

local function push(entry, dir, force, selfPush)
	local st = entry.state
	if st and not selfPush and os.clock() < st.immuneUntil then
		return
	end
	local root = rootPart(entry.model)
	if not root then
		return
	end
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 0.1 then
		return
	end
	root.AssemblyLinearVelocity = flat.Unit * force + Vector3.new(0, 16, 0)
end

local function creatureEntry()
	if creature and creature.PrimaryPart then
		return { kind = "creature", model = creature, state = nil }
	end
	return nil
end

local function trySpend(st, key, cost, cd)
	local now = os.clock()
	if not st.alive or now < st.stunUntil or st.channel then
		return false
	end
	if now < st.silenceUntil then
		return false
	end
	if not unlocked(st, key) then
		return false
	end
	if now < (st.cd[key] or 0) then
		return false
	end
	if st.mana < cost then
		return false
	end
	st.mana -= cost
	st.cd[key] = now + cd
	if st.fighter == "dictor" then
		st.castCount += 1
		st.castBoost = st.castCount % 4 == 0
	else
		st.castBoost = false
	end
	if key ~= "r" then
		st.lastCast = key
	end
	breakInvis(st)
	return true
end

local function countOwnTurrets(player)
	local count = 0
	for _, turret in turrets do
		if turret.owner == player then
			count += 1
		end
	end
	return count
end

local castQ
local castE

local function castDictorQ(entry, replayMul)
	local target = nearestEnemy(entry, 34)
	if not target then
		return false
	end
	local mul = takeMul(entry.state) * replayMul
	local pos = posOfModel(target.model)
	if pos then
		burst(pos, Color3.fromRGB(120, 170, 255), 5, 0.3)
	end
	applyDamage(entry, target, 90 * mul, "pure")
	local roll = math.random(4)
	local dur = 1.2 * replayMul
	if roll == 1 then
		cc(target, "stun", 1.1 * replayMul, entry)
	elseif roll == 2 then
		cc(target, "silence", 1.6 * replayMul, entry)
	elseif roll == 3 then
		cc(target, "slow", 2 * replayMul, entry)
	else
		cc(target, "disarm", dur, entry)
	end
	return true
end

local function castTumbaQ(entry, replayMul)
	local st = entry.state
	takeMul(st)
	st.rooted = true
	st.rootUntil = os.clock() + 3.5 * replayMul
	local pos = posOfModel(entry.model)
	if pos then
		burst(pos, Color3.fromRGB(200, 120, 70), 6, 0.35)
	end
	return true
end

local function castReflectQ(entry, replayMul)
	local st = entry.state
	takeMul(st)
	st.reflectUntil = os.clock() + 0.6 * replayMul
	local pos = posOfModel(entry.model)
	if pos then
		burst(pos, Color3.fromRGB(255, 220, 100), 5, 0.25)
		floatText(pos, "опа", Color3.fromRGB(255, 220, 100))
	end
	return true
end

local function castDvornikQ(entry, aim, replayMul)
	local st = entry.state
	local root = rootPart(entry.model)
	if not root then
		return false
	end
	local mul = takeMul(st)
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if typeof(aim) == "Vector3" then
		local aimed = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
		if aimed.Magnitude > 0.2 then
			flat = aimed
		end
	end
	if flat.Magnitude < 0.1 then
		return false
	end
	local dist = math.clamp(flat.Magnitude, 6, 22)
	local planted = root.Position + flat.Unit * dist
	planted = Vector3.new(math.clamp(planted.X, -60, 60), 2.2, math.clamp(planted.Z, -60, 60))
	while countOwnTurrets(entry.player) >= 2 do
		for index, turret in turrets do
			if turret.owner == entry.player then
				turret.model:Destroy()
				table.remove(turrets, index)
				break
			end
		end
	end
	local model = Instance.new("Model")
	model.Name = "Tumba"
	local pot = part({
		name = "Pot",
		size = Vector3.new(2.4, 2.2, 2.4),
		cf = CFrame.new(planted),
		color = Color3.fromRGB(120, 86, 60),
		material = Enum.Material.Wood,
		parent = model,
	})
	part({
		name = "Sprout",
		size = Vector3.new(0.5, 2.4, 0.5),
		cf = CFrame.new(planted + Vector3.new(0, 2, 0)),
		color = Color3.fromRGB(90, 180, 100),
		material = Enum.Material.Grass,
		collide = false,
		parent = model,
	})
	model.PrimaryPart = pot
	model.Parent = workspace
	table.insert(turrets, {
		owner = entry.player,
		model = model,
		untilT = os.clock() + 8 * replayMul,
		nextTick = os.clock() + 0.3,
		mul = mul * replayMul,
	})
	return true
end

castQ = function(entry, aim, replay)
	local st = entry.state
	local spec = ABILITIES[st.fighter].q
	local replayMul = replay and 0.5 or 1
	if not replay and not trySpend(st, "q", spec[1], spec[2]) then
		return
	end
	face(entry, aim)
	local ok = true
	if st.fighter == "dictor" then
		ok = castDictorQ(entry, replayMul)
	elseif st.fighter == "tumba" then
		ok = castTumbaQ(entry, replayMul)
	elseif st.fighter == "otrazhatel" then
		ok = castReflectQ(entry, replayMul)
	elseif st.fighter == "dvornik" then
		ok = castDvornikQ(entry, aim, replayMul)
	end
	if not ok and not replay then
		st.mana += spec[1]
		st.cd.q = 0
		st.castCount = math.max(0, st.castCount - 1)
		st.castBoost = false
	elseif ok then
		if st.fighter == "dictor" then
			cue(entry, "point", "magic", 1.15, 1)
		elseif st.fighter == "tumba" then
			cue(entry, "cheer", "bass", 0.8, 0.9)
		elseif st.fighter == "otrazhatel" then
			cue(entry, "wave", "glass", 1.1, 1)
		elseif st.fighter == "dvornik" then
			cue(entry, "slash", "snap", 1, 1.1)
		end
	end
end

local function castDictorE(entry, replayMul)
	local st = entry.state
	takeMul(st)
	local now = os.clock()
	st.shield = 180 * replayMul
	st.shieldUntil = now + 3 * replayMul
	st.hasteUntil = now + 3 * replayMul
	st.hasteMul = 1.25
	cc(entry, "disarm", 3 * replayMul, entry)
	local pos = posOfModel(entry.model)
	if pos then
		burst(pos, Color3.fromRGB(140, 180, 255), 5, 0.3)
	end
end

local function castTumbaE(entry, aim, replayMul)
	local st = entry.state
	local mul = takeMul(st) * replayMul
	face(entry, aim)
	local root = rootPart(entry.model)
	if not root then
		return
	end
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if look.Magnitude < 0.1 then
		return
	end
	local hits = coneEnemies(entry, 9, 0.15)
	push(entry, -look, 62, true)
	for _, enemy in hits do
		applyDamage(entry, enemy, 70 * mul, "physical")
		local pos = posOfModel(enemy.model)
		if pos then
			push(enemy, pos - root.Position, 48)
		end
	end
	burst(root.Position, Color3.fromRGB(210, 130, 80), 4, 0.2)
end

local function castReflectE(entry, aim, replayMul)
	local mul = takeMul(entry.state) * replayMul
	face(entry, aim)
	local root = rootPart(entry.model)
	if not root then
		return
	end
	for _, enemy in coneEnemies(entry, 10, 0.35) do
		applyDamage(entry, enemy, 85 * mul, "physical")
		local pos = posOfModel(enemy.model)
		if pos then
			push(enemy, pos - root.Position, 46)
		end
	end
	burst(root.Position + root.CFrame.LookVector * 4, Color3.fromRGB(240, 210, 100), 3.5, 0.2)
end

local function castDvornikE(entry, replayMul)
	local st = entry.state
	takeMul(st)
	local heal = 50 * replayMul
	st.hp = math.min(st.maxHp, st.hp + heal)
	local origin = posOfModel(entry.model)
	if not origin then
		return
	end
	burst(origin, Color3.fromRGB(120, 220, 140), 6, 0.3)
	for _, turret in turrets do
		if turret.owner == entry.player and turret.model.PrimaryPart then
			local pos = turret.model.PrimaryPart.Position
			if (pos - origin).Magnitude <= 16 then
				turret.untilT += 2 * replayMul
				burst(pos, Color3.fromRGB(140, 230, 150), 2.5, 0.25)
			end
		end
	end
end

castE = function(entry, aim, replay)
	local st = entry.state
	local spec = ABILITIES[st.fighter].e
	local replayMul = replay and 0.5 or 1
	if not replay and not trySpend(st, "e", spec[1], spec[2]) then
		return
	end
	if st.fighter == "dictor" then
		castDictorE(entry, replayMul)
	elseif st.fighter == "tumba" then
		castTumbaE(entry, aim, replayMul)
	elseif st.fighter == "otrazhatel" then
		castReflectE(entry, aim, replayMul)
	elseif st.fighter == "dvornik" then
		castDvornikE(entry, replayMul)
	end
	if st.fighter == "dictor" then
		cue(entry, "wave", "magic", 0.9, 1)
	elseif st.fighter == "tumba" then
		cue(entry, "lunge", "lunge", 1, 1.15)
	elseif st.fighter == "otrazhatel" then
		cue(entry, "lunge", "lunge", 1.05, 1.1)
	elseif st.fighter == "dvornik" then
		cue(entry, "wave", "water", 1, 1)
	end
end

local function castR(entry, aim)
	local st = entry.state
	local spec = ABILITIES[st.fighter].r
	if not trySpend(st, "r", spec[1], spec[2]) then
		return
	end
	face(entry, aim)
	local root = rootPart(entry.model)
	if not root then
		return
	end
	if st.fighter == "dictor" then
		cue(entry, "point", "rocket", 0.85, 0.9)
	elseif st.fighter == "dvornik" then
		cue(entry, "point", "water", 0.95, 1)
	elseif st.fighter == "tumba" then
		cue(entry, "cheer", "bass", 0.7, 1)
	else
		cue(entry, "wave", "snap", 1.25, 1.1)
	end
	if st.fighter == "dictor" or st.fighter == "dvornik" then
		local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
		if flat.Magnitude < 0.1 then
			flat = Vector3.new(0, 0, -1)
		end
		st.channel = {
			kind = st.fighter == "dictor" and "beam" or "hose",
			untilT = os.clock() + (st.fighter == "dictor" and 2.2 or 1.6),
			nextTick = os.clock(),
			dir = flat.Unit,
			mul = takeMul(st),
		}
		return
	end
	if st.fighter == "tumba" then
		local mul = takeMul(st)
		st.bashReady = true
		st.bashBonus = 80 * mul
		st.bashUntil = os.clock() + 6
		floatText(root.Position, "баш", Color3.fromRGB(255, 180, 100))
		burst(root.Position, Color3.fromRGB(255, 150, 80), 4, 0.25)
		return
	end
	if st.lastCast == "q" then
		castQ(entry, aim, true)
	elseif st.lastCast == "e" then
		castE(entry, aim, true)
	else
		local mul = takeMul(st)
		for _, enemy in enemiesOf(entry) do
			local pos = posOfModel(enemy.model)
			if pos and (pos - root.Position).Magnitude <= 8 then
				applyDamage(entry, enemy, 50 * mul, "physical")
			end
		end
		burst(root.Position, Color3.fromRGB(240, 220, 120), 6, 0.25)
	end
end

local function launchProjectile(entry, aim, damage)
	local root = rootPart(entry.model)
	if not root then
		return
	end
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if typeof(aim) == "Vector3" then
		local aimed = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
		if aimed.Magnitude > 0.2 then
			flat = aimed
		end
	end
	if flat.Magnitude < 0.1 then
		return
	end
	local dir = flat.Unit
	local visual = Instance.new("Part")
	visual.Size = Vector3.new(0.45, 0.45, 1.3)
	visual.Anchored = true
	visual.CanCollide = false
	visual.CanQuery = false
	visual.Material = Enum.Material.Neon
	visual.Color = fighterOf(entry.state).color
	visual.Parent = fxFolder
	table.insert(projectiles, {
		pos = root.Position + Vector3.new(0, 1.3, 0) + dir * 3,
		dir = dir,
		speed = 96,
		left = 78,
		damage = damage,
		owner = entry,
		part = visual,
	})
end

local function attack(entry, aim)
	local st = entry.state
	local now = os.clock()
	if not st.alive or now < st.stunUntil or now < st.disarmUntil or st.channel then
		return
	end
	local info = fighterOf(st)
	if not info then
		return
	end
	local cd = info.cd
	local manaCost = 0
	if st.items.baton and st.mana >= 8 then
		cd *= 0.7
		manaCost = 8
	end
	if now < st.cd.attack then
		return
	end
	st.cd.attack = now + cd
	st.mana -= manaCost
	breakInvis(st)
	face(entry, aim)
	if info.ranged then
		cue(entry, "point", "rocket", 1.25, 1.4)
	else
		cue(entry, "slash", "slash", 1, 1.55)
	end
	local levelMul = 1 + (st.level - 1) * 0.08
	if st.fighter == "dvornik" and countOwnTurrets(entry.player) > 0 then
		levelMul *= 1.15
	end
	if info.ranged then
		launchProjectile(entry, aim, info.basic * levelMul)
		return
	end
	local hits = coneEnemies(entry, info.reach, 0.2)
	if #hits == 0 then
		local pet = creatureEntry()
		local root = rootPart(entry.model)
		if pet and root and (pet.model.PrimaryPart.Position - root.Position).Magnitude <= info.reach + 3 then
			tapCreature(entry.player)
		end
		return
	end
	local bonus = 0
	if st.bashReady and now <= st.bashUntil then
		st.bashReady = false
		bonus = st.bashBonus or 80
		cc(hits[1], "stun", 1.1, entry)
	elseif st.bashReady then
		st.bashReady = false
	end
	local dealt = (info.basic + bonus) * levelMul
	if st.rooted and now < st.rootUntil then
		dealt *= 1.5
	end
	applyDamage(entry, hits[1], dealt, "physical")
	if st.rooted and now < st.rootUntil then
		local center = posOfModel(hits[1].model)
		if center then
			for index = 2, #hits do
				local otherPos = posOfModel(hits[index].model)
				if otherPos and (otherPos - center).Magnitude <= 7 then
					applyDamage(entry, hits[index], dealt * 0.5, "physical")
				end
			end
		end
	end
end

local function useJacket(st)
	local now = os.clock()
	if not st.alive or not st.items.jacket or now < st.cd.jacket or now < st.stunUntil then
		return
	end
	st.cd.jacket = now + 28
	st.immuneUntil = now + 1.5
	breakInvis(st)
	local player = st.ownerPlayer
	local entry = player and entryOfPlayer(player)
	local pos = entry and posOfModel(entry.model)
	if pos then
		burst(pos, Color3.fromRGB(230, 230, 240), 5, 0.25)
		floatText(pos, "куртка", Color3.fromRGB(230, 230, 240))
	end
	if entry then
		cue(entry, "wave", "glass", 0.95, 1)
	end
end

local function useWhistle(st)
	local now = os.clock()
	if not st.alive or not st.items.whistle or now < st.cd.whistle or now < st.stunUntil or st.channel then
		return
	end
	st.cd.whistle = now + 18
	st.whistleAt = now + 0.4
	local player = st.ownerPlayer
	local entry = player and entryOfPlayer(player)
	if entry then
		cue(entry, "point", "switch", 1.35, 1.2)
	end
end

local function useEnergy(st)
	local now = os.clock()
	if not st.alive or not st.items.energy or now < st.cd.energy or now < st.stunUntil then
		return
	end
	st.cd.energy = now + 16
	st.mana = math.min(st.maxMana, st.mana + 80)
	st.energyUntil = now + 3
	breakInvis(st)
	local player = st.ownerPlayer
	local entry = player and entryOfPlayer(player)
	if entry then
		cue(entry, "cheer", "magic", 1.2, 1)
	end
end

local function buy(player, itemId)
	local st = playersState[player]
	local spec = ITEMS[itemId]
	if not st or not spec or st.items[itemId] or st.gold < spec.price then
		return
	end
	local character = player.Character
	local root = rootPart(character)
	if not root or (root.Position - shopPos).Magnitude > 16 then
		return
	end
	st.gold -= spec.price
	st.items[itemId] = true
	floatText(root.Position, spec.name, Color3.fromRGB(240, 210, 140))
	sfx(root.Position, "button", 0.55, 1)
	playAnim(character, "cheer", 1)
end

local function validAim(aim, origin)
	if typeof(aim) ~= "Vector3" then
		return origin + Vector3.new(0, 0, -8)
	end
	if aim.X ~= aim.X or math.abs(aim.X) > 2000 then
		return origin + Vector3.new(0, 0, -8)
	end
	if (aim - origin).Magnitude > 120 then
		return origin + (aim - origin).Unit * 120
	end
	return aim
end

local function onAction(player, action, aim)
	if typeof(action) ~= "string" or phase ~= "fight" then
		return
	end
	local st = playersState[player]
	if not st or not st.fighter then
		return
	end
	local entry = entryOfPlayer(player)
	if not entry or not st.alive then
		return
	end
	st.ownerPlayer = player
	local origin = posOfModel(entry.model) or Vector3.zero
	aim = validAim(aim, origin)
	if action == "attack" then
		attack(entry, aim)
	elseif action == "q" then
		castQ(entry, aim, false)
	elseif action == "e" then
		castE(entry, aim, false)
	elseif action == "r" then
		castR(entry, aim)
	elseif action == "jacket" then
		useJacket(st)
	elseif action == "whistle" then
		useWhistle(st)
	elseif action == "energy" then
		useEnergy(st)
	elseif action == "tap" then
		tapCreature(player)
	elseif string.sub(action, 1, 4) == "buy_" then
		buy(player, string.sub(action, 5))
	end
end

local function clearOwned(list, player)
	for index = #list, 1, -1 do
		if list[index].owner == player or (list[index].owner and list[index].owner.player == player) then
			if list[index].model then
				list[index].model:Destroy()
			end
			table.remove(list, index)
		end
	end
end

local function wipeCombat()
	for model in dummyByModel do
		model:Destroy()
	end
	dummyByModel = {}
	for _, turret in turrets do
		if turret.model then
			turret.model:Destroy()
		end
	end
	turrets = {}
	projectiles = {}
	if creature then
		creature:Destroy()
		creature = nil
	end
	creatureCd = {}
	fxFolder:ClearAllChildren()
end

local function winnerLine()
	local best = -1
	local names = {}
	for _, player in Players:GetPlayers() do
		local st = playersState[player]
		if st and st.fighter then
			if st.kills > best then
				best = st.kills
				names = { player.DisplayName .. " (" .. FIGHTERS[st.fighter].name .. ")" }
			elseif st.kills == best then
				table.insert(names, player.DisplayName .. " (" .. FIGHTERS[st.fighter].name .. ")")
			end
		end
	end
	if best < 0 then
		return "Раунд окончен"
	end
	if best == 0 then
		return "Ничья. Ни одного убийства"
	end
	return "Победил " .. table.concat(names, ", ") .. " — " .. tostring(best)
end

endMatch = function()
	if phase ~= "fight" then
		return
	end
	phase = "ending"
	winnerText = winnerLine()
	wipeCombat()
	for _, player in Players:GetPlayers() do
		local st = playersState[player]
		if st then
			st.alive = false
			st.channel = nil
			st.pendingSpawn = false
			if player.Character then
				teleport(player.Character, lobbyCFrame(player.UserId))
			end
		end
	end
	local serial = roundSerial
	task.delay(8, function()
		if phase ~= "ending" or roundSerial ~= serial then
			return
		end
		roundSerial += 1
		phase = "lobby"
		winnerText = ""
		wipeCombat()
		for _, player in Players:GetPlayers() do
			playersState[player] = newState()
			player:LoadCharacter()
		end
	end)
end

local function startFight()
	phase = "fight"
	local now = os.clock()
	matchEnd = now + MATCH_LEN
	creatureTime = now + CREATURE_AT
	roundSerial += 1
	local serial = roundSerial
	for slot = 1, 3 do
		spawnDummy(slot, serial)
	end
	for _, player in Players:GetPlayers() do
		local st = playersState[player]
		if st and st.fighter then
			clearControl(st)
			st.alive = true
			st.hp = st.maxHp
			st.mana = st.maxMana
			st.pendingSpawn = false
			st.ownerPlayer = player
			if player.Character and rootPart(player.Character) then
				teleport(player.Character, pitCFrame(player.UserId))
				local info = FIGHTERS[st.fighter]
				paint(player.Character, info.color, info.name, st.hp, st.maxHp)
			else
				st.pendingSpawn = true
				player:LoadCharacter()
			end
		end
	end
end

spawnDummy = function(slot, serial)
	if phase ~= "fight" or serial ~= roundSerial then
		return
	end
	local model = Instance.new("Model")
	model.Name = "Болван"
	local root = Instance.new("Part")
	root.Name = "HumanoidRootPart"
	root.Size = Vector3.new(2, 2, 1)
	root.Color = Color3.fromRGB(120, 110, 110)
	root.Material = Enum.Material.SmoothPlastic
	root.TopSurface = Enum.SurfaceType.Smooth
	root.BottomSurface = Enum.SurfaceType.Smooth
	root.Parent = model
	local torso = Instance.new("Part")
	torso.Name = "Torso"
	torso.Size = Vector3.new(2, 2, 1)
	torso.Color = Color3.fromRGB(150, 90, 90)
	torso.Material = Enum.Material.SmoothPlastic
	torso.CFrame = CFrame.new(0, 0, 0)
	torso.Parent = model
	local weld = Instance.new("WeldConstraint")
	weld.Part0 = root
	weld.Part1 = torso
	weld.Parent = root
	local head = Instance.new("Part")
	head.Name = "Head"
	head.Size = Vector3.new(1.2, 1.2, 1.2)
	head.Color = Color3.fromRGB(190, 160, 140)
	head.CFrame = CFrame.new(0, 2, 0)
	head.Parent = model
	local weldHead = Instance.new("WeldConstraint")
	weldHead.Part0 = root
	weldHead.Part1 = head
	weldHead.Parent = root
	local humanoid = Instance.new("Humanoid")
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.MaxHealth = 420
	humanoid.Health = 420
	humanoid.HipHeight = 2
	humanoid.Parent = model
	model.PrimaryPart = root
	model.Parent = workspace
	local cf = pitCFrame(slot * 2 + 1)
	model:PivotTo(cf)
	local st = newState()
	st.fighter = "dummy"
	st.alive = true
	st.hp = 420
	st.maxHp = 420
	st.baseSpeed = 13
	st.level = 1
	st.slot = slot
	st.serial = serial
	st.ownerPlayer = nil
	dummyByModel[model] = st
	paint(model, Color3.fromRGB(150, 90, 90), "Болван", st.hp, st.maxHp)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
end

local function spawnCreature()
	if creature then
		return
	end
	local model = Instance.new("Model")
	model.Name = "Хомяк"
	model:SetAttribute("Creature", true)
	local body = part({
		name = "Body",
		shape = Enum.PartType.Ball,
		size = Vector3.new(4.2, 3.4, 4.2),
		cf = CFrame.new(0, 3.2, 0),
		color = Color3.fromRGB(186, 132, 72),
		material = Enum.Material.SmoothPlastic,
		collide = false,
		parent = model,
	})
	local function ear(name, offset)
		local piece = part({
			name = name,
			shape = Enum.PartType.Ball,
			size = Vector3.new(1.1, 1.1, 1.1),
			cf = body.CFrame * CFrame.new(offset),
			color = Color3.fromRGB(214, 160, 130),
			material = Enum.Material.SmoothPlastic,
			anchored = false,
			collide = false,
			query = false,
			parent = model,
		})
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = body
		weld.Part1 = piece
		weld.Parent = body
	end
	ear("EarL", Vector3.new(-1.1, 1.6, -0.4))
	ear("EarR", Vector3.new(1.1, 1.6, -0.4))
	model.PrimaryPart = body
	model.Parent = workspace
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Тапнуть"
	prompt.ObjectText = "Хомяк"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	prompt.Triggered:Connect(function(player)
		tapCreature(player)
	end)
	creature = model
end

local function tickChannel(player, st)
	local now = os.clock()
	local channel = st.channel
	if not channel then
		return
	end
	if now < channel.nextTick then
		return
	end
	if now >= channel.untilT or now < st.stunUntil then
		st.channel = nil
		return
	end
	channel.nextTick = now + 0.18
	local entry = entryOfPlayer(player)
	local root = entry and rootPart(entry.model)
	if not entry or not root then
		st.channel = nil
		return
	end
	local origin = root.Position + Vector3.new(0, 1.4, 0)
	local dest
	if channel.kind == "beam" then
		local near = nearestEnemy(entry, 36)
		local aimPos = near and posOfModel(near.model) or (origin + channel.dir * 36)
		local flat = Vector3.new(aimPos.X - origin.X, 0, aimPos.Z - origin.Z)
		if flat.Magnitude > 0.2 then
			channel.dir = flat.Unit
		end
		dest = origin + channel.dir * math.min(math.max(flat.Magnitude, 1), 36)
		beamVisual(origin, dest, Color3.fromRGB(120, 180, 255), 0.16)
	else
		dest = origin + channel.dir * 34
		beamVisual(origin, dest, Color3.fromRGB(120, 220, 160), 0.16)
	end
	face(entry, dest)
	for _, enemy in enemiesOf(entry) do
		local pos = posOfModel(enemy.model)
		if pos and distToSegment(pos, origin, dest) <= 3.3 then
			applyDamage(entry, enemy, (channel.kind == "beam" and 18 or 15) * channel.mul, "magic")
			if channel.kind == "hose" then
				push(enemy, channel.dir, 28)
			end
		end
	end
	local pet = creatureEntry()
	if pet and distToSegment(pet.model.PrimaryPart.Position, origin, dest) <= 4 then
		tapCreature(player)
	end
end

local function tickTurrets(now)
	for index = #turrets, 1, -1 do
		if phase ~= "fight" then
			break
		end
		local turret = turrets[index]
		if not turret then
			break
		end
		local owner = turret.owner
		if now >= turret.untilT or not owner.Parent or not turret.model.Parent then
			if turret.model then
				turret.model:Destroy()
			end
			table.remove(turrets, index)
		elseif now >= turret.nextTick and playersState[owner] then
			turret.nextTick = now + 0.8
			local entry = entryOfPlayer(owner)
			local originPart = turret.model.PrimaryPart
			if entry and originPart then
				local fake = {
					kind = "player",
					player = owner,
					state = playersState[owner],
					model = turret.model,
				}
				local target = nearestEnemy(fake, 28)
				if target and playersState[owner].alive then
					local hitPos = posOfModel(target.model)
					if hitPos then
						beamVisual(originPart.Position + Vector3.new(0, 1.5, 0), hitPos + Vector3.new(0, 1.2, 0), Color3.fromRGB(140, 230, 150), 0.12)
						applyDamage(entry, target, 16 * turret.mul, "magic")
					end
				end
			end
		end
	end
end

local function tickProjectiles(dt)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	for index = #projectiles, 1, -1 do
		if phase ~= "fight" then
			break
		end
		local shot = projectiles[index]
		if not shot then
			break
		end
		local step = shot.speed * dt
		local ownerModel = shot.owner and shot.owner.model
		params.FilterDescendantsInstances = { ownerModel, fxFolder }
		local hit = workspace:Raycast(shot.pos, shot.dir * step, params)
		local reach = step
		if hit then
			reach = hit.Distance
		end
		shot.pos += shot.dir * reach
		shot.left -= reach
		if shot.part then
			shot.part.CFrame = CFrame.lookAt(shot.pos, shot.pos + shot.dir)
		end
		local consumed = false
		if hit then
			local model = hit.Instance:FindFirstAncestorOfClass("Model")
			if model and model:GetAttribute("Creature") then
				if shot.owner and shot.owner.player then
					tapCreature(shot.owner.player)
				end
				consumed = true
			else
				local player = model and Players:GetPlayerFromCharacter(model)
				local st = player and playersState[player]
				if st and st.alive then
					applyDamage(shot.owner, { kind = "player", player = player, state = st, model = model }, shot.damage, "physical", { projectile = true })
					consumed = true
				end
				local dummyState = model and dummyByModel[model]
				if dummyState and dummyState.alive then
					applyDamage(shot.owner, { kind = "dummy", state = dummyState, model = model }, shot.damage, "physical", { projectile = true })
					consumed = true
				end
				if not consumed then
					consumed = true
				end
			end
		end
		if consumed or shot.left <= 0 or (shot.owner.player and not shot.owner.player.Parent) then
			if shot.part then
				shot.part:Destroy()
			end
			table.remove(projectiles, index)
		end
	end
end

local function tickDummies(now)
	for model, st in dummyByModel do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local root = rootPart(model)
		if not humanoid or not root or not st.alive then
			continue
		end
		refreshBar(model, st.hp, st.maxHp)
		local locked = now < st.stunUntil
		humanoid.WalkSpeed = locked and 0 or speedOf(st, now)
		humanoid.JumpPower = 0
		if locked then
			continue
		end
		local nearest = nil
		local nearestDist = 500
		for _, player in Players:GetPlayers() do
			local pst = playersState[player]
			local proot = player.Character and rootPart(player.Character)
			if pst and pst.alive and proot then
				local dist = (proot.Position - root.Position).Magnitude
				if dist < nearestDist then
					nearest = player
					nearestDist = dist
				end
			end
		end
		if nearest and nearest.Character then
			humanoid:MoveTo(rootPart(nearest.Character).Position)
			if nearestDist <= 7 and now >= st.cd.attack then
				st.cd.attack = now + 1.15
				local target = entryOfPlayer(nearest)
				if target then
					applyDamage({ kind = "dummy", state = st, model = model }, target, 18, "physical")
				end
				if phase ~= "fight" then
					break
				end
			end
		end
	end
end

local function applyBody(player, st)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or not st.alive then
		if character and character:GetAttribute("YamaInvis") then
			character:SetAttribute("YamaInvis", nil)
		end
		local root = rootPart(character)
		local inPit = root and Vector3.new(root.Position.X, 0, root.Position.Z).Magnitude < 165
		local spectator = phase == "fight" and st and not st.alive and not st.pendingSpawn and humanoid and humanoid.Health > 0
		if inPit and (phase ~= "fight" or spectator) then
			teleport(character, lobbyCFrame(player.UserId))
		end
		return
	end
	local now = os.clock()
	if st.shield > 0 and now >= st.shieldUntil then
		st.shield = 0
	end
	if st.rooted and now >= st.rootUntil then
		st.rooted = false
	end
	if st.whistleAt > 0 and now >= st.whistleAt then
		st.whistleAt = 0
		st.invisibleUntil = now + 3
	end
	local hidden = now < st.invisibleUntil
	if character:GetAttribute("YamaInvis") ~= (hidden or nil) then
		character:SetAttribute("YamaInvis", hidden or nil)
	end
	if now >= st.reflectUntil then
		local old = character:FindFirstChild("ReflectLight")
		if old then
			old:Destroy()
		end
	elseif not character:FindFirstChild("ReflectLight") then
		local light = Instance.new("Highlight")
		light.Name = "ReflectLight"
		light.FillColor = Color3.fromRGB(255, 220, 90)
		light.FillTransparency = 0.55
		light.Parent = character
	end
	if now >= st.immuneUntil then
		local old = character:FindFirstChild("JacketLight")
		if old then
			old:Destroy()
		end
	elseif not character:FindFirstChild("JacketLight") then
		local light = Instance.new("Highlight")
		light.Name = "JacketLight"
		light.FillColor = Color3.fromRGB(220, 230, 255)
		light.FillTransparency = 0.6
		light.Parent = character
	end
	humanoid.MaxHealth = math.max(st.maxHp, 1)
	humanoid.Health = math.max(st.hp, 1)
	humanoid.WalkSpeed = speedOf(st, now)
	humanoid.UseJumpPower = true
	humanoid.JumpPower = speedOf(st, now) <= 0 and 0 or 50
	humanoid.AutoRotate = not st.channel
	refreshBar(character, st.hp, st.maxHp)
end

local function snapshot(player)
	local st = playersState[player]
	local now = os.clock()
	local function remain(t)
		return math.max(0, (t or 0) - now)
	end
	local you = nil
	if st then
		local root = player.Character and rootPart(player.Character)
		you = {
			fighter = st.fighter,
			hp = math.floor(st.hp),
			maxHp = st.maxHp,
			mana = math.floor(st.mana),
			maxMana = st.maxMana,
			gold = st.gold,
			kills = st.kills,
			deaths = st.deaths,
			level = st.level,
			xp = st.xp,
			nextXp = LEVEL_XP[st.level + 1] or st.xp,
			cd = {
				q = remain(st.cd.q),
				e = remain(st.cd.e),
				r = remain(st.cd.r),
				jacket = remain(st.cd.jacket),
				whistle = remain(st.cd.whistle),
				energy = remain(st.cd.energy),
			},
			lockE = st.level < 2,
			lockR = st.level < 4,
			items = {
				baton = st.items.baton == true,
				jacket = st.items.jacket == true,
				whistle = st.items.whistle == true,
				energy = st.items.energy == true,
			},
			shield = math.floor(st.shield),
			rooted = st.rooted,
			nearShop = root ~= nil and (root.Position - shopPos).Magnitude <= 16,
		}
	end
	local board = {}
	for _, other in Players:GetPlayers() do
		local ost = playersState[other]
		if ost and ost.fighter and FIGHTERS[ost.fighter] then
			table.insert(board, {
				name = other.DisplayName,
				kills = ost.kills,
				fighter = FIGHTERS[ost.fighter].name,
			})
		end
	end
	table.sort(board, function(a, b)
		if a.kills == b.kills then
			return a.name < b.name
		end
		return a.kills > b.kills
	end)
	return {
		phase = phase,
		timeLeft = timeLeft(),
		status = statusLine(),
		you = you,
		board = board,
	}
end

local function pushAll()
	for _, player in Players:GetPlayers() do
		stateRemote:FireClient(player, snapshot(player))
	end
end

local function setupCharacter(player, character)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not root or not humanoid or not character.Parent then
		return
	end
	local st = playersState[player]
	if not st then
		st = newState()
		playersState[player] = st
	end
	st.ownerPlayer = player
	humanoid.BreakJointsOnDeath = true
	if phase == "fight" and st.fighter and (st.pendingSpawn or st.alive) then
		st.pendingSpawn = false
		st.alive = true
		if st.hp <= 0 then
			st.hp = st.maxHp
		end
		clearControl(st)
		st.hp = st.maxHp
		st.mana = st.maxMana
		teleport(character, pitCFrame(player.UserId))
	else
		st.alive = false
		teleport(character, lobbyCFrame(player.UserId))
	end
	if st.fighter and FIGHTERS[st.fighter] then
		local info = FIGHTERS[st.fighter]
		st.baseSpeed = info.speed
		if st.hp > st.maxHp then
			st.hp = st.maxHp
		end
		paint(character, info.color, info.name, st.hp, st.maxHp)
	end
	humanoid.Died:Connect(function()
		if playersState[player] ~= st then
			return
		end
		if st.alive then
			st.deaths += 1
		end
		st.alive = false
		st.channel = nil
		if phase == "fight" and st.fighter then
			st.pendingSpawn = true
		end
	end)
end

local function hookPlayer(player)
	playersState[player] = newState()
	player.CharacterAdded:Connect(function(character)
		task.defer(function()
			setupCharacter(player, character)
		end)
	end)
	if player.Character then
		task.defer(function()
			setupCharacter(player, player.Character)
		end)
	end
end

pickRemote.OnServerEvent:Connect(function(player, fighterId)
	if typeof(fighterId) ~= "string" or not FIGHTERS[fighterId] or phase == "ending" then
		return
	end
	local st = playersState[player]
	if not st then
		return
	end
	if st.fighter and phase == "fight" then
		return
	end
	local info = FIGHTERS[fighterId]
	st.fighter = fighterId
	st.ownerPlayer = player
	st.maxHp = info.hp
	st.hp = info.hp
	st.maxMana = 100
	st.mana = 100
	st.baseSpeed = info.speed
	st.level = 1
	st.xp = 0
	if player.Character then
		paint(player.Character, info.color, info.name, st.hp, st.maxHp)
	end
	if phase == "lobby" then
		phase = "countdown"
		countdownEnd = os.clock() + COUNTDOWN
	elseif phase == "fight" then
		clearControl(st)
		st.alive = true
		if player.Character and rootPart(player.Character) then
			teleport(player.Character, pitCFrame(player.UserId))
		else
			st.pendingSpawn = true
			player:LoadCharacter()
		end
	end
	stateRemote:FireClient(player, snapshot(player))
end)

actionRemote.OnServerEvent:Connect(function(player, action, aim)
	onAction(player, action, aim)
end)

Players.PlayerAdded:Connect(hookPlayer)
for _, player in Players:GetPlayers() do
	hookPlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
	playersState[player] = nil
	creatureCd[player] = nil
	clearOwned(turrets, player)
	for index = #projectiles, 1, -1 do
		local shot = projectiles[index]
		if shot.owner and shot.owner.player == player then
			if shot.part then
				shot.part:Destroy()
			end
			table.remove(projectiles, index)
		end
	end
end)

buildWorld()

RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	dt = math.min(dt, 0.1)
	if phase == "countdown" and now >= countdownEnd then
		startFight()
	end
	if phase == "fight" then
		if now >= matchEnd then
			endMatch()
		elseif not creature and now >= creatureTime then
			spawnCreature()
		end
		for _, player in Players:GetPlayers() do
			local st = playersState[player]
			if st and st.alive and st.fighter then
				st.hp = math.min(st.maxHp, st.hp + 3 * dt)
				st.mana = math.min(st.maxMana, st.mana + 8 * dt)
				st.xpTick += dt
				if st.xpTick >= 1 then
					st.xpTick -= 1
					grantXp(st, 8)
				end
				if st.channel then
					tickChannel(player, st)
				end
			end
			if st then
				applyBody(player, st)
			end
		end
		if creature and creature.PrimaryPart then
			local bob = 3.1 + math.sin(now * 3) * 0.35
			creature.PrimaryPart.CFrame = CFrame.new(0, bob, 0)
		end
		tickTurrets(now)
		tickProjectiles(dt)
		tickDummies(now)
	else
		for _, player in Players:GetPlayers() do
			local st = playersState[player]
			if st then
				applyBody(player, st)
			end
		end
	end
	pushStamp += dt
	if pushStamp >= 0.15 then
		pushStamp = 0
		pushAll()
	end
end)
]]></ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="4">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="5">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
    <Item class="LocalScript" referent="6">
      <Properties>
        <string name="Name">YamaClient</string>
        <ProtectedString name="Source"><![CDATA[-- Парк. LocalScript в StarterPlayerScripts. Шифтлок, камера и интерфейс.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local pickRemote = ReplicatedStorage:WaitForChild("YamaPick")
local actionRemote = ReplicatedStorage:WaitForChild("YamaAction")
local stateRemote = ReplicatedStorage:WaitForChild("YamaState")

local INK = Color3.fromRGB(236, 232, 214)
local PANEL = Color3.fromRGB(16, 24, 18)
local MOSS = Color3.fromRGB(88, 140, 74)
local PAPER = Color3.fromRGB(248, 244, 232)
local GOLD = Color3.fromRGB(224, 176, 78)
local MUTED = Color3.fromRGB(176, 186, 162)

local CHOICES = {
	{ id = "dictor", name = "Диктор", line = "Реплика, пауза и луч", color = Color3.fromRGB(86, 148, 204) },
	{ id = "tumba", name = "Тумба", line = "Врастает и бьёт башем", color = Color3.fromRGB(196, 122, 72) },
	{ id = "otrazhatel", name = "Отражатель", line = "Окно «опа» и толчок", color = Color3.fromRGB(214, 176, 72) },
	{ id = "dvornik", name = "Дворник", line = "Тумбы, полив, струя", color = Color3.fromRGB(78, 158, 96) },
}

local KEYS = {
	[Enum.KeyCode.Q] = "q",
	[Enum.KeyCode.E] = "e",
	[Enum.KeyCode.R] = "r",
	[Enum.KeyCode.One] = "jacket",
	[Enum.KeyCode.Two] = "whistle",
	[Enum.KeyCode.Three] = "energy",
	[Enum.KeyCode.F] = "tap",
}

local NAMES = {
	dictor = { "Реплика", "Пауза", "Эфир" },
	tumba = { "Врос", "Отскок", "Баш" },
	otrazhatel = { "Опа", "Толчок", "Эхо" },
	dvornik = { "Кадка", "Лейка", "Шланг" },
}
local DISPLAY = {
	dictor = "Диктор",
	tumba = "Тумба",
	otrazhatel = "Отражатель",
	dvornik = "Дворник",
}
local FIGHTER_COLOR = {}
for _, choice in CHOICES do
	FIGHTER_COLOR[choice.id] = choice.color
end

local gui = Instance.new("ScreenGui")
gui.Name = "Yama"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")

local function corner(parent, radius)
	local ui = Instance.new("UICorner")
	ui.CornerRadius = UDim.new(0, radius or 12)
	ui.Parent = parent
end

local function stroke(parent, color, thickness)
	local line = Instance.new("UIStroke")
	line.Color = color or MOSS
	line.Thickness = thickness or 1
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.Parent = parent
end

local function label(parent, size, pos, text, fontSize)
	local item = Instance.new("TextLabel")
	item.BackgroundTransparency = 1
	item.Size = size
	item.Position = pos
	item.Font = Enum.Font.Gotham
	item.TextSize = fontSize or 14
	item.TextXAlignment = Enum.TextXAlignment.Left
	item.TextColor3 = INK
	item.Text = text or ""
	item.Parent = parent
	return item
end

local function panel(size, pos)
	local frame = Instance.new("Frame")
	frame.Size = size
	frame.Position = pos
	frame.BackgroundColor3 = PANEL
	frame.BackgroundTransparency = 0.12
	frame.BorderSizePixel = 0
	frame.Parent = gui
	corner(frame, 16)
	stroke(frame, Color3.fromRGB(168, 190, 150), 1)
	return frame
end

