		{ 0.08, { RightShoulder = CFrame.Angles(math.rad(-40), 0, math.rad(-20)), LeftShoulder = CFrame.Angles(math.rad(-40), 0, math.rad(20)), Waist = CFrame.Angles(0, math.rad(-25), 0) } },
