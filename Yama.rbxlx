			color = Color3.fromRGB(132, 92, 58),
			material = Enum.Material.Wood,
			collide = false,
		})
		if i % 6 == 0 then
			part({
				name = "Lamp",
				parent = lobby,
				shape = Enum.PartType.Ball,
				size = Vector3.new(0.7, 0.7, 0.7),
