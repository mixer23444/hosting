local NAMES = {
	dictor = { "Реплика", "Пауза", "Эфир" },
	tumba = { "Врос", "Отскок", "Баш" },
	otrazhatel = { "Опа", "Толчок", "Эхо" },
	dvornik = { "Кадка", "Лейка", "Шланг" },
}
local DISPLAY = {
	dictor = "Диктор",
	tumba = "Тумба",
	otrazhatel = "Отражатель",
	dvornik = "Дворник",
}

local function fmtTime(seconds)
	seconds = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function ratio(value, maxValue)
	if not maxValue or maxValue <= 0 then
		return 0
	end
	return math.clamp(value / maxValue, 0, 1)
end

local function cdText(seconds, locked, lockLabel)
	if locked then
		return lockLabel
	end
	if seconds and seconds > 0.05 then
		return string.format("%.0f", math.ceil(seconds))
	end
	return "готово"
end

local function applyState(packet)
	if typeof(packet) ~= "table" then
		return
	end
	status.Text = packet.status or ""
	if packet.phase == "fight" then
		timer.Text = fmtTime(packet.timeLeft or 0)
	elseif packet.phase == "countdown" then
		timer.Text = "старт"
	else
		timer.Text = ""
	end
	local you = packet.you
	local picked = you and you.fighter
	picker.Visible = packet.phase ~= "ending" and (not picked or packet.phase == "lobby" or packet.phase == "countdown")
	if you and picked then
		nameLabel.Text = DISPLAY[you.fighter] or you.fighter
		local nextXp = you.nextXp or you.xp
		if you.level >= 6 then
			levelLabel.Text = "уровень 6"
		else
			levelLabel.Text = string.format("уровень %d   %d/%d", you.level, you.xp, nextXp)
		end
		hpFill.Size = UDim2.fromScale(ratio(you.hp, you.maxHp), 1)
		manaFill.Size = UDim2.fromScale(ratio(you.mana, you.maxMana), 1)
		local extra = ""
		if you.shield and you.shield > 0 then
			extra = "   щит " .. you.shield
		end
		if you.rooted then
			extra ..= "   врос"
		end
		goldLabel.Text = tostring(you.gold) .. " золота" .. extra
		killLabel.Text = tostring(you.kills) .. " убийств, смертей " .. tostring(you.deaths)
		local names = NAMES[you.fighter] or { "Q", "E", "R" }
		boxes.q.title.Text = names[1]
		boxes.e.title.Text = names[2]
		boxes.r.title.Text = names[3]
		boxes.q.cd.Text = cdText(you.cd.q, false, "")
		boxes.e.cd.Text = cdText(you.cd.e, you.lockE, "ур. 2")
		boxes.r.cd.Text = cdText(you.cd.r, you.lockR, "ур. 4")
		shop.Visible = you.nearShop == true and packet.phase == "fight" and not picker.Visible
		local ownedText = {
			baton = "Батон есть",
			jacket = "Куртка есть",
			whistle = "Свисток есть",
			energy = "Энергетик есть",
		}
		local priceText = {
			baton = "Батон 250",
			jacket = "Куртка 500",
			whistle = "Свисток 350",
			energy = "Энергетик 200",
		}
		for id, button in shopButtons do
			local owned = you.items and you.items[id]
			button.Text = owned and ownedText[id] or priceText[id]
			button.AutoButtonColor = not owned
		end
	else
		nameLabel.Text = "Боец не выбран"
		levelLabel.Text = ""
		goldLabel.Text = ""
		killLabel.Text = ""
		shop.Visible = false
	end
	for index = 1, 8 do
		local row = packet.board and packet.board[index]
		if row then
			boardRows[index].Text = string.format("%d  %s  %s", row.kills or 0, row.fighter or "", row.name or "")
		else
			boardRows[index].Text = ""
		end
	end
end

local function aimPoint()
	local camera = workspace.CurrentCamera
	local viewport = camera.ViewportSize
	local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local ignore = { player.Character, workspace:FindFirstChild("YamaFx") }
	params.FilterDescendantsInstances = ignore
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	if hit then
		return hit.Position
	end
	return ray.Origin + ray.Direction * 80
end

local function bindCamera(character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end
	humanoid.CameraOffset = Vector3.new(2.2, 1.4, 0)
	player.CameraMinZoomDistance = 12
	player.CameraMaxZoomDistance = 22
	local camera = workspace.CurrentCamera
	camera.CameraSubject = humanoid
	camera.CameraType = Enum.CameraType.Custom
end

player.CharacterAdded:Connect(function(character)
	task.defer(function()
		bindCamera(character)
	end)
end)
if player.Character then
	task.defer(function()
		bindCamera(player.Character)
	end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local action = nil
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		action = "attack"
	else
		action = KEYS[input.KeyCode]
	end
	if action then
		actionRemote:FireServer(action, aimPoint())
	end
end)

stateRemote.OnClientEvent:Connect(applyState)

RunService.RenderStepped:Connect(function()
	for _, other in Players:GetPlayers() do
		local character = other.Character
		if character then
			local hidden = character:GetAttribute("YamaInvis") == true
			for _, piece in character:GetDescendants() do
				if piece:IsA("BasePart") then
					if hidden then
						piece.LocalTransparencyModifier = other == player and 0.55 or 1
					else
						piece.LocalTransparencyModifier = 0
					end
				end
			end
		end
	end
end)
]]></ProtectedString>
      </Properties>
    </Item>
    </Item>
  </Item>
</roblox>
