local poseBase = setmetatable({}, { __mode = "k" })
local limbBase = setmetatable({}, { __mode = "k" })

local function poseGoon(model, motorName, pitch, bob)
	local motor = model:FindFirstChild(motorName, true)
	if not motor or not motor:IsA("Motor6D") then
		return
	end
	if not limbBase[motor] then
		limbBase[motor] = motor.C0
	end
	motor.C0 = limbBase[motor] * CFrame.new(0, bob or 0, 0) * CFrame.Angles(pitch or 0, 0, 0)
end

