local function flourish(model, kind)
	if not model then
		return
	end
	local motors = {}
	for _, item in model:GetDescendants() do
		if item:IsA("Motor6D") and (item.Name == "RightShoulder" or item.Name == "LeftShoulder" or item.Name == "Waist" or item.Name == "Neck") then
			motors[item.Name] = item
			if not poseBase[item] then
				poseBase[item] = item.C0
			end
		end
	end
	if not motors.RightShoulder and not motors.LeftShoulder then
		return
	end
	poseToken[model] = (poseToken[model] or 0) + 1
	local mine = poseToken[model]
	local steps = POSES[kind] or POSES.slash
	task.spawn(function()
		for _, step in steps do
			if poseToken[model] ~= mine then
				return
			end
			local duration = step[1]
			local goals = step[2]
			local started = os.clock()
			local from = {}
			for name, motor in motors do
				from[name] = motor.C0
			end
			while os.clock() - started < duration do
				if poseToken[model] ~= mine then
					return
				end
				local alpha = (os.clock() - started) / duration
				for name, motor in motors do
					local goal = goals[name]
					local base = poseBase[motor]
					if goal and base and motor.Parent then
						motor.C0 = from[name]:Lerp(base * goal, alpha)
					end
				end
				task.wait()
			end
		end
		if poseToken[model] ~= mine then
			return
		end
		for _, motor in motors do
			local base = poseBase[motor]
			if base and motor.Parent then
				motor.C0 = base
			end
		end
	end)
end

local function sfx(position, name, volume, pitch)
	local id = SOUND_ID[name]
	if not id or typeof(position) ~= "Vector3" then
		return
	end
	local host = Instance.new("Part")
	host.Name = "Sfx"
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.Transparency = 1
	host.Size = Vector3.new(0.2, 0.2, 0.2)
	host.CFrame = CFrame.new(position)
	host.Parent = fxFolder
	local sound = Instance.new("Sound")
	sound.SoundId = id
	sound.Volume = volume or 0.85
	sound.PlaybackSpeed = pitch or 1
	sound.RollOffMaxDistance = 120
	sound.Looped = false
	sound.Parent = host
	sound:Play()
	task.delay(0.55, function()
		if sound.Parent then
			sound:Stop()
		end
	end)
	Debris:AddItem(host, 2)
end

local function swipe(entry, color)
	local root = rootPart(entry.model)
	if not root then
		return
	end
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if flat.Magnitude < 0.1 then
		return
	end
	local colorUse = color or Color3.fromRGB(255, 244, 220)
	for step = 1, 3 do
		local yaw = math.rad(-28 + step * 18)
		local dir = CFrame.fromAxisAngle(Vector3.yAxis, yaw) * flat.Unit
		local blade = Instance.new("Part")
		blade.Name = "Swipe"
		blade.Size = Vector3.new(0.18, 1.3 + step * 0.25, 2.4 + step * 0.45)
		blade.Material = Enum.Material.Neon
		blade.Color = colorUse
		blade.Transparency = 0.15 + step * 0.18
		blade.Anchored = true
		blade.CanCollide = false
		blade.CanQuery = false
		blade.CFrame = CFrame.lookAt(root.Position + Vector3.new(0, 1.2 + step * 0.15, 0) + dir * (2.4 + step * 0.6), root.Position + dir)
		blade.Parent = fxFolder
		Debris:AddItem(blade, 0.08 + step * 0.04)
	end
	local ring = Instance.new("Part")
	ring.Name = "SwingRing"
	ring.Shape = Enum.PartType.Cylinder
	ring.Size = Vector3.new(0.18, 6.5, 6.5)
	ring.Material = Enum.Material.Neon
	ring.Color = colorUse
	ring.Transparency = 0.45
	ring.Anchored = true
	ring.CanCollide = false
	ring.CanQuery = false
	ring.CFrame = CFrame.new(root.Position.X, root.Position.Y - 2.4, root.Position.Z) * CFrame.Angles(0, 0, math.rad(90))
	ring.Parent = fxFolder
	Debris:AddItem(ring, 0.16)
end

local function emitTex(parent, texture, color, count, speed, life, size0, size1, spread)
	local emitter = Instance.new("ParticleEmitter")
	emitter.Texture = texture
	emitter.Color = ColorSequence.new(color)
	emitter.LightEmission = 0.85
	emitter.LightInfluence = 0.2
	emitter.Rate = 0
	emitter.Speed = NumberRange.new(speed * 0.45, speed)
	emitter.Lifetime = NumberRange.new(life * 0.7, life)
	emitter.Rotation = NumberRange.new(0, 360)
	emitter.RotSpeed = NumberRange.new(-140, 140)
	emitter.SpreadAngle = Vector2.new(spread, spread)
	emitter.Drag = 3
	emitter.Acceleration = Vector3.new(0, 6, 0)
	emitter.Size = NumberSequence.new({
		NumberSequenceKeypoint.new(0, size0 * 0.4),
		NumberSequenceKeypoint.new(0.2, size0),
		NumberSequenceKeypoint.new(1, size1),
	})
	emitter.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.05),
		NumberSequenceKeypoint.new(0.7, 0.35),
		NumberSequenceKeypoint.new(1, 1),
	})
	emitter.Parent = parent
	emitter:Emit(count)
	return emitter
end

local function burstFx(position, kind, color)
	if typeof(position) ~= "Vector3" then
		return
	end
	local host = Instance.new("Part")
	host.Name = "CastFx"
	host.Anchored = true
	host.CanCollide = false
	host.CanQuery = false
	host.Transparency = 1
	host.Size = Vector3.new(0.6, 0.6, 0.6)
	host.CFrame = CFrame.new(position + Vector3.new(0, 1.4, 0))
	host.Parent = fxFolder
	local light = Instance.new("PointLight")
	light.Color = color
	light.Brightness = kind == "bass" and 6 or 3
	light.Range = kind == "bass" and 22 or 14
	light.Parent = host
	local recipe = FX_RECIPE[kind] or FX_RECIPE.slash
	for index, key in recipe do
		local texture = TEX[key] or TEX.star
		emitTex(host, texture, color, 8 + index * 6, 10 + index * 4, 0.35 + index * 0.12, 1.4 + index * 0.8, 0.2, 28 + index * 16)
	end
	if kind == "bass" or kind == "lunge" or kind == "rocket" then
		local ring = Instance.new("ParticleEmitter")
		ring.Texture = TEX.ring
		ring.Color = ColorSequence.new(color)
		ring.LightEmission = 1
		ring.Rate = 0
		ring.Speed = NumberRange.new(0.5, 1)
		ring.Lifetime = NumberRange.new(0.35, 0.45)
		ring.Size = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 1),
			NumberSequenceKeypoint.new(1, kind == "bass" and 16 or 9),
		})
		ring.Transparency = NumberSequence.new({
			NumberSequenceKeypoint.new(0, 0.15),
			NumberSequenceKeypoint.new(1, 1),
		})
		ring.Orientation = Enum.ParticleOrientation.VelocityPerpendicular
		ring.Parent = host
		ring:Emit(3)
	end
	Debris:AddItem(host, 1.1)
end

local SHAKE_FOR = {
	slash = 0.1,
	lunge = 0.24,
	magic = 0.18,
	snap = 0.14,
	water = 0.12,
	bass = 0.48,
	rocket = 0.3,
	glass = 0.2,
	switch = 0.15,
	splat = 0.18,
}

local function cue(entry, animKind, soundName, pitch, speed)
	if not entry or not entry.model then
		return
	end
	local pos = posOfModel(entry.model)
	local info = entry.state and entry.state.fighter and FIGHTERS[entry.state.fighter]
	local color = info and info.color or Color3.fromRGB(255, 220, 140)
	if pos then
		sfx(pos, soundName, 0.85, pitch)
		burstFx(pos, soundName, color)
	end
	swipe(entry, color)
	local pack = dummyAnims[entry.model]
	if pack and pack.slash then
		pack.slash:Play(0.05, 1, 1.2)
	end
	fxRemote:FireAllClients({
		anim = animKind,
		shake = SHAKE_FOR[soundName] or 0.12,
		model = entry.model,
	})
end

local function beamVisual(a, b, color, life)
	local delta = b - a
	local length = delta.Magnitude
	if length < 0.2 then
		return
	end
	local beam = Instance.new("Part")
	beam.Name = "Beam"
	beam.Anchored = true
	beam.CanCollide = false
	beam.CanQuery = false
	beam.Material = Enum.Material.Neon
	beam.Color = color
	beam.Size = Vector3.new(0.35, 0.35, length)
	beam.CFrame = CFrame.lookAt(a:Lerp(b, 0.5), b)
	beam.Parent = fxFolder
	Debris:AddItem(beam, life or 0.16)
end

local function floatText(position, text, color)
	local anchor = Instance.new("Part")
	anchor.Anchored = true
	anchor.CanCollide = false
	anchor.CanQuery = false
	anchor.Transparency = 1
	anchor.Size = Vector3.new(0.4, 0.4, 0.4)
	anchor.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
	anchor.Parent = fxFolder
	local gui = Instance.new("BillboardGui")
	gui.Size = UDim2.fromOffset(120, 28)
	gui.AlwaysOnTop = true
	gui.Parent = anchor
	local label = Instance.new("TextLabel")
	label.Size = UDim2.fromScale(1, 1)
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.GothamBold
	label.TextSize = 16
	label.TextColor3 = color
	label.TextStrokeTransparency = 0.3
	label.Text = text
	label.Parent = gui
	Debris:AddItem(anchor, 0.7)
end

local function distToSegment(point, a, b)
	local ab = b - a
	local denom = ab:Dot(ab)
	local t = 0
	if denom > 0.001 then
		t = math.clamp((point - a):Dot(ab) / denom, 0, 1)
	end
	return (point - (a + ab * t)).Magnitude
end

local function fighterOf(st)
	return st and st.fighter and FIGHTERS[st.fighter]
end

local function entryOfPlayer(player)
	local st = playersState[player]
	local character = player.Character
	if not st or not character or not rootPart(character) then
		return nil
	end
	return { kind = "player", player = player, state = st, model = character }
end

local function enemiesOf(source)
	local list = {}
	if source.kind == "player" then
		for _, player in Players:GetPlayers() do
			local st = playersState[player]
			local character = player.Character
			if player ~= source.player and st and st.alive and st.fighter and character and rootPart(character) then
				table.insert(list, { kind = "player", player = player, state = st, model = character })
			end
		end
		for model, st in dummyByModel do
			if st.alive and model.Parent and rootPart(model) then
				table.insert(list, { kind = "dummy", state = st, model = model })
			end
		end
	else
		for _, player in Players:GetPlayers() do
			local st = playersState[player]
			local character = player.Character
			if st and st.alive and st.fighter and character and rootPart(character) then
				table.insert(list, { kind = "player", player = player, state = st, model = character })
			end
		end
	end
	return list
end

local function face(entry, aim)
	if entry.kind == "player" then
		return
	end
	local root = rootPart(entry.model)
	if not root or typeof(aim) ~= "Vector3" then
		return
	end
	local flat = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
	if flat.Magnitude < 0.2 then
		return
	end
	local vel = root.AssemblyLinearVelocity
	root.CFrame = CFrame.new(root.Position, root.Position + flat)
	root.AssemblyLinearVelocity = vel
end

local function breakInvis(st)
	st.invisibleUntil = 0
	st.whistleAt = 0
end

local function dmgMul(st)
	local mul = 1 + (st.level - 1) * 0.08
	if st.castBoost then
		mul *= 1.4
	end
	if st.fighter == "dvornik" then
		for _, turret in turrets do
			if turret.owner == st.ownerPlayer then
				mul *= 1.15
				break
			end
		end
	end
	return mul
end

local function takeMul(st)
	local mul = dmgMul(st)
	st.castBoost = false
	return mul
end

local function speedOf(st, now)
	if not st.alive or now < st.stunUntil or (st.rooted and now < st.rootUntil) then
		return 0
	end
	local mul = 1
	if now < st.slowUntil then
		mul *= 0.55
	end
	if now < st.hasteUntil then
		mul *= st.hasteMul
	end
	if now < st.energyUntil then
		mul *= 1.35
	end
	return st.baseSpeed * mul
end

local function statusLine()
	if phase == "lobby" then
		return "Выбери бойца"
	end
	if phase == "ending" then
		return winnerText
	end
	if creature then
		return "Хомяк в центре. Подойди и жми F"
	end
	return "8 минут. Победа — 20 убийств или лидер таблицы"
end

local function timeLeft()
	local now = os.clock()
	if phase == "fight" then
		return math.max(0, matchEnd - now)
	end
	if phase == "countdown" then
		return math.max(0, countdownEnd - now)
	end
	return 0
end

local function grantXp(st, amount)
	st.xp += amount
	while st.level < 6 and st.xp >= LEVEL_XP[st.level + 1] do
		st.level += 1
		st.maxHp += 40
		st.hp = math.min(st.maxHp, st.hp + 40)
		st.maxMana += 10
		st.mana = math.min(st.maxMana, st.mana + 10)
	end
end

local function unlocked(st, key)
	if key == "q" then
		return true
	end
	if key == "e" then
		return st.level >= 2
	end
	if key == "r" then
		return st.level >= 4
	end
	return true
end

local endMatch
local applyDamage
local tapCreature
local spawnDummy

local function kill(source, target)
	local st = target.state
	if not st.alive then
		return
	end
	st.alive = false
	st.hp = 0
	st.channel = nil
	st.rooted = false
	st.streak = 0
	st.guardUntil = 0
	local deathPos = posOfModel(target.model)
	if target.kind == "player" then
		st.deaths += 1
		st.pendingSpawn = phase == "fight"
		local humanoid = target.model:FindFirstChildOfClass("Humanoid")
		if humanoid and humanoid.Health > 0 then
			humanoid.Health = 0
		end
	else
		local model = target.model
		local respawnIndex = st.slot or 1
		local serial = st.serial
		dummyByModel[model] = nil
		dummyAnims[model] = nil
		model:Destroy()
		task.delay(8, function()
			if phase == "fight" and serial == roundSerial then
				spawnDummy(respawnIndex, serial)
			end
		end)
	end
	if source and source.kind == "player" and source.state then
		source.state.kills += 1
		source.state.streak = (source.state.streak or 0) + 1
		source.state.gold += 60
		grantXp(source.state, 120)
		if source.state.streak % 3 == 0 then
			source.state.gold += 45
			source.state.hasteUntil = os.clock() + 4
			source.state.hasteMul = 1.4
			if deathPos then
				floatText(deathPos + Vector3.new(0, 2, 0), "серия +45", Color3.fromRGB(255, 196, 80))
			end
		end
		if deathPos then
			floatText(deathPos, "+1", Color3.fromRGB(255, 220, 140))
		end
		if source.state.kills >= WIN_KILLS then
			endMatch()
		end
	end
end

local function immune(st, now, selfCast)
	return now < st.immuneUntil and not selfCast
end

local function cc(target, kind, duration, source)
	local st = target.state
	if not st or not st.alive then
		return false
	end
	local now = os.clock()
	local selfCast = source and source.model == target.model
	if immune(st, now, selfCast) then
		floatText(posOfModel(target.model) or Vector3.zero, "мимо", Color3.fromRGB(200, 200, 210))
		return false
	end
	local untilT = now + duration
	if kind == "stun" then
		st.stunUntil = math.max(st.stunUntil, untilT)
		st.channel = nil
		st.rooted = false
		floatText(posOfModel(target.model) or Vector3.zero, "стан", Color3.fromRGB(255, 230, 120))
	elseif kind == "silence" then
		st.silenceUntil = math.max(st.silenceUntil, untilT)
		floatText(posOfModel(target.model) or Vector3.zero, "тишина", Color3.fromRGB(170, 140, 255))
	elseif kind == "disarm" then
		st.disarmUntil = math.max(st.disarmUntil, untilT)
		floatText(posOfModel(target.model) or Vector3.zero, "выбил", Color3.fromRGB(255, 160, 120))
	elseif kind == "slow" then
		st.slowUntil = math.max(st.slowUntil, untilT)
		floatText(posOfModel(target.model) or Vector3.zero, "вязко", Color3.fromRGB(140, 190, 255))
	end
	return true
end

applyDamage = function(source, target, amount, kind, flags)
	flags = flags or {}
	if phase ~= "fight" or not target or amount <= 0 then
		return
	end
	if target.kind == "creature" then
		if source and source.kind == "player" then
			tapCreature(source.player)
		end
		return
	end
	local st = target.state
	if not st or not st.alive then
		return
	end
	local now = os.clock()
	local spell = kind ~= "physical" or flags.projectile
	if st.reflectUntil > now and not flags.reflected and not flags.thorns and spell and source and source.model ~= target.model then
		st.reflectUntil = 0
		st.hasteUntil = now + 1.2
		st.hasteMul = 1.3
		local back = posOfModel(target.model)
		if back then
			burst(back, Color3.fromRGB(255, 230, 120), 4, 0.3)
			floatText(back, "опа", Color3.fromRGB(255, 230, 120))
		end
		applyDamage(target, source, amount, kind, { reflected = true, projectile = flags.projectile })
		return
	end
	if now < st.immuneUntil and kind == "magic" then
		return
	end
	if st.shield > 0 and now < st.shieldUntil then
		local absorbed = math.min(st.shield, amount)
		st.shield -= absorbed
		amount -= absorbed
	end
	if st.rooted and now < st.rootUntil then
		amount *= 0.75
	end
	if now < (st.guardUntil or 0) then
		amount *= 0.62
		if source and source.state and source.model ~= target.model and not flags.thorns and kind == "physical" then
			applyDamage(target, source, 14, "physical", { thorns = true })
		end
	end
	if amount <= 0 then
		return
	end
	st.hp -= amount
	local where = posOfModel(target.model)
	if where then
		burst(where + Vector3.new(0, 1.5, 0), kind == "magic" and Color3.fromRGB(150, 120, 255) or Color3.fromRGB(255, 120, 90), 1.4, 0.15)
	end
	if st.hp <= 0 then
		kill(source, target)
	end
end

tapCreature = function(player)
	local st = playersState[player]
	if not creature or not creature.PrimaryPart or not st or phase ~= "fight" then
		return
	end
	local character = player.Character
	local root = rootPart(character)
	if not root or not st.alive then
		return
	end
	if (root.Position - creature.PrimaryPart.Position).Magnitude > 12 then
		return
	end
	if (creatureCd[player] or 0) > os.clock() then
		return
	end
	creatureCd[player] = os.clock() + 0.45
	st.gold += 80
	burst(creature.PrimaryPart.Position, Color3.fromRGB(255, 190, 80), 3, 0.2)
	floatText(creature.PrimaryPart.Position, "+80", Color3.fromRGB(255, 210, 90))
	sfx(creature.PrimaryPart.Position, "splat", 0.45, 1.1)
end

local function nearestEnemy(entry, reach)
	local origin = posOfModel(entry.model)
	if not origin then
		return nil
	end
	local best = nil
	local bestDist = reach
	for _, enemy in enemiesOf(entry) do
		local pos = posOfModel(enemy.model)
		if pos then
			local dist = (pos - origin).Magnitude
			if dist <= bestDist then
				best = enemy
				bestDist = dist
			end
		end
	end
	return best
end

local function coneEnemies(entry, reach, dotMin)
	local root = rootPart(entry.model)
	if not root then
		return {}
	end
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if look.Magnitude < 0.1 then
		return {}
	end
	look = look.Unit
	local hits = {}
	for _, enemy in enemiesOf(entry) do
		local pos = posOfModel(enemy.model)
		if pos then
			local delta = Vector3.new(pos.X - root.Position.X, 0, pos.Z - root.Position.Z)
			if delta.Magnitude <= reach and delta.Magnitude > 0.1 and delta.Unit:Dot(look) >= dotMin then
				table.insert(hits, enemy)
			end
		end
	end
	return hits
end

local function push(entry, dir, force, selfPush)
	local st = entry.state
	if st and not selfPush and os.clock() < st.immuneUntil then
		return
	end
	local root = rootPart(entry.model)
	if not root then
		return
	end
	local flat = Vector3.new(dir.X, 0, dir.Z)
	if flat.Magnitude < 0.1 then
		return
	end
	root.AssemblyLinearVelocity = flat.Unit * force + Vector3.new(0, 16, 0)
end

local function creatureEntry()
	if creature and creature.PrimaryPart then
		return { kind = "creature", model = creature, state = nil }
	end
	return nil
end

local function trySpend(st, key, cost, cd)
	local now = os.clock()
	if not st.alive or now < st.stunUntil or st.channel then
		return false
	end
	if now < st.silenceUntil then
		return false
	end
	if not unlocked(st, key) then
		return false
	end
	if now < (st.cd[key] or 0) then
		return false
	end
	if st.mana < cost then
		return false
	end
	st.mana -= cost
	st.cd[key] = now + cd
	if st.fighter == "dictor" then
		st.castCount += 1
		st.castBoost = st.castCount % 4 == 0
	else
		st.castBoost = false
	end
	if key ~= "r" then
		st.lastCast = key
	end
	breakInvis(st)
	return true
end

local function countOwnTurrets(player)
	local count = 0
	for _, turret in turrets do
		if turret.owner == player then
			count += 1
		end
	end
	return count
end

local castQ
local castE

local function castDictorQ(entry, replayMul)
	local root = rootPart(entry.model)
	if not root then
		return false
	end
	local mul = takeMul(entry.state) * replayMul
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if flat.Magnitude < 0.1 then
		return false
	end
	local origin = root.Position + Vector3.new(0, 1.4, 0)
	local dest = origin + flat.Unit * 42
	beamVisual(origin, dest, Color3.fromRGB(120, 180, 255), 0.28)
	local hit = false
	for _, enemy in enemiesOf(entry) do
		local pos = posOfModel(enemy.model)
		if pos and distToSegment(pos, origin, dest) <= 3.4 then
			applyDamage(entry, enemy, 78 * mul, "pure")
			cc(enemy, "silence", 1.5 * replayMul, entry)
			hit = true
		end
	end
	return hit or true
end

local function castTumbaQ(entry, replayMul)
	local st = entry.state
	takeMul(st)
	st.guardUntil = os.clock() + 3.4 * replayMul
	local pos = posOfModel(entry.model)
	if pos then
		burst(pos, Color3.fromRGB(200, 120, 70), 7, 0.4)
		floatText(pos, "пень", Color3.fromRGB(220, 150, 90))
	end
	return true
end

local function castReflectQ(entry, replayMul)
	local st = entry.state
	takeMul(st)
	st.reflectUntil = os.clock() + 1.15 * replayMul
	local pos = posOfModel(entry.model)
	if pos then
		burst(pos, Color3.fromRGB(255, 220, 100), 5, 0.25)
		floatText(pos, "опа", Color3.fromRGB(255, 220, 100))
	end
	return true
end

local function castDvornikQ(entry, aim, replayMul)
	local st = entry.state
	local root = rootPart(entry.model)
	if not root then
		return false
	end
	local mul = takeMul(st)
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if typeof(aim) == "Vector3" then
		local aimed = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
		if aimed.Magnitude > 0.2 then
			flat = aimed
		end
	end
	if flat.Magnitude < 0.1 then
		return false
	end
	local dist = math.clamp(flat.Magnitude, 6, 22)
	local planted = root.Position + flat.Unit * dist
	planted = Vector3.new(math.clamp(planted.X, -140, 140), 2.2, math.clamp(planted.Z, -140, 140))
	while countOwnTurrets(entry.player) >= 2 do
		for index, turret in turrets do
			if turret.owner == entry.player then
				turret.model:Destroy()
				table.remove(turrets, index)
				break
			end
		end
	end
	local model = Instance.new("Model")
	model.Name = "Tumba"
	local pot = part({
		name = "Pot",
		size = Vector3.new(2.4, 2.2, 2.4),
		cf = CFrame.new(planted),
		color = Color3.fromRGB(120, 86, 60),
		material = Enum.Material.Wood,
		parent = model,
	})
	part({
		name = "Sprout",
		size = Vector3.new(0.5, 2.4, 0.5),
		cf = CFrame.new(planted + Vector3.new(0, 2, 0)),
		color = Color3.fromRGB(90, 180, 100),
		material = Enum.Material.Grass,
		collide = false,
		parent = model,
	})
	model.PrimaryPart = pot
	model.Parent = workspace
	table.insert(turrets, {
		owner = entry.player,
		model = model,
		untilT = os.clock() + 8 * replayMul,
		nextTick = os.clock() + 0.3,
		mul = mul * replayMul,
	})
	return true
end

castQ = function(entry, aim, replay)
	local st = entry.state
	local spec = ABILITIES[st.fighter].q
	local replayMul = replay and 0.5 or 1
	if not replay and not trySpend(st, "q", spec[1], spec[2]) then
		return
	end
	face(entry, aim)
	local ok = true
	if st.fighter == "dictor" then
		ok = castDictorQ(entry, replayMul)
	elseif st.fighter == "tumba" then
		ok = castTumbaQ(entry, replayMul)
	elseif st.fighter == "otrazhatel" then
		ok = castReflectQ(entry, replayMul)
	elseif st.fighter == "dvornik" then
		ok = castDvornikQ(entry, aim, replayMul)
	end
	if not ok and not replay then
		st.mana += spec[1]
		st.cd.q = 0
		st.castCount = math.max(0, st.castCount - 1)
		st.castBoost = false
	elseif ok then
		if st.fighter == "dictor" then
			cue(entry, "point", "magic", 1.15, 1)
		elseif st.fighter == "tumba" then
			cue(entry, "cheer", "bass", 0.8, 0.9)
		elseif st.fighter == "otrazhatel" then
			cue(entry, "wave", "glass", 1.1, 1)
		elseif st.fighter == "dvornik" then
			cue(entry, "slash", "snap", 1, 1.1)
		end
	end
end

local function castDictorE(entry, replayMul)
	local st = entry.state
	takeMul(st)
	local now = os.clock()
	st.shield = 80 * replayMul
	st.shieldUntil = now + 2.4 * replayMul
	st.hasteUntil = now + 2.4 * replayMul
	st.hasteMul = 1.35
	local pos = posOfModel(entry.model)
	if pos then
		burst(pos, Color3.fromRGB(140, 180, 255), 8, 0.35)
		for _, enemy in enemiesOf(entry) do
			local enemyPos = posOfModel(enemy.model)
			if enemyPos and (enemyPos - pos).Magnitude <= 16 then
				cc(enemy, "slow", 2.2 * replayMul, entry)
			end
		end
	end
end

local function castTumbaE(entry, aim, replayMul)
	local st = entry.state
	local mul = takeMul(st) * replayMul
	face(entry, aim)
	local root = rootPart(entry.model)
	if not root then
		return
	end
	local look = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if look.Magnitude < 0.1 then
		return
	end
	local hits = coneEnemies(entry, 11, 0.2)
	for _, enemy in hits do
		applyDamage(entry, enemy, 70 * mul, "physical")
		local pos = posOfModel(enemy.model)
		if pos then
			push(enemy, pos - root.Position, 48)
		end
	end
	burst(root.Position, Color3.fromRGB(210, 130, 80), 4, 0.2)
end

local function castReflectE(entry, aim, replayMul)
	local st = entry.state
	local mul = takeMul(st) * replayMul
	local root = rootPart(entry.model)
	if not root then
		return
	end
	face(entry, aim)
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if typeof(aim) == "Vector3" then
		local aimed = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
		if aimed.Magnitude > 0.4 then
			flat = aimed
		end
	end
	if flat.Magnitude < 0.1 then
		return
	end
	local dist = math.clamp(flat.Magnitude, 6, 12)
	local dest = root.Position + flat.Unit * dist
	dest = Vector3.new(math.clamp(dest.X, -150, 150), root.Position.Y, math.clamp(dest.Z, -150, 150))
	local vel = root.AssemblyLinearVelocity
	root.CFrame = CFrame.lookAt(dest, dest + flat)
	root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
	root.AssemblyAngularVelocity = Vector3.zero
	burst(dest, Color3.fromRGB(240, 210, 100), 5, 0.25)
	for _, enemy in enemiesOf(entry) do
		local pos = posOfModel(enemy.model)
		if pos and (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(dest.X, 0, dest.Z)).Magnitude <= 8 then
			applyDamage(entry, enemy, 70 * mul, "physical")
		end
	end
end

local function castDvornikE(entry, replayMul)
	local st = entry.state
	takeMul(st)
	local heal = 75 * replayMul
	st.hp = math.min(st.maxHp, st.hp + heal)
	local origin = posOfModel(entry.model)
	if not origin then
		return
	end
	table.insert(puddles, { pos = origin, untilT = os.clock() + 4.5 * replayMul, owner = entry.player })
	burst(origin, Color3.fromRGB(120, 220, 140), 7, 0.35)
	for _, turret in turrets do
		if turret.owner == entry.player and turret.model.PrimaryPart then
			local pos = turret.model.PrimaryPart.Position
			if (pos - origin).Magnitude <= 16 then
				turret.untilT += 2 * replayMul
				burst(pos, Color3.fromRGB(140, 230, 150), 2.5, 0.25)
			end
		end
	end
end

castE = function(entry, aim, replay)
	local st = entry.state
	local spec = ABILITIES[st.fighter].e
	local replayMul = replay and 0.5 or 1
	if not replay and not trySpend(st, "e", spec[1], spec[2]) then
		return
	end
	if st.fighter == "dictor" then
		castDictorE(entry, replayMul)
	elseif st.fighter == "tumba" then
		castTumbaE(entry, aim, replayMul)
	elseif st.fighter == "otrazhatel" then
		castReflectE(entry, aim, replayMul)
	elseif st.fighter == "dvornik" then
		castDvornikE(entry, replayMul)
	end
	if st.fighter == "dictor" then
		cue(entry, "wave", "magic", 0.9, 1)
	elseif st.fighter == "tumba" then
		cue(entry, "lunge", "lunge", 1, 1.15)
	elseif st.fighter == "otrazhatel" then
		cue(entry, "lunge", "lunge", 1.05, 1.1)
	elseif st.fighter == "dvornik" then
		cue(entry, "wave", "water", 1, 1)
	end
end

local function castR(entry, aim)
	local st = entry.state
	local spec = ABILITIES[st.fighter].r
	if not trySpend(st, "r", spec[1], spec[2]) then
		return
	end
	face(entry, aim)
	local root = rootPart(entry.model)
	if not root then
		return
	end
	if st.fighter == "dictor" then
		cue(entry, "point", "rocket", 0.85, 0.9)
	elseif st.fighter == "dvornik" then
		cue(entry, "point", "water", 0.95, 1)
	elseif st.fighter == "tumba" then
		cue(entry, "cheer", "bass", 0.7, 1)
	else
		cue(entry, "wave", "snap", 1.25, 1.1)
	end
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if flat.Magnitude < 0.1 then
		flat = Vector3.new(0, 0, -1)
	end
	flat = flat.Unit
	if st.fighter == "dictor" then
		local mul = takeMul(st)
		local origin = root.Position + Vector3.new(0, 1.4, 0)
		for step = 1, 3 do
			local dest = origin + flat * (14 * step)
			beamVisual(origin, dest, Color3.fromRGB(140, 190, 255), 0.22)
			for _, enemy in enemiesOf(entry) do
				local pos = posOfModel(enemy.model)
				if pos and (pos - dest).Magnitude <= 6 then
					applyDamage(entry, enemy, 36 * mul, "pure")
				end
			end
		end
		return
	end
	if st.fighter == "dvornik" then
		st.channel = {
			kind = "hose",
			untilT = os.clock() + 1.3,
			nextTick = os.clock(),
			dir = flat,
			mul = takeMul(st),
		}
		return
	end
	if st.fighter == "tumba" then
		local mul = takeMul(st)
		st.bashReady = true
		st.bashBonus = 70 * mul
		st.bashUntil = os.clock() + 6
		floatText(root.Position, "баш", Color3.fromRGB(255, 180, 100))
		burst(root.Position, Color3.fromRGB(255, 150, 80), 4, 0.25)
		return
	end
	st.stunUntil = 0
	st.silenceUntil = 0
	st.slowUntil = 0
	st.disarmUntil = 0
	local mul = takeMul(st)
	floatText(root.Position, "чисто", Color3.fromRGB(255, 230, 140))
	burst(root.Position, Color3.fromRGB(255, 220, 120), 8, 0.3)
	for _, enemy in enemiesOf(entry) do
		local pos = posOfModel(enemy.model)
		if pos and (pos - root.Position).Magnitude <= 12 then
			applyDamage(entry, enemy, 62 * mul, "pure")
			push(enemy, pos - root.Position, 36)
		end
	end
end

local function launchProjectile(entry, aim, damage)
	local root = rootPart(entry.model)
	if not root then
		return
	end
	local flat = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
	if typeof(aim) == "Vector3" then
		local aimed = Vector3.new(aim.X - root.Position.X, 0, aim.Z - root.Position.Z)
		if aimed.Magnitude > 0.2 then
			flat = aimed
		end
	end
	if flat.Magnitude < 0.1 then
		return
	end
	local dir = flat.Unit
	local visual = Instance.new("Part")
	visual.Size = Vector3.new(0.45, 0.45, 1.3)
	visual.Anchored = true
	visual.CanCollide = false
	visual.CanQuery = false
	visual.Material = Enum.Material.Neon
	visual.Color = fighterOf(entry.state).color
	visual.Parent = fxFolder
	local tailA = Instance.new("Attachment")
	tailA.Position = Vector3.new(0, 0, 0.55)
	tailA.Parent = visual
	local tailB = Instance.new("Attachment")
	tailB.Position = Vector3.new(0, 0, -0.7)
	tailB.Parent = visual
	local trail = Instance.new("Trail")
	trail.Attachment0 = tailA
	trail.Attachment1 = tailB
	trail.Texture = TEX.claw
	trail.Lifetime = 0.22
	trail.LightEmission = 1
	trail.MinLength = 0.05
	trail.Color = ColorSequence.new(visual.Color)
	trail.Transparency = NumberSequence.new({
		NumberSequenceKeypoint.new(0, 0.1),
		NumberSequenceKeypoint.new(1, 1),
	})
	trail.Parent = visual
	table.insert(projectiles, {
		pos = root.Position + Vector3.new(0, 1.3, 0) + dir * 3,
		dir = dir,
		speed = 96,
		left = 78,
		damage = damage,
		owner = entry,
		part = visual,
	})
end

local function attack(entry, aim)
	local st = entry.state
	local now = os.clock()
	if not st.alive or now < st.stunUntil or now < st.disarmUntil or st.channel then
		return
	end
	local info = fighterOf(st)
	if not info then
		return
	end
	local cd = info.cd
	local manaCost = 0
	if st.items.baton and st.mana >= 8 then
		cd *= 0.7
		manaCost = 8
	end
	if now < st.cd.attack then
		return
	end
	st.cd.attack = now + cd
	st.mana -= manaCost
	breakInvis(st)
	face(entry, aim)
	if info.ranged then
		cue(entry, "point", "rocket", 1.25, 1.4)
	else
		cue(entry, "slash", "slash", 1, 1.55)
	end
	local levelMul = 1 + (st.level - 1) * 0.08
	if st.fighter == "dvornik" and countOwnTurrets(entry.player) > 0 then
		levelMul *= 1.15
	end
	if info.ranged then
		launchProjectile(entry, aim, info.basic * levelMul)
		return
	end
	local hits = coneEnemies(entry, info.reach, 0.2)
	if #hits == 0 then
		local pet = creatureEntry()
		local root = rootPart(entry.model)
		if pet and root and (pet.model.PrimaryPart.Position - root.Position).Magnitude <= info.reach + 3 then
			tapCreature(entry.player)
		end
		return
	end
	local bonus = 0
	if st.bashReady and now <= st.bashUntil then
		st.bashReady = false
		bonus = st.bashBonus or 80
		cc(hits[1], "stun", 1.1, entry)
		st.hp = math.min(st.maxHp, st.hp + 45)
	elseif st.bashReady then
		st.bashReady = false
	end
	local dealt = (info.basic + bonus) * levelMul
	if now < (st.guardUntil or 0) then
		dealt *= 1.35
	end
	applyDamage(entry, hits[1], dealt, "physical")
	if now < (st.guardUntil or 0) then
		local center = posOfModel(hits[1].model)
		if center then
			for index = 2, #hits do
				local otherPos = posOfModel(hits[index].model)
				if otherPos and (otherPos - center).Magnitude <= 7 then
					applyDamage(entry, hits[index], dealt * 0.5, "physical")
				end
			end
		end
	end
end

local function useJacket(st)
	local now = os.clock()
	if not st.alive or not st.items.jacket or now < st.cd.jacket or now < st.stunUntil then
		return
	end
	st.cd.jacket = now + 28
	st.immuneUntil = now + 1.5
	breakInvis(st)
	local player = st.ownerPlayer
	local entry = player and entryOfPlayer(player)
	local pos = entry and posOfModel(entry.model)
	if pos then
		burst(pos, Color3.fromRGB(230, 230, 240), 5, 0.25)
		floatText(pos, "куртка", Color3.fromRGB(230, 230, 240))
	end
	if entry then
		cue(entry, "wave", "glass", 0.95, 1)
	end
end

local function useWhistle(st)
	local now = os.clock()
	if not st.alive or not st.items.whistle or now < st.cd.whistle or now < st.stunUntil or st.channel then
		return
	end
	st.cd.whistle = now + 18
	st.whistleAt = now + 0.4
	local player = st.ownerPlayer
	local entry = player and entryOfPlayer(player)
	if entry then
		cue(entry, "point", "switch", 1.35, 1.2)
	end
end

local function useEnergy(st)
	local now = os.clock()
	if not st.alive or not st.items.energy or now < st.cd.energy or now < st.stunUntil then
		return
	end
	st.cd.energy = now + 16
	st.mana = math.min(st.maxMana, st.mana + 80)
	st.energyUntil = now + 3
	breakInvis(st)
	local player = st.ownerPlayer
	local entry = player and entryOfPlayer(player)
	if entry then
		cue(entry, "cheer", "magic", 1.2, 1)
	end
end

local function buy(player, itemId)
	local st = playersState[player]
	local spec = ITEMS[itemId]
	if not st or not spec or st.items[itemId] or st.gold < spec.price then
		return
	end
	local character = player.Character
	local root = rootPart(character)
	if not root or (root.Position - shopPos).Magnitude > 16 then
		return
	end
	st.gold -= spec.price
	st.items[itemId] = true
	floatText(root.Position, spec.name, Color3.fromRGB(240, 210, 140))
	sfx(root.Position, "button", 0.4, 1.05)
end

local function validAim(aim, origin)
	if typeof(aim) ~= "Vector3" then
		return origin + Vector3.new(0, 0, -8)
	end
	if aim.X ~= aim.X or math.abs(aim.X) > 2000 then
		return origin + Vector3.new(0, 0, -8)
	end
	if (aim - origin).Magnitude > 120 then
		return origin + (aim - origin).Unit * 120
	end
	return aim
end

local function onAction(player, action, aim)
	if typeof(action) ~= "string" or phase ~= "fight" then
		return
	end
	local st = playersState[player]
	if not st or not st.fighter then
		return
	end
	local entry = entryOfPlayer(player)
	if not entry or not st.alive then
		return
	end
	st.ownerPlayer = player
	local origin = posOfModel(entry.model) or Vector3.zero
	aim = validAim(aim, origin)
	if action == "attack" then
		attack(entry, aim)
	elseif action == "q" then
		castQ(entry, aim, false)
	elseif action == "e" then
		castE(entry, aim, false)
	elseif action == "r" then
		castR(entry, aim)
	elseif action == "jacket" then
		useJacket(st)
	elseif action == "whistle" then
		useWhistle(st)
	elseif action == "energy" then
		useEnergy(st)
	elseif action == "tap" then
		tapCreature(player)
	elseif string.sub(action, 1, 4) == "buy_" then
		buy(player, string.sub(action, 5))
	end
end

local function clearOwned(list, player)
	for index = #list, 1, -1 do
		if list[index].owner == player or (list[index].owner and list[index].owner.player == player) then
			if list[index].model then
				list[index].model:Destroy()
			end
			table.remove(list, index)
		end
	end
end

local function wipeCombat()
	for model in dummyByModel do
		model:Destroy()
	end
	dummyByModel = {}
	for _, turret in turrets do
		if turret.model then
			turret.model:Destroy()
		end
	end
	turrets = {}
	projectiles = {}
	if creature then
		creature:Destroy()
		creature = nil
	end
	creatureCd = {}
	fxFolder:ClearAllChildren()
end

local function winnerLine()
	local best = -1
	local names = {}
	for _, player in Players:GetPlayers() do
		local st = playersState[player]
		if st and st.fighter then
			if st.kills > best then
				best = st.kills
				names = { player.DisplayName .. " (" .. FIGHTERS[st.fighter].name .. ")" }
			elseif st.kills == best then
				table.insert(names, player.DisplayName .. " (" .. FIGHTERS[st.fighter].name .. ")")
			end
		end
	end
	if best < 0 then
		return "Раунд окончен"
	end
	if best == 0 then
		return "Ничья. Ни одного убийства"
	end
	return "Победил " .. table.concat(names, ", ") .. " — " .. tostring(best)
end

endMatch = function()
	if phase ~= "fight" then
		return
	end
	phase = "ending"
	winnerText = winnerLine()
	wipeCombat()
	for _, player in Players:GetPlayers() do
		local st = playersState[player]
		if st then
			st.alive = false
			st.channel = nil
			st.pendingSpawn = false
			if player.Character then
				teleport(player.Character, lobbyCFrame(player.UserId))
			end
		end
	end
	local serial = roundSerial
	task.delay(8, function()
		if phase ~= "ending" or roundSerial ~= serial then
			return
		end
		roundSerial += 1
		phase = "lobby"
		winnerText = ""
		wipeCombat()
		for _, player in Players:GetPlayers() do
			playersState[player] = newState()
			player:LoadCharacter()
		end
	end)
end

local function startFight()
	phase = "fight"
	puddles = {}
	local now = os.clock()
	matchEnd = now + MATCH_LEN
	creatureTime = now + CREATURE_AT
	roundSerial += 1
	local serial = roundSerial
	for slot = 1, 3 do
		spawnDummy(slot, serial)
	end
	for _, player in Players:GetPlayers() do
		local st = playersState[player]
		if st and st.fighter then
			clearControl(st)
			st.alive = true
			st.hp = st.maxHp
			st.mana = st.maxMana
			st.pendingSpawn = false
			st.ownerPlayer = player
			if player.Character and rootPart(player.Character) then
				teleport(player.Character, pitCFrame(player.UserId))
				local info = FIGHTERS[st.fighter]
				paint(player.Character, info.color, info.name, st.hp, st.maxHp, st.fighter)
			else
				st.pendingSpawn = true
				player:LoadCharacter()
			end
		end
	end
end

local function plantGoon(model, root, humanoid)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { model, fxFolder }
	local hit = workspace:Raycast(root.Position + Vector3.new(0, 8, 0), Vector3.new(0, -50, 0), params)
	if not hit then
		return
	end
	local stand = 3
	humanoid.HipHeight = stand - root.Size.Y * 0.5
	local targetY = hit.Position.Y + stand
	if math.abs(root.Position.Y - targetY) > 0.45 then
		local look = root.CFrame.LookVector
		local flat = Vector3.new(look.X, 0, look.Z)
		if flat.Magnitude < 0.05 then
			flat = Vector3.new(0, 0, -1)
		end
		local vel = root.AssemblyLinearVelocity
		root.CFrame = CFrame.lookAt(Vector3.new(root.Position.X, targetY, root.Position.Z), Vector3.new(root.Position.X, targetY, root.Position.Z) + flat)
		root.AssemblyLinearVelocity = Vector3.new(vel.X, 0, vel.Z)
	end
end

spawnDummy = function(slot, serial)
	if phase ~= "fight" or serial ~= roundSerial then
		return
	end
	local model = Instance.new("Model")
	local looks = {
		{ name = "Хулиган", body = Color3.fromRGB(120, 36, 40), cloth = Color3.fromRGB(28, 28, 32), skin = Color3.fromRGB(186, 140, 114), hat = "cap" },
		{ name = "Карманник", body = Color3.fromRGB(72, 78, 88), cloth = Color3.fromRGB(36, 40, 48), skin = Color3.fromRGB(198, 164, 132), hat = "band" },
		{ name = "Громила", body = Color3.fromRGB(48, 52, 46), cloth = Color3.fromRGB(24, 26, 24), skin = Color3.fromRGB(160, 128, 104), hat = "mask" },
	}
	local look = looks[((slot - 1) % 3) + 1]
	model.Name = look.name
	local function r6part(name, size, color)
		local piece = Instance.new("Part")
		piece.Name = name
		piece.Size = size
		piece.Color = color
		piece.Material = Enum.Material.SmoothPlastic
		piece.TopSurface = Enum.SurfaceType.Smooth
		piece.BottomSurface = Enum.SurfaceType.Smooth
		piece.CanCollide = false
		piece.Massless = name ~= "HumanoidRootPart"
		piece.Parent = model
		return piece
	end
	local function r6motor(name, part0, part1, c0, c1)
		local motor = Instance.new("Motor6D")
		motor.Name = name
		motor.Part0 = part0
		motor.Part1 = part1
		motor.C0 = c0
		motor.C1 = c1
		motor.Parent = part0
		return motor
	end
	local function stick(name, anchor, size, offset, color, shape)
		local piece = Instance.new("Part")
		piece.Name = name
		piece.Size = size
		piece.Color = color
		piece.Material = Enum.Material.SmoothPlastic
		piece.CanCollide = false
		piece.CanQuery = false
		piece.Massless = true
		if shape then
			piece.Shape = shape
		end
		piece.Parent = model
		local weld = Instance.new("Weld")
		weld.Part0 = anchor
		weld.Part1 = piece
		weld.C0 = offset
		weld.Parent = piece
		return piece
	end
	local root = r6part("HumanoidRootPart", Vector3.new(2, 2, 1), look.body)
	root.Transparency = 1
	local torso = r6part("Torso", Vector3.new(2, 2, 1), look.body)
	local head = r6part("Head", Vector3.new(2, 1, 1), look.skin)
	local leftArm = r6part("Left Arm", Vector3.new(1, 2, 1), look.cloth)
	local rightArm = r6part("Right Arm", Vector3.new(1, 2, 1), look.cloth)
	r6part("Left Leg", Vector3.new(1, 2, 1), look.cloth)
	r6part("Right Leg", Vector3.new(1, 2, 1), look.cloth)
	local spin = CFrame.Angles(math.rad(-90), 0, math.rad(180))
	r6motor("RootJoint", root, torso, spin, spin)
	r6motor("Neck", torso, head, CFrame.new(0, 1, 0) * spin, CFrame.new(0, -0.5, 0) * spin)
	r6motor("Left Shoulder", torso, leftArm, CFrame.new(-1, 0.5, 0) * CFrame.Angles(0, math.rad(-90), 0), CFrame.new(0.5, 0.5, 0) * CFrame.Angles(0, math.rad(-90), 0))
	r6motor("Right Shoulder", torso, rightArm, CFrame.new(1, 0.5, 0) * CFrame.Angles(0, math.rad(90), 0), CFrame.new(-0.5, 0.5, 0) * CFrame.Angles(0, math.rad(90), 0))
	r6motor("Left Hip", torso, model["Left Leg"], CFrame.new(-1, -1, 0) * CFrame.Angles(0, math.rad(-90), 0), CFrame.new(-0.5, 1, 0) * CFrame.Angles(0, math.rad(-90), 0))
	r6motor("Right Hip", torso, model["Right Leg"], CFrame.new(1, -1, 0) * CFrame.Angles(0, math.rad(90), 0), CFrame.new(0.5, 1, 0) * CFrame.Angles(0, math.rad(90), 0))
	if look.hat == "cap" then
		stick("Cap", head, Vector3.new(1.35, 0.32, 1.35), CFrame.new(0, 0.65, 0), look.cloth, Enum.PartType.Cylinder)
		stick("Brim", head, Vector3.new(1.4, 0.1, 0.5), CFrame.new(0, 0.48, -0.55), look.cloth)
	elseif look.hat == "band" then
		stick("Band", head, Vector3.new(1.2, 0.32, 0.22), CFrame.new(0, 0.1, -0.55), Color3.fromRGB(170, 42, 52))
		stick("Hood", torso, Vector3.new(1.35, 0.7, 1.25), CFrame.new(0, 1.15, 0.15), look.cloth)
	else
		stick("PadL", torso, Vector3.new(1.05, 0.45, 1.15), CFrame.new(-1.45, 0.75, 0), look.cloth)
		stick("PadR", torso, Vector3.new(1.05, 0.45, 1.15), CFrame.new(1.45, 0.75, 0), look.cloth)
		stick("Mask", head, Vector3.new(1.05, 0.42, 0.18), CFrame.new(0, 0, -0.58), Color3.fromRGB(16, 16, 16))
	end
	local humanoid = Instance.new("Humanoid")
	humanoid.RigType = Enum.HumanoidRigType.R6
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.AutomaticScalingEnabled = false
	humanoid.MaxHealth = 420
	humanoid.Health = 420
	humanoid.HipHeight = 2
	humanoid.Parent = model
	local animator = Instance.new("Animator")
	animator.Parent = humanoid
	model.PrimaryPart = root
	model.Parent = workspace
	local cf = pitCFrame(slot * 2 + 1)
	model:PivotTo(cf)
	local st = newState()
	st.fighter = "dummy"
	st.alive = true
	st.hp = 420
	st.maxHp = 420
	st.baseSpeed = 13
	st.level = 1
	st.slot = slot
	st.serial = serial
	st.ownerPlayer = nil
	dummyByModel[model] = st
	paint(model, look.body, look.name, st.hp, st.maxHp)
	local function keep(name, color)
		local piece = model:FindFirstChild(name)
		if piece and piece:IsA("BasePart") then
			piece.Color = color
		end
	end
	keep("Head", look.skin)
	keep("Left Arm", look.cloth)
	keep("Right Arm", look.cloth)
	keep("Left Leg", look.cloth)
	keep("Right Leg", look.cloth)
	keep("Cap", look.cloth)
	keep("Brim", look.cloth)
	keep("Band", Color3.fromRGB(150, 40, 48))
	keep("Mask", Color3.fromRGB(20, 20, 20))
	keep("PadL", look.cloth)
	keep("PadR", look.cloth)
	local function loadTrack(id, looped, priority)
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		local track = animator:LoadAnimation(anim)
		track.Looped = looped
		track.Priority = priority
		return track
	end
	dummyAnims[model] = {
		walk = loadTrack("rbxassetid://180426354", true, Enum.AnimationPriority.Movement),
		idle = loadTrack("rbxassetid://180435571", true, Enum.AnimationPriority.Idle),
		slash = loadTrack("rbxassetid://129967390", false, Enum.AnimationPriority.Action),
	}
	dummyAnims[model].idle:Play(0.2)
	plantGoon(model, root, humanoid)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.Ragdoll, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.FallingDown, false)
	humanoid:SetStateEnabled(Enum.HumanoidStateType.PlatformStanding, false)
end

local function spawnCreature()
	if creature then
		return
	end
	local model = Instance.new("Model")
	model.Name = "Хомяк"
	model:SetAttribute("Creature", true)
	local body = part({
		name = "Body",
		shape = Enum.PartType.Ball,
		size = Vector3.new(4.2, 3.4, 4.2),
		cf = CFrame.new(0, 3.2, 0),
		color = Color3.fromRGB(186, 132, 72),
		material = Enum.Material.SmoothPlastic,
		collide = false,
		parent = model,
	})
	local function ear(name, offset)
		local piece = part({
			name = name,
			shape = Enum.PartType.Ball,
			size = Vector3.new(1.1, 1.1, 1.1),
			cf = body.CFrame * CFrame.new(offset),
			color = Color3.fromRGB(214, 160, 130),
			material = Enum.Material.SmoothPlastic,
			anchored = false,
			collide = false,
			query = false,
			parent = model,
		})
		local weld = Instance.new("WeldConstraint")
		weld.Part0 = body
		weld.Part1 = piece
		weld.Parent = body
	end
	ear("EarL", Vector3.new(-1.1, 1.6, -0.4))
	ear("EarR", Vector3.new(1.1, 1.6, -0.4))
	model.PrimaryPart = body
	model.Parent = workspace
	local prompt = Instance.new("ProximityPrompt")
	prompt.ActionText = "Тапнуть"
	prompt.ObjectText = "Хомяк"
	prompt.HoldDuration = 0
	prompt.MaxActivationDistance = 10
	prompt.RequiresLineOfSight = false
	prompt.Parent = body
	prompt.Triggered:Connect(function(player)
		tapCreature(player)
	end)
	creature = model
end

local function tickChannel(player, st)
	local now = os.clock()
	local channel = st.channel
	if not channel then
		return
	end
	if now < channel.nextTick then
		return
	end
	if now >= channel.untilT or now < st.stunUntil then
		st.channel = nil
		return
	end
	channel.nextTick = now + 0.18
	local entry = entryOfPlayer(player)
	local root = entry and rootPart(entry.model)
	if not entry or not root then
		st.channel = nil
		return
	end
	local origin = root.Position + Vector3.new(0, 1.4, 0)
	local dest
	if channel.kind == "beam" then
		local near = nearestEnemy(entry, 36)
		local aimPos = near and posOfModel(near.model) or (origin + channel.dir * 36)
		local flat = Vector3.new(aimPos.X - origin.X, 0, aimPos.Z - origin.Z)
		if flat.Magnitude > 0.2 then
			channel.dir = flat.Unit
		end
		dest = origin + channel.dir * math.min(math.max(flat.Magnitude, 1), 36)
		beamVisual(origin, dest, Color3.fromRGB(120, 180, 255), 0.16)
	else
		dest = origin + channel.dir * 34
		beamVisual(origin, dest, Color3.fromRGB(120, 220, 160), 0.16)
	end
	face(entry, dest)
	for _, enemy in enemiesOf(entry) do
		local pos = posOfModel(enemy.model)
		if pos and distToSegment(pos, origin, dest) <= 3.3 then
			applyDamage(entry, enemy, (channel.kind == "beam" and 18 or 15) * channel.mul, "magic")
			if channel.kind == "hose" then
				push(enemy, channel.dir, 28)
			end
		end
	end
	local pet = creatureEntry()
	if pet and distToSegment(pet.model.PrimaryPart.Position, origin, dest) <= 4 then
		tapCreature(player)
	end
end

local function tickTurrets(now)
	for index = #turrets, 1, -1 do
		if phase ~= "fight" then
			break
		end
		local turret = turrets[index]
		if not turret then
			break
		end
		local owner = turret.owner
		if now >= turret.untilT or not owner.Parent or not turret.model.Parent then
			if turret.model then
				turret.model:Destroy()
			end
			table.remove(turrets, index)
		elseif now >= turret.nextTick and playersState[owner] then
			turret.nextTick = now + 0.8
			local entry = entryOfPlayer(owner)
			local originPart = turret.model.PrimaryPart
			if entry and originPart then
				local fake = {
					kind = "player",
					player = owner,
					state = playersState[owner],
					model = turret.model,
				}
				local target = nearestEnemy(fake, 28)
				if target and playersState[owner].alive then
					local hitPos = posOfModel(target.model)
					if hitPos then
						beamVisual(originPart.Position + Vector3.new(0, 1.5, 0), hitPos + Vector3.new(0, 1.2, 0), Color3.fromRGB(140, 230, 150), 0.12)
						applyDamage(entry, target, 16 * turret.mul, "magic")
					end
				end
			end
		end
	end
end

local function tickProjectiles(dt)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	for index = #projectiles, 1, -1 do
		if phase ~= "fight" then
			break
		end
		local shot = projectiles[index]
		if not shot then
			break
		end
		local step = shot.speed * dt
		local ownerModel = shot.owner and shot.owner.model
		params.FilterDescendantsInstances = { ownerModel, fxFolder }
		local hit = workspace:Raycast(shot.pos, shot.dir * step, params)
		local reach = step
		if hit then
			reach = hit.Distance
		end
		shot.pos += shot.dir * reach
		shot.left -= reach
		if shot.part then
			shot.part.CFrame = CFrame.lookAt(shot.pos, shot.pos + shot.dir)
		end
		local consumed = false
		if hit then
			local model = hit.Instance:FindFirstAncestorOfClass("Model")
			if model and model:GetAttribute("Creature") then
				if shot.owner and shot.owner.player then
					tapCreature(shot.owner.player)
				end
				consumed = true
			else
				local player = model and Players:GetPlayerFromCharacter(model)
				local st = player and playersState[player]
				if st and st.alive then
					applyDamage(shot.owner, { kind = "player", player = player, state = st, model = model }, shot.damage, "physical", { projectile = true })
					consumed = true
				end
				local dummyState = model and dummyByModel[model]
				if dummyState and dummyState.alive then
					applyDamage(shot.owner, { kind = "dummy", state = dummyState, model = model }, shot.damage, "physical", { projectile = true })
					consumed = true
				end
				if not consumed then
					consumed = true
				end
			end
		end
		if consumed or shot.left <= 0 or (shot.owner.player and not shot.owner.player.Parent) then
			if shot.part then
				shot.part:Destroy()
			end
			table.remove(projectiles, index)
		end
	end
end

local function tickDummies(now)
	for model, st in dummyByModel do
		local humanoid = model:FindFirstChildOfClass("Humanoid")
		local root = rootPart(model)
		if not humanoid or not root or not st.alive then
			continue
		end
		refreshBar(model, st.hp, st.maxHp)
		plantGoon(model, root, humanoid)
		local locked = now < st.stunUntil
		local velocity = root.AssemblyLinearVelocity
		local flatSpeed = Vector3.new(velocity.X, 0, velocity.Z).Magnitude
		local pack = dummyAnims[model]
		if pack then
			local moving = not locked and flatSpeed > 1.2
			if moving then
				if not pack.walk.IsPlaying then
					pack.walk:Play(0.15, 1, 1)
				end
				pack.walk:AdjustSpeed(math.clamp(flatSpeed / 11, 0.85, 1.55))
				if pack.idle.IsPlaying then
					pack.idle:Stop(0.15)
				end
			else
				if pack.walk.IsPlaying then
					pack.walk:Stop(0.18)
				end
				if not pack.idle.IsPlaying then
					pack.idle:Play(0.2)
				end
			end
		end
		humanoid.WalkSpeed = locked and 0 or speedOf(st, now)
		humanoid.JumpPower = 0
		humanoid.JumpHeight = 0
		if locked then
			continue
		end
		local nearest = nil
		local nearestDist = 500
		for _, player in Players:GetPlayers() do
			local pst = playersState[player]
			local proot = player.Character and rootPart(player.Character)
			if pst and pst.alive and proot then
				local dist = (proot.Position - root.Position).Magnitude
				if dist < nearestDist then
					nearest = player
					nearestDist = dist
				end
			end
		end
		if nearest and nearest.Character then
			humanoid:MoveTo(rootPart(nearest.Character).Position)
			if nearestDist <= 7 and now >= st.cd.attack then
				st.cd.attack = now + 1.15
				local target = entryOfPlayer(nearest)
				if target then
					local pack = dummyAnims[model]
					if pack and pack.slash then
						pack.slash:Play(0.04, 1, 1.25)
					end
					burstFx(root.Position, "slash", Color3.fromRGB(220, 80, 70))
					applyDamage({ kind = "dummy", state = st, model = model }, target, 18, "physical")
				end
				if phase ~= "fight" then
					break
				end
			end
		end
	end
end

local function applyBody(player, st)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	if not humanoid or not st.alive then
		if character and character:GetAttribute("YamaInvis") then
			character:SetAttribute("YamaInvis", nil)
		end
		local root = rootPart(character)
		local inPit = root and Vector3.new(root.Position.X, 0, root.Position.Z).Magnitude < 165
		local spectator = phase == "fight" and st and not st.alive and not st.pendingSpawn and humanoid and humanoid.Health > 0
		if inPit and (phase ~= "fight" or spectator) then
			teleport(character, lobbyCFrame(player.UserId))
		end
		return
	end
	local now = os.clock()
	if st.shield > 0 and now >= st.shieldUntil then
		st.shield = 0
	end
	if st.rooted and now >= st.rootUntil then
		st.rooted = false
	end
	if st.whistleAt > 0 and now >= st.whistleAt then
		st.whistleAt = 0
		st.invisibleUntil = now + 3
	end
	local hidden = now < st.invisibleUntil
	if character:GetAttribute("YamaInvis") ~= (hidden or nil) then
		character:SetAttribute("YamaInvis", hidden or nil)
	end
	if now >= st.reflectUntil then
		local old = character:FindFirstChild("ReflectLight")
		if old then
			old:Destroy()
		end
	elseif not character:FindFirstChild("ReflectLight") then
		local light = Instance.new("Highlight")
		light.Name = "ReflectLight"
		light.FillColor = Color3.fromRGB(255, 220, 90)
		light.FillTransparency = 0.55
		light.Parent = character
	end
	if now >= st.immuneUntil then
		local old = character:FindFirstChild("JacketLight")
		if old then
			old:Destroy()
		end
	elseif not character:FindFirstChild("JacketLight") then
		local light = Instance.new("Highlight")
		light.Name = "JacketLight"
		light.FillColor = Color3.fromRGB(220, 230, 255)
		light.FillTransparency = 0.6
		light.Parent = character
	end
	humanoid.MaxHealth = math.max(st.maxHp, 1)
	humanoid.Health = math.max(st.hp, 1)
	humanoid.WalkSpeed = speedOf(st, now)
	humanoid.UseJumpPower = true
	humanoid.JumpPower = speedOf(st, now) <= 0 and 0 or 50
	humanoid.AutoRotate = not st.channel
	refreshBar(character, st.hp, st.maxHp)
end

local function snapshot(player)
	local st = playersState[player]
	local now = os.clock()
	local function remain(t)
		return math.max(0, (t or 0) - now)
	end
	local you = nil
	if st then
		local root = player.Character and rootPart(player.Character)
		you = {
			fighter = st.fighter,
			hp = math.floor(st.hp),
			maxHp = st.maxHp,
			mana = math.floor(st.mana),
			maxMana = st.maxMana,
			gold = st.gold,
			kills = st.kills,
			deaths = st.deaths,
			level = st.level,
			xp = st.xp,
			nextXp = LEVEL_XP[st.level + 1] or st.xp,
			cd = {
				q = remain(st.cd.q),
				e = remain(st.cd.e),
				r = remain(st.cd.r),
				jacket = remain(st.cd.jacket),
				whistle = remain(st.cd.whistle),
				energy = remain(st.cd.energy),
			},
			lockE = st.level < 2,
			lockR = st.level < 4,
			items = {
				baton = st.items.baton == true,
				jacket = st.items.jacket == true,
				whistle = st.items.whistle == true,
				energy = st.items.energy == true,
			},
			shield = math.floor(st.shield),
			rooted = st.rooted,
			nearShop = root ~= nil and (root.Position - shopPos).Magnitude <= 16,
			swapLeft = math.max(0, (st.swapAt or 0) - now),
			streak = st.streak or 0,
		}
	end
	local board = {}
	for _, other in Players:GetPlayers() do
		local ost = playersState[other]
		if ost and ost.fighter and FIGHTERS[ost.fighter] then
			table.insert(board, {
				name = other.DisplayName,
				kills = ost.kills,
				fighter = FIGHTERS[ost.fighter].name,
			})
		end
	end
	table.sort(board, function(a, b)
		if a.kills == b.kills then
			return a.name < b.name
		end
		return a.kills > b.kills
	end)
	return {
		phase = phase,
		timeLeft = timeLeft(),
		status = statusLine(),
		you = you,
		board = board,
	}
end

local function pushAll()
	for _, player in Players:GetPlayers() do
		stateRemote:FireClient(player, snapshot(player))
	end
end

local function setupCharacter(player, character)
	local root = character:WaitForChild("HumanoidRootPart", 5)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not root or not humanoid or not character.Parent then
		return
	end
	local st = playersState[player]
	if not st then
		st = newState()
		playersState[player] = st
	end
	st.ownerPlayer = player
	humanoid.BreakJointsOnDeath = true
	humanoid.HealthDisplayType = Enum.HumanoidHealthDisplayType.AlwaysOff
	humanoid.DisplayDistanceType = Enum.HumanoidDisplayDistanceType.None
	if phase == "fight" and st.fighter and (st.pendingSpawn or st.alive) then
		st.pendingSpawn = false
		st.alive = true
		if st.hp <= 0 then
			st.hp = st.maxHp
		end
		clearControl(st)
		st.hp = st.maxHp
		st.mana = st.maxMana
		teleport(character, pitCFrame(player.UserId))
	else
		st.alive = false
		teleport(character, lobbyCFrame(player.UserId))
	end
	if st.fighter and FIGHTERS[st.fighter] then
		local info = FIGHTERS[st.fighter]
		st.baseSpeed = info.speed
		if st.hp > st.maxHp then
			st.hp = st.maxHp
		end
		paint(character, info.color, info.name, st.hp, st.maxHp, st.fighter)
	end
	humanoid.Died:Connect(function()
		if playersState[player] ~= st then
			return
		end
		if st.alive then
			st.deaths += 1
		end
		st.alive = false
		st.channel = nil
		if phase == "fight" and st.fighter then
			st.pendingSpawn = true
		end
	end)
end

local function hookPlayer(player)
	playersState[player] = newState()
	player.CharacterAdded:Connect(function(character)
		task.defer(function()
			setupCharacter(player, character)
		end)
	end)
	if player.Character then
		task.defer(function()
			setupCharacter(player, player.Character)
		end)
	end
end

pickRemote.OnServerEvent:Connect(function(player, fighterId)
	if typeof(fighterId) ~= "string" or not FIGHTERS[fighterId] or phase == "ending" then
		return
	end
	local st = playersState[player]
	if not st then
		return
	end
	local now = os.clock()
	if st.fighter and now < (st.swapAt or 0) then
		return
	end
	local info = FIGHTERS[fighterId]
	local levels = math.max(0, (st.level or 1) - 1)
	st.fighter = fighterId
	st.ownerPlayer = player
	st.maxHp = info.hp + levels * 40
	st.hp = st.maxHp
	st.maxMana = 100 + levels * 10
	st.mana = st.maxMana
	st.baseSpeed = info.speed
	st.swapAt = now + SWAP_WAIT
	clearControl(st)
	if phase == "lobby" then
		startFight()
	elseif phase == "fight" then
		st.alive = true
		st.pendingSpawn = false
		local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
		if player.Character and rootPart(player.Character) and humanoid and humanoid.Health > 0 then
			paint(player.Character, info.color, info.name, st.hp, st.maxHp, fighterId)
		else
			st.pendingSpawn = true
			player:LoadCharacter()
		end
	end
	stateRemote:FireClient(player, snapshot(player))
end)

actionRemote.OnServerEvent:Connect(function(player, action, aim)
	onAction(player, action, aim)
end)

Players.PlayerAdded:Connect(hookPlayer)
for _, player in Players:GetPlayers() do
	hookPlayer(player)
end

Players.PlayerRemoving:Connect(function(player)
	playersState[player] = nil
	creatureCd[player] = nil
	clearOwned(turrets, player)
	for index = #projectiles, 1, -1 do
		local shot = projectiles[index]
		if shot.owner and shot.owner.player == player then
			if shot.part then
				shot.part:Destroy()
			end
			table.remove(projectiles, index)
		end
	end
end)

buildWorld()

RunService.Heartbeat:Connect(function(dt)
	local now = os.clock()
	dt = math.min(dt, 0.1)
	if phase == "countdown" and now >= countdownEnd then
		startFight()
	end
	if phase == "fight" then
		if now >= matchEnd then
			endMatch()
		elseif not creature and now >= creatureTime then
			spawnCreature()
		end
		for _, player in Players:GetPlayers() do
			local st = playersState[player]
			if st and st.alive and st.fighter then
				st.hp = math.min(st.maxHp, st.hp + 3 * dt)
				st.mana = math.min(st.maxMana, st.mana + 8 * dt)
				st.xpTick += dt
				if st.xpTick >= 1 then
					st.xpTick -= 1
					grantXp(st, 8)
				end
				if st.channel then
					tickChannel(player, st)
				end
			end
			if st then
				applyBody(player, st)
			end
		end
		if creature and creature.PrimaryPart then
			local bob = 3.1 + math.sin(now * 3) * 0.35
			creature.PrimaryPart.CFrame = CFrame.new(0, bob, 0)
		end
		for _, crown in crowns do
			if crown.model.Parent then
				local sway = math.sin(now * 1.25 + crown.seed) * 0.045
				crown.model:PivotTo(crown.base * CFrame.Angles(sway, 0, sway * 0.65))
			end
		end
		local spring = Vector3.new(-88, 0, 62)
		for _, player in Players:GetPlayers() do
			local st = playersState[player]
			local root = st and player.Character and rootPart(player.Character)
			if st and st.alive and root then
				local flat = Vector3.new(root.Position.X, 0, root.Position.Z)
				if (flat - spring).Magnitude < 22 then
					st.hp = math.min(st.maxHp, st.hp + 9 * dt)
					st.slowUntil = math.max(st.slowUntil, now + 0.3)
				end
			end
		end
		for index = #puddles, 1, -1 do
			local puddle = puddles[index]
			if now >= puddle.untilT then
				table.remove(puddles, index)
			else
				local ownerState = playersState[puddle.owner]
				if ownerState then
					local fake = { kind = "player", player = puddle.owner, state = ownerState, model = puddle.owner.Character }
					for _, enemy in enemiesOf(fake) do
						local pos = posOfModel(enemy.model)
						if enemy.state and pos and (Vector3.new(pos.X, 0, pos.Z) - Vector3.new(puddle.pos.X, 0, puddle.pos.Z)).Magnitude <= 9 then
							enemy.state.slowUntil = math.max(enemy.state.slowUntil, now + 0.35)
						end
					end
				end
			end
		end
		tickTurrets(now)
		tickProjectiles(dt)
		tickDummies(now)
	else
		for _, player in Players:GetPlayers() do
			local st = playersState[player]
			if st then
				applyBody(player, st)
			end
		end
	end
	pushStamp += dt
	if pushStamp >= 0.15 then
		pushStamp = 0
		pushAll()
	end
end)
]]></ProtectedString>
        <bool name="Disabled">false</bool>
      </Properties>
    </Item>
  </Item>
  <Item class="StarterPlayer" referent="4">
    <Properties>
      <string name="Name">StarterPlayer</string>
      <token name="DevComputerMovementMode">1</token>
    </Properties>
    <Item class="StarterPlayerScripts" referent="5">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
    <Item class="LocalScript" referent="6">
      <Properties>
        <string name="Name">YamaClient</string>
        <ProtectedString name="Source"><![CDATA[-- Парк. LocalScript в StarterPlayerScripts. Шифтлок, камера и интерфейс.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local pickRemote = ReplicatedStorage:WaitForChild("YamaPick")
local actionRemote = ReplicatedStorage:WaitForChild("YamaAction")
local stateRemote = ReplicatedStorage:WaitForChild("YamaState")
local fxRemote = ReplicatedStorage:WaitForChild("YamaFx")
local TweenService = game:GetService("TweenService")

local INK = Color3.fromRGB(236, 232, 214)
local PANEL = Color3.fromRGB(16, 24, 18)
local MOSS = Color3.fromRGB(88, 140, 74)
local PAPER = Color3.fromRGB(248, 244, 232)
local GOLD = Color3.fromRGB(224, 176, 78)
local MUTED = Color3.fromRGB(176, 186, 162)

local CHOICES = {
	{ id = "dictor", name = "Диктор", line = "Луч тишины, круг вязкости, три вспышки", color = Color3.fromRGB(86, 148, 204) },
	{ id = "tumba", name = "Тумба", line = "Пень с шипами, толчок, баш лечит", color = Color3.fromRGB(196, 122, 72) },
	{ id = "otrazhatel", name = "Отражатель", line = "Окно «опа», рывок, чистка", color = Color3.fromRGB(214, 176, 72) },
	{ id = "dvornik", name = "Дворник", line = "Кадка, лужа, шланг", color = Color3.fromRGB(78, 158, 96) },
}

local KEYS = {
	[Enum.KeyCode.Q] = "q",
	[Enum.KeyCode.E] = "e",
	[Enum.KeyCode.R] = "r",
	[Enum.KeyCode.One] = "jacket",
	[Enum.KeyCode.Two] = "whistle",
	[Enum.KeyCode.Three] = "energy",
	[Enum.KeyCode.F] = "tap",
}

local NAMES = {
	dictor = { "Реплика", "Пауза", "Эфир" },
	tumba = { "Пень", "Толчок", "Баш" },
	otrazhatel = { "Опа", "Зеркало", "Чисто" },
	dvornik = { "Кадка", "Лужа", "Шланг" },
}
local BLURB = {
	dictor = { "луч тишины", "вязкость вокруг", "три вспышки" },
	tumba = { "щит и шипы", "толчок врагов", "удар лечит" },
	otrazhatel = { "окно отражения", "рывок", "снять контроль" },
	dvornik = { "кадка вперёд", "лечение и лужа", "струя" },
}
local MARK = {
	dictor = "Д",
	tumba = "Т",
	otrazhatel = "О",
	dvornik = "Дв",
}
local DISPLAY = {
	dictor = "Диктор",
	tumba = "Тумба",
	otrazhatel = "Отражатель",
	dvornik = "Дворник",
}
local FIGHTER_COLOR = {}
for _, choice in CHOICES do
	FIGHTER_COLOR[choice.id] = choice.color
end

local swapOpen = true
local lastPacket = nil

local gui = Instance.new("ScreenGui")
gui.Name = "Yama"
gui.ResetOnSpawn = false
gui.IgnoreGuiInset = true
gui.Parent = player:WaitForChild("PlayerGui")
task.defer(function()
	pcall(function()
		game:GetService("StarterGui"):SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
	end)
end)

local function corner(parent, radius)
	local ui = Instance.new("UICorner")
	ui.CornerRadius = UDim.new(0, radius or 12)
	ui.Parent = parent
end

local function stroke(parent, color, thickness)
	local line = Instance.new("UIStroke")
	line.Color = color or MOSS
	line.Thickness = thickness or 1
	line.ApplyStrokeMode = Enum.ApplyStrokeMode.Border
	line.Parent = parent
	return line
end

local function label(parent, size, pos, text, fontSize)
	local item = Instance.new("TextLabel")
	item.BackgroundTransparency = 1
	item.Size = size
	item.Position = pos
	item.Font = Enum.Font.Gotham
	item.TextSize = fontSize or 14
	item.TextXAlignment = Enum.TextXAlignment.Left
	item.TextColor3 = INK
	item.Text = text or ""
	item.Parent = parent
	return item
end

local function panel(size, pos)
	local frame = Instance.new("Frame")
	frame.Size = size
	frame.Position = pos
	frame.BackgroundColor3 = Color3.fromRGB(14, 18, 16)
	frame.BackgroundTransparency = 0.06
	frame.BorderSizePixel = 0
	frame.Parent = gui
	corner(frame, 18)
	stroke(frame, Color3.fromRGB(214, 186, 112), 1.5)
	local wash = Instance.new("UIGradient")
	wash.Color = ColorSequence.new(Color3.fromRGB(36, 42, 32), Color3.fromRGB(12, 16, 12))
	wash.Rotation = 90
	wash.Parent = frame
	return frame
end

local function bounce(object)
	if not object then
		return
	end
	local scale = object:FindFirstChild("Pop")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "Pop"
		scale.Parent = object
	end
	scale.Scale = 0.9
	TweenService:Create(scale, TweenInfo.new(0.18, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1 }):Play()
end

local function hover(object)
	local scale = object:FindFirstChild("Pop")
	if not scale then
		scale = Instance.new("UIScale")
		scale.Name = "Pop"
		scale.Parent = object
	end
	object.MouseEnter:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1.05 }):Play()
	end)
	object.MouseLeave:Connect(function()
		TweenService:Create(scale, TweenInfo.new(0.12, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), { Scale = 1 }):Play()
	end)
	if object:IsA("GuiButton") then
		object.MouseButton1Down:Connect(function()
			scale.Scale = 0.9
		end)
		object.MouseButton1Up:Connect(function()
			TweenService:Create(scale, TweenInfo.new(0.16, Enum.EasingStyle.Back, Enum.EasingDirection.Out), { Scale = 1.04 }):Play()
		end)
	end
end

local banner = panel(UDim2.fromOffset(520, 78), UDim2.new(0.5, -260, 0, 14))
local bannerBar = Instance.new("Frame")
bannerBar.Size = UDim2.new(1, 0, 0, 4)
bannerBar.BackgroundColor3 = GOLD
bannerBar.BorderSizePixel = 0
bannerBar.Parent = banner
corner(bannerBar, 2)
local status = label(banner, UDim2.new(1, -36, 0, 20), UDim2.fromOffset(18, 12), "Выбери бойца", 15)
status.Font = Enum.Font.GothamBold
status.TextXAlignment = Enum.TextXAlignment.Center
local timer = label(banner, UDim2.new(1, -36, 0, 34), UDim2.fromOffset(18, 34), "", 30)
timer.Font = Enum.Font.GothamBlack
timer.TextXAlignment = Enum.TextXAlignment.Center
timer.TextColor3 = GOLD

local card = panel(UDim2.fromOffset(268, 252), UDim2.fromOffset(16, 108))
card.ClipsDescendants = true
local portrait = Instance.new("Frame")
portrait.Size = UDim2.new(1, 0, 0, 72)
portrait.BackgroundColor3 = MOSS
portrait.BorderSizePixel = 0
portrait.Parent = card
corner(portrait, 18)
local accent = Instance.new("Frame")
accent.Size = UDim2.new(1, 0, 0, 3)
accent.Position = UDim2.fromOffset(0, 72)
accent.BackgroundColor3 = GOLD
accent.BorderSizePixel = 0
accent.Parent = card
local mark = label(portrait, UDim2.fromOffset(44, 44), UDim2.fromOffset(14, 14), "?", 22)
mark.Font = Enum.Font.GothamBlack
mark.TextXAlignment = Enum.TextXAlignment.Center
mark.BackgroundColor3 = Color3.fromRGB(12, 16, 12)
