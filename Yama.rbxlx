	corner(box, 8)
	local key = label(box, UDim2.new(1, -8, 0, 18), UDim2.fromOffset(6, 4), keyName, 12)
	key.TextColor3 = Color3.fromRGB(180, 180, 190)
	local title = label(box, UDim2.new(1, -8, 0, 18), UDim2.fromOffset(6, 22), titleText, 16)
	title.Font = Enum.Font.GothamBold
	local cd = label(box, UDim2.new(1, -8, 0, 16), UDim2.fromOffset(6, 42), "", 13)
	cd.TextColor3 = Color3.fromRGB(255, 200, 120)
	return { frame = box, title = title, cd = cd }
end

