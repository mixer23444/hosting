swapButton.MouseButton1Click:Connect(function()
	local you = lastPacket and lastPacket.you
	local picked = you and you.fighter
	local ready = not picked or (you.swapLeft or 0) <= 0
	if not ready then
		return
	end
	if not picked then
		swapOpen = true
	else
		swapOpen = not swapOpen
	end
	picker.Visible = swapOpen
	dock.Visible = not picker.Visible
end)

local function fmtTime(seconds)
	seconds = math.max(0, math.floor(seconds + 0.5))
	return string.format("%d:%02d", math.floor(seconds / 60), seconds % 60)
end

local function ratio(value, maxValue)
	if not maxValue or maxValue <= 0 then
		return 0
	end
	return math.clamp(value / maxValue, 0, 1)
end

local function paintBox(box, titleText, seconds, locked, lockLabel)
	box.title.Text = titleText
	local cooling = seconds and seconds > 0.05
	if box.veil then
		box.veil.Visible = locked or cooling
	end
	if locked then
		box.cd.Text = lockLabel
		box.cd.TextColor3 = MUTED
		box.frame.BackgroundColor3 = Color3.fromRGB(28, 30, 26)
	elseif cooling then
		box.cd.Text = string.format("%d сек", math.ceil(seconds))
		box.cd.TextColor3 = GOLD
		box.frame.BackgroundColor3 = Color3.fromRGB(42, 34, 22)
	else
		box.cd.Text = "готово"
		box.cd.TextColor3 = Color3.fromRGB(166, 214, 132)
		box.frame.BackgroundColor3 = Color3.fromRGB(24, 40, 28)
	end
end

local function paintSlot(slot, owned, seconds)
	if not owned then
		slot.state.Text = "нет"
		slot.state.TextColor3 = MUTED
		slot.frame.BackgroundColor3 = Color3.fromRGB(26, 30, 26)
		return
	end
	if seconds and seconds > 0.05 then
		slot.state.Text = string.format("%d c", math.ceil(seconds))
		slot.state.TextColor3 = GOLD
		slot.frame.BackgroundColor3 = Color3.fromRGB(48, 40, 28)
	else
		slot.state.Text = "готово"
		slot.state.TextColor3 = Color3.fromRGB(154, 204, 132)
		slot.frame.BackgroundColor3 = Color3.fromRGB(28, 42, 30)
	end
end

local function applyState(packet)
	if typeof(packet) ~= "table" then
		return
	end
	lastPacket = packet
	status.Text = packet.status or ""
	if packet.phase == "fight" then
		timer.Text = fmtTime(packet.timeLeft or 0)
	else
		timer.Text = packet.phase == "ending" and "конец" or "парк открыт"
	end
	local you = packet.you
	local picked = you and you.fighter
	local ready = not picked or (you.swapLeft or 0) <= 0
	if not picked then
		swapOpen = true
	end
	if packet.phase == "ending" then
		swapOpen = false
	end
	picker.Visible = swapOpen and packet.phase ~= "ending" and ready
	dock.Visible = not picker.Visible
	if not picked then
		swapButton.Text = "Выбери бойца"
		swapButton.BackgroundColor3 = MOSS
	elseif ready then
		swapButton.Text = "Сменить бойца"
		swapButton.BackgroundColor3 = MOSS
	else
		swapButton.Text = "Смена  " .. fmtTime(you.swapLeft or 0)
		swapButton.BackgroundColor3 = Color3.fromRGB(48, 56, 44)
	end
	if you and picked then
		nameLabel.Text = DISPLAY[you.fighter] or you.fighter
		mark.Text = MARK[you.fighter] or "?"
		portrait.BackgroundColor3 = FIGHTER_COLOR[you.fighter] or MOSS
		accent.BackgroundColor3 = FIGHTER_COLOR[you.fighter] or MOSS
		local nextXp = you.nextXp or you.xp
		if you.level >= 6 then
			levelLabel.Text = "уровень 6"
			xpFill.Size = UDim2.fromScale(1, 1)
		else
			levelLabel.Text = string.format("уровень %d     %d / %d", you.level, you.xp, nextXp)
			xpFill.Size = UDim2.fromScale(ratio(you.xp, nextXp), 1)
		end
		hpFill.Size = UDim2.fromScale(ratio(you.hp, you.maxHp), 1)
		manaFill.Size = UDim2.fromScale(ratio(you.mana, you.maxMana), 1)
		hpText.Text = string.format("жизнь  %d / %d", you.hp or 0, you.maxHp or 0)
		manaText.Text = string.format("мана  %d / %d", you.mana or 0, you.maxMana or 0)
		local extra = ""
		if you.shield and you.shield > 0 then
			extra ..= "щит " .. you.shield
		end
		if you.rooted then
			extra ..= (extra ~= "" and "   " or "") .. "врос"
		end
		if you.streak and you.streak > 0 then
			extra ..= (extra ~= "" and "   " or "") .. "серия " .. you.streak
		end
		if you.items and you.items.baton then
			extra ..= (extra ~= "" and "   " or "") .. "батон"
		end
		stateLabel.Text = extra
		goldLabel.Text = tostring(you.gold) .. " золота"
		killLabel.Text = tostring(you.kills) .. " убийств     смертей " .. tostring(you.deaths)
		local names = NAMES[you.fighter] or { "Q", "E", "R" }
		local blurbs = BLURB[you.fighter] or { "", "", "" }
		paintBox(boxes.q, names[1], you.cd.q, false, "")
		paintBox(boxes.e, names[2], you.cd.e, you.lockE, "со 2 уровня")
		paintBox(boxes.r, names[3], you.cd.r, you.lockR, "с 4 уровня")
		boxes.q.hint.Text = blurbs[1]
		boxes.e.hint.Text = blurbs[2]
		boxes.r.hint.Text = blurbs[3]
		paintSlot(slots.jacket, you.items and you.items.jacket, you.cd.jacket)
		paintSlot(slots.whistle, you.items and you.items.whistle, you.cd.whistle)
		paintSlot(slots.energy, you.items and you.items.energy, you.cd.energy)
		slots.tap.state.Text = "жми"
		slots.tap.state.TextColor3 = GOLD
		shop.Visible = you.nearShop == true and packet.phase == "fight" and not picker.Visible
		for id, widget in shopButtons do
			local owned = you.items and you.items[id]
			widget.price.Text = owned and "есть" or widget.price.Text
			if not owned then
				for _, spec in shopItems do
					if spec.id == id then
						widget.price.Text = spec.price
					end
				end
			end
			widget.button.AutoButtonColor = not owned
			widget.button.BackgroundColor3 = owned and Color3.fromRGB(48, 56, 46) or Color3.fromRGB(36, 52, 34)
		end
	else
		nameLabel.Text = "Боец не выбран"
		mark.Text = "?"
		portrait.BackgroundColor3 = MOSS
		accent.BackgroundColor3 = MOSS
		levelLabel.Text = "выбери карточку"
		goldLabel.Text = ""
		killLabel.Text = ""
		stateLabel.Text = ""
		hpText.Text = "жизнь"
		manaText.Text = "мана"
		hpFill.Size = UDim2.fromScale(0, 1)
		manaFill.Size = UDim2.fromScale(0, 1)
		xpFill.Size = UDim2.fromScale(0, 1)
		shop.Visible = false
	end
	for index = 1, 8 do
		local row = packet.board and packet.board[index]
		local line = boardRows[index]
		local chip = boardChips[index]
		if row then
			chip.Visible = true
			line.Text = string.format("%d    %s    %s", row.kills or 0, row.fighter or "", row.name or "")
			line.TextColor3 = (row.name == player.DisplayName) and GOLD or INK
			chip.BackgroundColor3 = (row.name == player.DisplayName) and Color3.fromRGB(58, 48, 24) or Color3.fromRGB(32, 40, 30)
		else
			chip.Visible = false
			line.Text = ""
		end
	end
end

local function aimPoint()
	local camera = workspace.CurrentCamera
	local viewport = camera.ViewportSize
	local ray = camera:ViewportPointToRay(viewport.X / 2, viewport.Y / 2)
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { player.Character, workspace:FindFirstChild("YamaFx") }
	local hit = workspace:Raycast(ray.Origin, ray.Direction * 300, params)
	if hit then
		return hit.Position
	end
	return ray.Origin + ray.Direction * 80
end

local function bindCamera(character)
	local humanoid = character:WaitForChild("Humanoid", 5)
	if not humanoid then
		return
	end
	humanoid.CameraOffset = Vector3.new(1.75, 0.35, 0)
	humanoid.AutoRotate = false
	player.CameraMinZoomDistance = 10
	player.CameraMaxZoomDistance = 16
	local camera = workspace.CurrentCamera
	camera.CameraSubject = humanoid
	camera.CameraType = Enum.CameraType.Custom
end

player.CharacterAdded:Connect(function(character)
	task.defer(function()
		bindCamera(character)
	end)
end)
if player.Character then
	task.defer(function()
		bindCamera(player.Character)
	end)
end

UserInputService.InputBegan:Connect(function(input, processed)
	if processed then
		return
	end
	local action = nil
	if input.UserInputType == Enum.UserInputType.MouseButton1 then
		action = "attack"
	else
		action = KEYS[input.KeyCode]
	end
	if action then
		local widget = boxes[action] or slots[action]
		if widget then
			bounce(widget.frame)
		end
		actionRemote:FireServer(action, aimPoint())
	end
end)

local CAST_ANIM = {
	slash = "rbxassetid://522635514",
	lunge = "rbxassetid://522638767",
	point = "rbxassetid://507770453",
	cheer = "rbxassetid://507770677",
	wave = "rbxassetid://507770239",
}
local castTracks = setmetatable({}, { __mode = "k" })
local shakeLeft = 0

local function playCastAnim(model, kind)
	if not model or not model:FindFirstChild("UpperTorso") then
		return
	end
	local humanoid = model:FindFirstChildOfClass("Humanoid")
	local root = model:FindFirstChild("HumanoidRootPart")
	if not humanoid or not root then
		return
	end
	local animator = humanoid:FindFirstChildOfClass("Animator")
	if not animator then
		animator = Instance.new("Animator")
		animator.Parent = humanoid
	end
	local id = CAST_ANIM[kind] or CAST_ANIM.slash
	castTracks[humanoid] = castTracks[humanoid] or {}
	local track = castTracks[humanoid][id]
	if not track then
		local anim = Instance.new("Animation")
		anim.AnimationId = id
		track = animator:LoadAnimation(anim)
		track.Looped = false
		track.Priority = Enum.AnimationPriority.Action
		castTracks[humanoid][id] = track
	end
	track:Play(0.05, 1, 1.3)
	if model ~= player.Character then
		return
	end
	local pos = root.Position
	local untilAt = os.clock() + 0.42
	task.spawn(function()
		while root.Parent and os.clock() < untilAt do
			local dt = task.wait()
			local move = humanoid.MoveDirection
			pos += move * humanoid.WalkSpeed * dt
			local y = root.Position.Y
			local look = root.CFrame.LookVector
			local flat = Vector3.new(look.X, 0, look.Z)
			if flat.Magnitude < 0.05 then
				flat = Vector3.new(0, 0, -1)
			end
			local vel = root.AssemblyLinearVelocity
			root.CFrame = CFrame.lookAt(Vector3.new(pos.X, y, pos.Z), Vector3.new(pos.X, y, pos.Z) + flat)
			root.AssemblyLinearVelocity = Vector3.new(move.X * humanoid.WalkSpeed, vel.Y, move.Z * humanoid.WalkSpeed)
		end
	end)
end

fxRemote.OnClientEvent:Connect(function(packet)
	if typeof(packet) ~= "table" then
		return
	end
	if packet.model and packet.model == player.Character then
		shakeLeft = math.max(shakeLeft, packet.shake or 0.12)
	elseif (packet.shake or 0) > 0.3 then
		shakeLeft = math.max(shakeLeft, (packet.shake or 0) * 0.35)
	end
	playCastAnim(packet.model, packet.anim)
end)

stateRemote.OnClientEvent:Connect(applyState)

RunService:BindToRenderStep("YamaShiftLock", Enum.RenderPriority.Camera.Value + 1, function()
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass("Humanoid")
	local root = character and character:FindFirstChild("HumanoidRootPart")
	local camera = workspace.CurrentCamera
	local menu = picker.Visible or shop.Visible
	local align = root and root:FindFirstChild("YamaAlign")
	if menu or not humanoid or not root or humanoid.Health <= 0 then
		UserInputService.MouseBehavior = Enum.MouseBehavior.Default
		UserInputService.MouseIconEnabled = true
		cross.Visible = false
		if align then
			align.Enabled = false
		end
		if humanoid then
			humanoid.AutoRotate = true
		end
		return
	end
	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false
	humanoid.AutoRotate = false
	humanoid.CameraOffset = Vector3.new(1.75, 0.35, 0)
	cross.Visible = true
	if not align then
		local attachment = Instance.new("Attachment")
		attachment.Name = "YamaTurn"
		attachment.Parent = root
		align = Instance.new("AlignOrientation")
		align.Name = "YamaAlign"
		align.Mode = Enum.OrientationAlignmentMode.OneAttachment
		align.Attachment0 = attachment
		align.RigidityEnabled = false
		align.Responsiveness = 200
		align.MaxTorque = 100000
		align.Parent = root
	end
	local look = camera.CFrame.LookVector
	local flat = Vector3.new(look.X, 0, look.Z)
	if flat.Magnitude > 0.05 then
		align.Enabled = true
		align.CFrame = CFrame.lookAt(Vector3.zero, flat)
	end
	if shakeLeft > 0 then
		local step = math.min(shakeLeft, 0.05)
		shakeLeft = math.max(0, shakeLeft - step)
		local mag = shakeLeft * 0.55
		local t = os.clock()
		camera.CFrame = camera.CFrame * CFrame.new(math.noise(t * 24, 0, 0) * mag, math.noise(0, t * 24, 1) * mag, 0)
	end
end)

RunService.RenderStepped:Connect(function()
	for _, other in Players:GetPlayers() do
		local character = other.Character
		if character then
			local hidden = character:GetAttribute("YamaInvis") == true
			for _, piece in character:GetDescendants() do
				if piece:IsA("BasePart") then
					if hidden then
						piece.LocalTransparencyModifier = other == player and 0.55 or 1
					else
						piece.LocalTransparencyModifier = 0
					end
				end
			end
		end
	end
end)]]></ProtectedString>
      </Properties>
    </Item>
    </Item>
