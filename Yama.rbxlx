<roblox version="4">
  <Item class="Workspace" referent="0">
    <Properties>
      <string name="Name">Workspace</string>
    </Properties>
  </Item>
  <Item class="Lighting" referent="1">
    <Properties>
      <string name="Name">Lighting</string>
      <float name="ClockTime">13.5</float>
      <float name="GeographicLatitude">20</float>
      <token name="Technology">4</token>
    </Properties>
  </Item>
  <Item class="ServerScriptService" referent="2">
    <Properties>
      <string name="Name">ServerScriptService</string>
    </Properties>
    <Item class="Script" referent="3">
      <Properties>
        <string name="Name">Yama</string>
        <ProtectedString name="Source"><![CDATA[-- Яма. Отдельный плейс, без Rojo. Открой Yama.rbxlx в Studio и нажми Play.
-- Гараж этот скрипт не трогает. Бой считает сервер.

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local Lighting = game:GetService("Lighting")
local Debris = game:GetService("Debris")

Players.RespawnTime = 6
Players.CharacterAutoLoads = true

local MATCH_LEN = 480
local CREATURE_AT = 240
local SWAP_WAIT = 180
local WIN_KILLS = 20
local LEVEL_XP = { 0, 50, 120, 220, 360, 540 }

local FIGHTERS = {
	dictor = { name = "Диктор", color = Color3.fromRGB(92, 154, 230), hp = 860, speed = 17, ranged = true, basic = 26, reach = 8, cd = 0.42 },
	tumba = { name = "Тумба", color = Color3.fromRGB(198, 114, 66), hp = 1280, speed = 14, ranged = false, basic = 44, reach = 8, cd = 0.52 },
	otrazhatel = { name = "Отражатель", color = Color3.fromRGB(224, 198, 92), hp = 980, speed = 16, ranged = false, basic = 34, reach = 8, cd = 0.46 },
	dvornik = { name = "Дворник", color = Color3.fromRGB(86, 168, 112), hp = 1040, speed = 15, ranged = false, basic = 32, reach = 8, cd = 0.5 },
}

local ABILITIES = {
	dictor = { q = { 20, 8 }, e = { 15, 12 }, r = { 40, 18 } },
	tumba = { q = { 10, 11 }, e = { 15, 8 }, r = { 20, 10 } },
	otrazhatel = { q = { 15, 9 }, e = { 20, 7 }, r = { 25, 11 } },
	dvornik = { q = { 25, 7 }, e = { 20, 10 }, r = { 35, 14 } },
}

local ITEMS = {
	baton = { name = "Батон", price = 250 },
	jacket = { name = "Куртка", price = 500 },
	whistle = { name = "Свисток", price = 350 },
	energy = { name = "Энергетик", price = 200 },
}

local pickRemote = Instance.new("RemoteEvent")
pickRemote.Name = "YamaPick"
pickRemote.Parent = ReplicatedStorage
local actionRemote = Instance.new("RemoteEvent")
actionRemote.Name = "YamaAction"
actionRemote.Parent = ReplicatedStorage
local stateRemote = Instance.new("RemoteEvent")
stateRemote.Name = "YamaState"
stateRemote.Parent = ReplicatedStorage
local fxRemote = Instance.new("RemoteEvent")
fxRemote.Name = "YamaFx"
fxRemote.Parent = ReplicatedStorage

local mapFolder = Instance.new("Folder")
mapFolder.Name = "Park"
mapFolder.Parent = workspace
local fxFolder = Instance.new("Folder")
fxFolder.Name = "YamaFx"
fxFolder.Parent = workspace

local phase = "lobby"
local countdownEnd = 0
local matchEnd = 0
local creatureTime = 0
local winnerText = ""
local roundSerial = 0
local shopPos = Vector3.new(118, 3, 40)
local playersState = {}
local dummyByModel = {}
local dummyAnims = {}
local turrets = {}
local puddles = {}
local projectiles = {}
local creature = nil
local creatureCd = {}
local pushStamp = 0

local function part(props)
	local item = Instance.new(props.class or "Part")
	item.Name = props.name or "Part"
	item.Anchored = props.anchored ~= false
	item.CanCollide = props.collide ~= false
	item.CanQuery = props.query ~= false
	item.Size = props.size or Vector3.new(4, 1, 4)
	item.CFrame = props.cf or CFrame.new()
	item.Color = props.color or Color3.fromRGB(220, 220, 220)
	item.Material = props.material or Enum.Material.Concrete
	item.TopSurface = Enum.SurfaceType.Smooth
	item.BottomSurface = Enum.SurfaceType.Smooth
	item.Transparency = props.transparency or 0
	if props.shape then
		item.Shape = props.shape
	end
	item.Parent = props.parent or mapFolder
	return item
end

local crowns = {}

local function buildWorld()
	-- Парк собирается заново при каждом Play. Картинок нет: только материалы Studio.
	Lighting.ClockTime = 14
	Lighting.Brightness = 2.2
	Lighting.Ambient = Color3.fromRGB(150, 160, 148)
	Lighting.OutdoorAmbient = Color3.fromRGB(172, 182, 166)
	Lighting.EnvironmentDiffuseScale = 0.55
	Lighting.EnvironmentSpecularScale = 0.2
	Lighting.GlobalShadows = true
	Lighting.GeographicLatitude = 18
	Lighting.FogColor = Color3.fromRGB(198, 220, 214)
	Lighting.FogStart = 280
	Lighting.FogEnd = 640

	local oldSky = Lighting:FindFirstChildOfClass("Sky")
	if oldSky then
		oldSky:Destroy()
	end

	local atmo = Lighting:FindFirstChildOfClass("Atmosphere") or Instance.new("Atmosphere")
	atmo.Density = 0.26
	atmo.Offset = 0.25
	atmo.Color = Color3.fromRGB(206, 224, 220)
	atmo.Decay = Color3.fromRGB(196, 214, 206)
	atmo.Glare = 0.12
	atmo.Haze = 1.35
	atmo.Parent = Lighting

	local sun = Lighting:FindFirstChildOfClass("SunRaysEffect") or Instance.new("SunRaysEffect")
	sun.Intensity = 0.04
	sun.Spread = 0.55
	sun.Parent = Lighting

	local base = workspace:FindFirstChild("Baseplate")
	if base then
		base:Destroy()
	end

	local function folder(name)
		local item = Instance.new("Folder")
		item.Name = name
		item.Parent = mapFolder
		return item
	end

	local ground = folder("Ground")
	local paths = folder("Paths")
	local water = folder("Water")
	local trees = folder("Trees")
	local cover = folder("Cover")
	local props = folder("Props")
	local cliffs = folder("Cliffs")
	local lobby = folder("Lobby")
	local shopFolder = folder("Shop")

	local function disk(name, parent, diameter, thickness, topY, color, material)
		part({
			name = name,
			parent = parent,
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(thickness, diameter, diameter),
			cf = CFrame.new(0, topY - thickness / 2, 0) * CFrame.Angles(0, 0, math.rad(90)),
			color = color,
			material = material,
		})
	end

	disk("Meadow", ground, 980, 10, 1, Color3.fromRGB(118, 148, 74), Enum.Material.Grass)
	disk("Lawn", ground, 360, 0.7, 1.2, Color3.fromRGB(132, 168, 82), Enum.Material.Grass)
	disk("Clearing", ground, 46, 0.35, 1.42, Color3.fromRGB(214, 196, 148), Enum.Material.Sand)

	part({
		name = "PathEW",
		parent = paths,
		size = Vector3.new(300, 0.28, 12),
		cf = CFrame.new(0, 1.34, 0),
		color = Color3.fromRGB(164, 142, 108),
		material = Enum.Material.Cobblestone,
	})
	part({
		name = "PathNS",
		parent = paths,
		size = Vector3.new(12, 0.28, 300),
		cf = CFrame.new(0, 1.34, 0),
		color = Color3.fromRGB(156, 136, 104),
		material = Enum.Material.Cobblestone,
	})

	local pond = Vector3.new(-88, 0, 62)
	part({
		name = "Shore",
		parent = water,
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.4, 64, 64),
		cf = CFrame.new(pond.X, 1.32, pond.Z) * CFrame.Angles(0, 0, math.rad(90)),
		color = Color3.fromRGB(206, 186, 140),
		material = Enum.Material.Sand,
		collide = false,
		query = false,
	})
	part({
		name = "Pond",
		parent = water,
		shape = Enum.PartType.Cylinder,
		size = Vector3.new(0.5, 46, 46),
		cf = CFrame.new(pond.X, 1.42, pond.Z) * CFrame.Angles(0, 0, math.rad(90)),
		color = Color3.fromRGB(72, 142, 168),
		material = Enum.Material.Glass,
		transparency = 0.15,
		collide = false,
		query = false,
	})
	for n = 1, 8 do
		local angle = (n / 8) * math.pi * 2
		part({
			name = "Reed",
			parent = water,
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(3.2, 0.22, 0.22),
			cf = CFrame.new(pond.X + math.cos(angle) * 16, 2.6, pond.Z + math.sin(angle) * 16) * CFrame.Angles(0, 0, math.rad(90)),
			color = Color3.fromRGB(74, 128, 62),
			material = Enum.Material.Grass,
			collide = false,
			query = false,
		})
		part({
			name = "Pad",
			parent = water,
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(0.12, 2.2, 2.2),
			cf = CFrame.new(pond.X + math.cos(angle) * 8, 1.55, pond.Z + math.sin(angle) * 8) * CFrame.Angles(0, 0, math.rad(90)),
			color = Color3.fromRGB(58, 110, 54),
			material = Enum.Material.Grass,
			collide = false,
			query = false,
		})
	end
	local springSign = part({
		name = "SpringSign",
		parent = water,
		size = Vector3.new(0.3, 1.6, 2.4),
		cf = CFrame.lookAt(Vector3.new(pond.X + 18, 3.2, pond.Z), Vector3.new(0, 3.2, 0)),
		color = Color3.fromRGB(86, 118, 78),
		material = Enum.Material.Wood,
		collide = false,
	})
	local springGui = Instance.new("SurfaceGui")
	springGui.Face = Enum.NormalId.Front
	springGui.CanvasSize = Vector2.new(240, 120)
	springGui.LightInfluence = 0
	springGui.Parent = springSign
	local springText = Instance.new("TextLabel")
	springText.Size = UDim2.fromScale(1, 1)
	springText.BackgroundTransparency = 1
	springText.TextColor3 = Color3.fromRGB(236, 244, 220)
	springText.Font = Enum.Font.GothamBold
	springText.TextSize = 28
	springText.Text = "РОДНИК\nлечит и вяжет"
	springText.Parent = springGui

	local function blocked(x, z, radius)
		local flat = Vector3.new(x, 0, z)
		if (flat - pond).Magnitude < radius + 20 then
			return true
		end
		if (flat - Vector3.new(shopPos.X, 0, shopPos.Z)).Magnitude < radius + 14 then
			return true
		end
		if math.abs(x) < 10 or math.abs(z) < 10 then
			return true
		end
		return false
	end

	local function tree(x, z, scale)
		if blocked(x, z, 6) then
			return
		end
		local trunkH = 8 + scale * 1.4
		part({
			name = "Trunk",
			parent = trees,
			shape = Enum.PartType.Cylinder,
			size = Vector3.new(trunkH, 1.5 + scale * 0.08, 1.5 + scale * 0.08),
			cf = CFrame.new(x, 1.2 + trunkH / 2, z) * CFrame.Angles(0, 0, math.rad(90)),
			color = Color3.fromRGB(118, 82, 50),
			material = Enum.Material.Wood,
		})
		part({
			name = "Root",
			parent = trees,
			shape = Enum.PartType.Ball,
			size = Vector3.new(2.4, 1.1, 2.4),
			cf = CFrame.new(x, 1.5, z),
			color = Color3.fromRGB(102, 72, 44),
			material = Enum.Material.Wood,
			collide = false,
			query = false,
		})
		local crown = 1.2 + trunkH
		local greens = {
			Color3.fromRGB(46, 96, 44),
			Color3.fromRGB(70, 124, 58),
			Color3.fromRGB(98, 150, 68),
			Color3.fromRGB(58, 108, 50),
		}
		local crownModel = Instance.new("Model")
		crownModel.Name = "Crown"
		crownModel.Parent = trees
		local hub = part({
			name = "Hub",
			parent = crownModel,
			size = Vector3.new(0.2, 0.2, 0.2),
			cf = CFrame.new(x, crown + 1.1, z),
			transparency = 1,
			collide = false,
			query = false,
		})
		crownModel.PrimaryPart = hub
		part({
			name = "Canopy",
			parent = crownModel,
			shape = Enum.PartType.Ball,
			size = Vector3.new(6.2 + scale * 0.6, 4.4 + scale * 0.2, 6.2 + scale * 0.6),
			cf = CFrame.new(x, crown + 1.1, z),
			color = greens[1],
			material = Enum.Material.Grass,
			collide = false,
			query = false,
		})
		for i = 1, 6 do
			local yaw = (i / 6) * math.pi * 2 + scale * 0.35
			local ring = 2.1 + (i % 2) * 1.15
			local lift = ((i % 3) - 1) * 1.05
			part({
				name = "Leaf",
				parent = crownModel,
				shape = Enum.PartType.Ball,
				size = Vector3.new(3.1 + (i % 2) * 0.8, 2.2, 3.1 + (i % 2) * 0.8),
				cf = CFrame.new(x + math.cos(yaw) * ring, crown + 1.5 + lift, z + math.sin(yaw) * ring),
				color = greens[(i % #greens) + 1],
				material = Enum.Material.Grass,
				collide = false,
				query = false,
			})
		end
		for i = 1, 3 do
			local yaw = (i / 3) * math.pi * 2 + 0.4
			part({
				name = "LeafTip",
				parent = crownModel,
				class = "WedgePart",
				size = Vector3.new(1.3, 2.4, 2.8),
				cf = CFrame.new(x + math.cos(yaw) * 3.1, crown + 2.4, z + math.sin(yaw) * 3.1) * CFrame.Angles(0, -yaw, math.rad(78)),
				color = greens[(i % #greens) + 1],
				material = Enum.Material.Grass,
				collide = false,
				query = false,
			})
		end
		table.insert(crowns, { model = crownModel, base = hub.CFrame, seed = x * 0.17 + z * 0.11 })
	end

	for n = 1, 10 do
		local angle = (n / 10) * math.pi * 2 + 0.35
		tree(math.cos(angle) * 78, math.sin(angle) * 78, 2 + (n % 3))
	end
	for n = 1, 16 do
		local angle = (n / 16) * math.pi * 2 + 0.1
		local radius = 112 + (n % 3) * 12
		tree(math.cos(angle) * radius, math.sin(angle) * radius, 3 + (n % 4))
	end
	for n = 1, 20 do
		local angle = (n / 20) * math.pi * 2 + 0.22
		local radius = 152 + (n % 4) * 6
		tree(math.cos(angle) * radius, math.sin(angle) * radius, 2 + (n % 3))
	end

	for n = 1, 8 do
		local angle = (n / 8) * math.pi * 2 + 0.5
		local x = math.cos(angle) * 46
		local z = math.sin(angle) * 46
		if not blocked(x, z, 4) then
			local height = 4.2 + (n % 3) * 1.4
			part({
				name = "Boulder",
				parent = cover,
				shape = Enum.PartType.Ball,
				size = Vector3.new(6.5 + (n % 2) * 2, height, 6.2 + (n % 3)),
				cf = CFrame.new(x, 1.15 + height / 2, z),
				color = Color3.fromRGB(138, 134, 126),
				material = Enum.Material.Slate,
			})
			part({
				name = "BoulderSide",
				parent = cover,
				shape = Enum.PartType.Ball,
				size = Vector3.new(3.2, 2.4, 3.2),
				cf = CFrame.new(x + 2.4, 2.1, z + 1.2),
				color = Color3.fromRGB(168, 164, 154),
				material = Enum.Material.Slate,
			})
		end
	end

	for n = 1, 8 do
		local angle = (n / 8) * math.pi * 2
		local cf = CFrame.lookAt(Vector3.new(math.cos(angle) * 62, 1.6, math.sin(angle) * 62), Vector3.new(0, 1.6, 0))
		part({
			name = "Bench",
			parent = props,
			size = Vector3.new(5.2, 0.35, 1.4),
			cf = cf * CFrame.new(0, 0.55, 0),
			color = Color3.fromRGB(150, 104, 64),
			material = Enum.Material.WoodPlanks,
		})
		part({
			name = "BenchBack",
			parent = props,
			size = Vector3.new(5.2, 1.4, 0.28),
			cf = cf * CFrame.new(0, 1.25, 0.6),
			color = Color3.fromRGB(132, 90, 54),
			material = Enum.Material.Wood,
			collide = false,
		})
		for _, side in { -1.8, 1.8 } do
			part({
				name = "BenchLeg",
				parent = props,
				size = Vector3.new(0.28, 1.1, 0.28),
				cf = cf * CFrame.new(side, 0.05, 0.15),
				color = Color3.fromRGB(96, 66, 40),
				material = Enum.Material.Wood,
			})
		end
	end

	for n = 1, 24 do
		local angle = (n / 24) * math.pi * 2
		local pos = Vector3.new(math.cos(angle) * 176, 1.7, math.sin(angle) * 176)
		local cf = CFrame.lookAt(pos, Vector3.new(0, 1.7, 0))
		part({
			name = "Curb",
			parent = props,
			size = Vector3.new(18, 0.45, 1.1),
			cf = cf,
			color = Color3.fromRGB(150, 146, 138),
			material = Enum.Material.Slate,
		})
		if n % 4 == 0 then
			part({
				name = "Post",
				parent = props,
				size = Vector3.new(0.7, 6.4, 0.7),
				cf = cf * CFrame.new(0, 3.1, 0),
				color = Color3.fromRGB(92, 64, 40),
				material = Enum.Material.Wood,
			})
			local bulb = part({
				name = "Lantern",
				parent = props,
				shape = Enum.PartType.Ball,
				size = Vector3.new(1.6, 1.6, 1.6),
				cf = cf * CFrame.new(0, 5.4, 0),
				color = Color3.fromRGB(255, 196, 110),
				material = Enum.Material.Neon,
				collide = false,
				query = false,
			})
			local glow = Instance.new("PointLight")
			glow.Color = Color3.fromRGB(255, 196, 120)
			glow.Brightness = 1.8
			glow.Range = 22
			glow.Parent = bulb
		end
		if n % 3 == 0 then
			part({
				name = "Tuft",
				parent = props,
				size = Vector3.new(1.4, 0.7, 1.4),
				cf = cf * CFrame.new(2.2, 0.2, 1.6),
				color = Color3.fromRGB(78, 132, 62),
				material = Enum.Material.Grass,
				collide = false,
				query = false,
			})
			part({
				name = "Bloom",
				parent = props,
				shape = Enum.PartType.Ball,
				size = Vector3.new(0.45, 0.45, 0.45),
				cf = cf * CFrame.new(2.4, 0.7, 1.6),
				color = (n % 2 == 0) and Color3.fromRGB(220, 90, 96) or Color3.fromRGB(240, 200, 90),
				material = Enum.Material.SmoothPlastic,
				collide = false,
				query = false,
			})
		end
	end

	for n = 1, 28 do
		local angle = (n / 28) * math.pi * 2
		local radius = 168 + (n % 3) * 4
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		part({
			name = "Bush",
			parent = props,
			shape = Enum.PartType.Ball,
			size = Vector3.new(3.6, 2.4, 3.6),
			cf = CFrame.new(x, 2.3, z),
			color = (n % 2 == 0) and Color3.fromRGB(70, 128, 64) or Color3.fromRGB(96, 150, 74),
			material = Enum.Material.Grass,
			collide = false,
			query = false,
		})
		local bloom = {
			Color3.fromRGB(214, 96, 102),
			Color3.fromRGB(236, 196, 92),
			Color3.fromRGB(236, 236, 232),
		}
		part({
			name = "Flower",
			parent = props,
			shape = Enum.PartType.Ball,
			size = Vector3.new(0.9, 0.9, 0.9),
			cf = CFrame.new(x + 0.6, 3.4, z),
			color = bloom[(n % 3) + 1],
			material = Enum.Material.SmoothPlastic,
			collide = false,
			query = false,
		})
	end

	local function lamp(x, z)
		local cf = CFrame.new(x, 1.45, z)
		part({
			name = "LampPost",
			parent = props,
			size = Vector3.new(1.15, 12.5, 1.15),
			cf = cf * CFrame.new(0, 6.1, 0),
			color = Color3.fromRGB(62, 44, 30),
			material = Enum.Material.Wood,
		})
		part({
			name = "LampHead",
			parent = props,
			size = Vector3.new(2.4, 1.5, 2.4),
			cf = cf * CFrame.new(0, 12.4, 0),
			color = Color3.fromRGB(48, 36, 26),
			material = Enum.Material.Wood,
		})
		local bulb = part({
			name = "Lamp",
			parent = props,
			shape = Enum.PartType.Ball,
			size = Vector3.new(1.7, 1.7, 1.7),
			cf = cf * CFrame.new(0, 12.2, 0),
			color = Color3.fromRGB(255, 196, 110),
			material = Enum.Material.Neon,
			collide = false,
			query = false,
		})
		local glow = Instance.new("PointLight")
		glow.Color = Color3.fromRGB(255, 196, 120)
		glow.Brightness = 2.4
		glow.Range = 28
		glow.Parent = bulb
	end

	for _, spot in { -52, -30, 30, 52 } do
		lamp(spot, 9)
		lamp(spot, -9)
		lamp(9, spot)
		lamp(-9, spot)
	end

	for step = -64, 64, 8 do
		if math.abs(step) > 16 then
			for _, side in { -1, 1 } do
				part({
					name = "PathStone",
					parent = props,
					size = Vector3.new(3.4, 0.32, 0.55),
					cf = CFrame.new(step, 1.55, side * 6.6),
					color = Color3.fromRGB(126, 122, 112),
					material = Enum.Material.Slate,
					collide = false,
					query = false,
				})
				part({
					name = "PathStone",
					parent = props,
					size = Vector3.new(0.55, 0.32, 3.4),
					cf = CFrame.new(side * 6.6, 1.55, step),
					color = Color3.fromRGB(126, 122, 112),
					material = Enum.Material.Slate,
					collide = false,
					query = false,
				})
			end
		end
	end

	local blooms = {
		Color3.fromRGB(214, 86, 96),
		Color3.fromRGB(236, 196, 86),
		Color3.fromRGB(236, 236, 228),
		Color3.fromRGB(168, 112, 196),
	}
	for n = 1, 42 do
		local angle = (n / 42) * math.pi * 2 + 0.2
		local radius = 22 + (n % 6) * 5
		local x = math.cos(angle) * radius
		local z = math.sin(angle) * radius
		if not blocked(x, z, 2) then
			part({
				name = "Stem",
				parent = props,
				size = Vector3.new(0.12, 0.9, 0.12),
				cf = CFrame.new(x, 1.85, z),
				color = Color3.fromRGB(58, 110, 52),
				material = Enum.Material.Grass,
				collide = false,
				query = false,
			})
			part({
				name = "Bloom",
				parent = props,
				shape = Enum.PartType.Ball,
				size = Vector3.new(0.55, 0.55, 0.55),
				cf = CFrame.new(x, 2.35, z),
				color = blooms[(n % #blooms) + 1],
				material = Enum.Material.SmoothPlastic,
				collide = false,
				query = false,
			})
		end
	end

	for n = 1, 12 do
		local angle = (n / 12) * math.pi * 2
		part({
			name = "PondStone",
			parent = water,
			shape = Enum.PartType.Ball,
			size = Vector3.new(2.4, 1.5, 2.2),
			cf = CFrame.new(pond.X + math.cos(angle) * 22, 1.9, pond.Z + math.sin(angle) * 22),
			color = Color3.fromRGB(150, 146, 136),
			material = Enum.Material.Slate,
			collide = false,
			query = false,
		})
	end

	local function cliff(parent, angle, radius, height, width, depth, color, material)
		local pos = Vector3.new(math.cos(angle) * radius, height / 2 - 6, math.sin(angle) * radius)
		local cf = CFrame.lookAt(pos, Vector3.new(0, pos.Y, 0))
		part({
			name = "Cliff",
			parent = parent,
			size = Vector3.new(width, height, depth),
			cf = cf,
			color = color,
			material = material,
		})
		return cf, height
	end

	for i = 1, 36 do
		local angle = (i / 36) * math.pi * 2
		local radius = 232 + (i % 5) * 6
		local height = 46 + (i % 7) * 8
		local tone = 142 + (i % 4) * 10
		local cf = cliff(cliffs, angle, radius, height, 52, 36, Color3.fromRGB(tone, tone - 6, tone - 12), Enum.Material.Slate)
		part({
			name = "Cap",
			parent = cliffs,
			size = Vector3.new(30, height * 0.42, 22),
			cf = cf * CFrame.new((i % 2 == 0) and 8 or -8, height * 0.28, 4),
			color = Color3.fromRGB(tone - 18, tone - 20, tone - 22),
			material = Enum.Material.Basalt,
		})
		part({
			name = "Shoulder",
			parent = cliffs,
			size = Vector3.new(24, height * 0.55, 28),
			cf = cf * CFrame.new((i % 2 == 0) and -20 or 20, -height * 0.12, 8),
			color = Color3.fromRGB(tone + 6, tone, tone - 4),
			material = Enum.Material.Slate,
		})
	end

	for i = 1, 22 do
		local angle = (i / 22) * math.pi * 2 + 0.07
		local height = 92 + (i % 5) * 16
		local tone = 118 + (i % 3) * 8
		cliff(cliffs, angle, 318 + (i % 3) * 8, height, 78, 48, Color3.fromRGB(tone, tone - 4, tone - 8), Enum.Material.Basalt)
	end

	for i = 1, 42 do
		local angle = (i / 42) * math.pi * 2
		local pos = Vector3.new(math.cos(angle) * 186, 1.05, math.sin(angle) * 186)
		local cf = CFrame.lookAt(pos, Vector3.new(0, 1.05, 0))
		part({
			name = "Walk",
			parent = lobby,
			size = Vector3.new(32, 0.9, 18),
