  <Item class="StarterPlayer" referent="4">
    <Properties>
      <string name="Name">StarterPlayer</string>
    </Properties>
    <Item class="StarterPlayerScripts" referent="5">
      <Properties>
        <string name="Name">StarterPlayerScripts</string>
      </Properties>
    <Item class="LocalScript" referent="6">
      <Properties>
        <string name="Name">YamaClient</string>
        <ProtectedString name="Source"><![CDATA[-- Яма. LocalScript в StarterPlayerScripts. Камера, прицел и кнопки.
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local RunService = game:GetService("RunService")

local player = Players.LocalPlayer
local pickRemote = ReplicatedStorage:WaitForChild("YamaPick")
local actionRemote = ReplicatedStorage:WaitForChild("YamaAction")
local stateRemote = ReplicatedStorage:WaitForChild("YamaState")

local CHOICES = {
	{ id = "dictor", name = "Диктор", line = "Реплика, пауза и луч", color = Color3.fromRGB(92, 154, 230) },
	{ id = "tumba", name = "Тумба", line = "Врастает, баш на удар", color = Color3.fromRGB(198, 114, 66) },
	{ id = "otrazhatel", name = "Отражатель", line = "Окно «опа» и толчок", color = Color3.fromRGB(224, 198, 92) },
	{ id = "dvornik", name = "Дворник", line = "Тумбы, полив, струя", color = Color3.fromRGB(86, 168, 112) },
}

local KEYS = {
	[Enum.KeyCode.Q] = "q",
	[Enum.KeyCode.E] = "e",
	[Enum.KeyCode.R] = "r",
	[Enum.KeyCode.One] = "jacket",
	[Enum.KeyCode.Two] = "whistle",
	[Enum.KeyCode.Three] = "energy",
	[Enum.KeyCode.F] = "tap",
}

