local function pitCFrame(index)
	local angle = (index % 8) / 8 * math.pi * 2
	local pos = Vector3.new(math.cos(angle) * 58, 6, math.sin(angle) * 58)
	return CFrame.lookAt(pos, Vector3.new(0, 6, 0))
end

local function lobbyCFrame(index)
	local angle = (index % 10) / 10 * math.pi * 2
	local pos = Vector3.new(math.cos(angle) * 186, 6, math.sin(angle) * 186)
	return CFrame.lookAt(pos, Vector3.new(0, 4, 0))
end

local function newState()
	return {
		fighter = nil,
		hp = 900,
		maxHp = 900,
		mana = 100,
		maxMana = 100,
		gold = 0,
		kills = 0,
		deaths = 0,
		level = 1,
		xp = 0,
		alive = false,
		pendingSpawn = false,
		baseSpeed = 16,
		cd = { attack = 0, q = 0, e = 0, r = 0, jacket = 0, whistle = 0, energy = 0 },
		items = {},
		stunUntil = 0,
		silenceUntil = 0,
		disarmUntil = 0,
		slowUntil = 0,
		hasteUntil = 0,
		hasteMul = 1,
		energyUntil = 0,
		immuneUntil = 0,
		reflectUntil = 0,
		shield = 0,
		shieldUntil = 0,
		rooted = false,
		rootUntil = 0,
		bashReady = false,
		bashUntil = 0,
		invisibleUntil = 0,
		whistleAt = 0,
		channel = nil,
		castCount = 0,
		castBoost = false,
		lastCast = nil,
		xpTick = 0,
		swapAt = 0,
		streak = 0,
		guardUntil = 0,
	}
end

local function clearControl(st)
	st.stunUntil = 0
	st.silenceUntil = 0
	st.disarmUntil = 0
	st.slowUntil = 0
	st.hasteUntil = 0
	st.energyUntil = 0
	st.immuneUntil = 0
	st.reflectUntil = 0
	st.shield = 0
	st.shieldUntil = 0
	st.rooted = false
	st.rootUntil = 0
	st.bashReady = false
	st.channel = nil
	st.invisibleUntil = 0
	st.whistleAt = 0
	st.castBoost = false
	st.guardUntil = 0
end

local function rootPart(model)
	return model and model:FindFirstChild("HumanoidRootPart")
end

local function posOfModel(model)
	if not model then
		return nil
	end
	local root = model:FindFirstChild("HumanoidRootPart") or model.PrimaryPart
	return root and root.Position
end

local function teleport(character, cf)
	local root = rootPart(character)
	if not root then
		return
	end
	root.AssemblyLinearVelocity = Vector3.zero
	root.AssemblyAngularVelocity = Vector3.zero
	root.CFrame = cf
end

local function dress(character, style)
	local old = character:FindFirstChild("YamaSkin")
	if old then
		old:Destroy()
	end
	if not style then
		return
	end
	local torso = character:FindFirstChild("UpperTorso") or character:FindFirstChild("Torso")
	local head = character:FindFirstChild("Head")
	if not torso then
		return
	end
	local folder = Instance.new("Folder")
	folder.Name = "YamaSkin"
	folder.Parent = character
	local function bit(anchor, offset, size, color, material, shape, name)
		local piece = Instance.new("Part")
		piece.Name = name or "Bit"
		piece.Size = size
		piece.Color = color
		piece.Material = material or Enum.Material.SmoothPlastic
		piece.CanCollide = false
		piece.CanQuery = false
		piece.Massless = true
		piece.Anchored = false
		if shape then
			piece.Shape = shape
		end
		piece.Parent = folder
		local weld = Instance.new("Weld")
		weld.Part0 = anchor
		weld.Part1 = piece
		weld.C0 = offset
		weld.Parent = piece
		return piece
	end
	local function tint(name, color)
		local piece = character:FindFirstChild(name)
		if piece and piece:IsA("BasePart") then
			piece.Color = color
		end
	end
	local skin = Color3.fromRGB(214, 176, 148)
	tint("Head", skin)
	local function tintSet(names, color)
		for _, name in names do
			tint(name, color)
		end
	end
	local arms = { "LeftUpperArm", "LeftLowerArm", "LeftHand", "RightUpperArm", "RightLowerArm", "RightHand", "Left Arm", "Right Arm" }
	local legs = { "LeftUpperLeg", "LeftLowerLeg", "LeftFoot", "RightUpperLeg", "RightLowerLeg", "RightFoot", "Left Leg", "Right Leg" }
	if style == "dictor" then
		tint("UpperTorso", Color3.fromRGB(36, 78, 158))
		tint("Torso", Color3.fromRGB(36, 78, 158))
		tint("LowerTorso", Color3.fromRGB(24, 52, 118))
		tintSet(arms, Color3.fromRGB(232, 232, 236))
		tintSet(legs, Color3.fromRGB(28, 48, 102))
		bit(torso, CFrame.new(0, -0.2, 0.78), Vector3.new(1.85, 2.8, 0.14), Color3.fromRGB(236, 238, 244), Enum.Material.SmoothPlastic, nil, "Cape")
		bit(torso, CFrame.new(0, 0.62, 0.55), Vector3.new(2.05, 0.32, 0.42), Color3.fromRGB(246, 246, 250), Enum.Material.SmoothPlastic, nil, "Collar")
		bit(torso, CFrame.new(1.05, 0.35, 0.62) * CFrame.Angles(0, math.rad(25), math.rad(75)), Vector3.new(1.05, 0.48, 0.48), Color3.fromRGB(210, 214, 222), Enum.Material.Metal, Enum.PartType.Cylinder, "Megaphone")
		if head then
			bit(head, CFrame.new(-0.62, 0.1, 0), Vector3.new(0.32, 0.32, 0.32), Color3.fromRGB(24, 24, 28), Enum.Material.SmoothPlastic, Enum.PartType.Ball, "Ear")
			bit(head, CFrame.new(0.62, 0.1, 0), Vector3.new(0.32, 0.32, 0.32), Color3.fromRGB(24, 24, 28), Enum.Material.SmoothPlastic, Enum.PartType.Ball, "Ear")
			bit(head, CFrame.new(0, 0.18, 0), Vector3.new(1.2, 0.14, 0.28), Color3.fromRGB(24, 24, 28), Enum.Material.SmoothPlastic, nil, "Band")
		end
	elseif style == "tumba" then
		tint("UpperTorso", Color3.fromRGB(122, 72, 42))
		tint("Torso", Color3.fromRGB(122, 72, 42))
		tint("LowerTorso", Color3.fromRGB(78, 48, 28))
		tintSet(arms, Color3.fromRGB(92, 58, 36))
		tintSet(legs, Color3.fromRGB(64, 42, 28))
		bit(torso, CFrame.new(-1.35, 0.45, 0), Vector3.new(1.25, 0.72, 1.45), Color3.fromRGB(92, 58, 36), Enum.Material.Wood, nil, "Pad")
		bit(torso, CFrame.new(1.35, 0.45, 0), Vector3.new(1.25, 0.72, 1.45), Color3.fromRGB(92, 58, 36), Enum.Material.Wood, nil, "Pad")
		bit(torso, CFrame.new(0, 0.05, 0.78), Vector3.new(1.55, 1.9, 0.38), Color3.fromRGB(64, 42, 28), Enum.Material.Wood, nil, "Backplate")
		bit(torso, CFrame.new(0, -0.85, 0), Vector3.new(2.2, 0.28, 1.15), Color3.fromRGB(42, 30, 22), Enum.Material.Wood, nil, "Belt")
		if head then
			bit(head, CFrame.new(0, 0.4, 0), Vector3.new(1.55, 0.7, 1.55), Color3.fromRGB(74, 48, 30), Enum.Material.Wood, nil, "Helm")
			bit(head, CFrame.new(-0.55, 0.85, 0), Vector3.new(0.28, 0.55, 0.28), Color3.fromRGB(92, 64, 40), Enum.Material.Wood, nil, "Horn")
			bit(head, CFrame.new(0.55, 0.85, 0), Vector3.new(0.28, 0.55, 0.28), Color3.fromRGB(92, 64, 40), Enum.Material.Wood, nil, "Horn")
		end
	elseif style == "otrazhatel" then
		tint("UpperTorso", Color3.fromRGB(186, 146, 42))
		tint("Torso", Color3.fromRGB(186, 146, 42))
		tint("LowerTorso", Color3.fromRGB(120, 92, 32))
		tintSet(arms, Color3.fromRGB(214, 206, 196))
		tintSet(legs, Color3.fromRGB(92, 78, 48))
		bit(torso, CFrame.new(0, 0.05, 0.82), Vector3.new(1.85, 2.45, 0.2), Color3.fromRGB(214, 170, 58), Enum.Material.Metal, nil, "Shield")
		bit(torso, CFrame.new(0, 0.15, 0.96), Vector3.new(0.85, 1.05, 0.08), Color3.fromRGB(255, 236, 170), Enum.Material.Neon, nil, "Mirror")
		bit(torso, CFrame.new(-1.15, 0.35, 0), Vector3.new(0.45, 0.85, 1.05), Color3.fromRGB(196, 198, 204), Enum.Material.Metal, nil, "Guard")
		bit(torso, CFrame.new(1.15, 0.35, 0), Vector3.new(0.45, 0.85, 1.05), Color3.fromRGB(196, 198, 204), Enum.Material.Metal, nil, "Guard")
		if head then
			bit(head, CFrame.new(0, 0.15, -0.45), Vector3.new(1.25, 0.42, 0.16), Color3.fromRGB(230, 220, 160), Enum.Material.Metal, nil, "Visor")
		end
	elseif style == "dvornik" then
		tint("UpperTorso", Color3.fromRGB(46, 112, 64))
		tint("Torso", Color3.fromRGB(46, 112, 64))
		tint("LowerTorso", Color3.fromRGB(32, 72, 44))
		tintSet(arms, Color3.fromRGB(214, 176, 148))
		tintSet(legs, Color3.fromRGB(58, 72, 86))
		bit(torso, CFrame.new(0, 0.05, -0.55), Vector3.new(1.85, 1.55, 0.16), Color3.fromRGB(86, 158, 92), Enum.Material.Fabric, nil, "Vest")
		bit(torso, CFrame.new(0.55, 1.15, 0.78), Vector3.new(0.28, 5.2, 0.28), Color3.fromRGB(120, 82, 48), Enum.Material.Wood, nil, "Broom")
		bit(torso, CFrame.new(0.55, 3.4, 0.78), Vector3.new(1.35, 1.15, 0.55), Color3.fromRGB(92, 150, 72), Enum.Material.Grass, nil, "Bristle")
		bit(torso, CFrame.new(-0.85, -0.15, 0.62), Vector3.new(0.7, 0.85, 0.35), Color3.fromRGB(92, 64, 40), Enum.Material.Fabric, nil, "Bag")
		if head then
			bit(head, CFrame.new(0, 0.55, 0), Vector3.new(1.45, 0.35, 1.45), Color3.fromRGB(42, 92, 52), Enum.Material.Fabric, Enum.PartType.Cylinder, "Cap")
			bit(head, CFrame.new(0, 0.38, -0.62), Vector3.new(1.5, 0.12, 0.55), Color3.fromRGB(32, 70, 40), Enum.Material.Fabric, nil, "Brim")
		end
	end
end

local function paint(character, color, title, hp, maxHp, style)
	local shirt = character:FindFirstChildOfClass("Shirt")
	if shirt then
		shirt:Destroy()
	end
	local pants = character:FindFirstChildOfClass("Pants")
	if pants then
		pants:Destroy()
	end
	local graphic = character:FindFirstChildOfClass("ShirtGraphic")
	if graphic then
		graphic:Destroy()
	end
	local body = character:FindFirstChildOfClass("BodyColors")
	if body then
		body.HeadColor3 = color
		body.TorsoColor3 = color
		body.LeftArmColor3 = color
		body.RightArmColor3 = color
		body.LeftLegColor3 = color
		body.RightLegColor3 = color
	end
	for _, child in character:GetChildren() do
		if child:IsA("BasePart") and child.Name ~= "HumanoidRootPart" then
			child.Color = color
		end
	end
	local old = character:FindFirstChild("FighterTag")
	if old then
		old:Destroy()
	end
	local head = character:FindFirstChild("Head") or rootPart(character)
	if not head then
		return
	end
	local board = Instance.new("BillboardGui")
	board.Name = "FighterTag"
	board.Size = UDim2.fromOffset(140, 36)
	board.StudsOffset = Vector3.new(0, 3.2, 0)
	board.AlwaysOnTop = true
	board.Parent = head
	local name = Instance.new("TextLabel")
	name.Name = "Name"
	name.Size = UDim2.new(1, 0, 0, 18)
	name.BackgroundTransparency = 1
	name.Font = Enum.Font.GothamBold
	name.TextSize = 14
	name.TextColor3 = Color3.new(1, 1, 1)
	name.TextStrokeTransparency = 0.4
	name.Text = title
	name.Parent = board
	local back = Instance.new("Frame")
	back.Name = "Back"
	back.Size = UDim2.new(1, -10, 0, 8)
	back.Position = UDim2.fromOffset(5, 22)
	back.BackgroundColor3 = Color3.fromRGB(20, 20, 20)
	back.BorderSizePixel = 0
	back.Parent = board
	local fill = Instance.new("Frame")
	fill.Name = "Fill"
	fill.Size = UDim2.new(math.clamp(hp / math.max(maxHp, 1), 0, 1), 0, 1, 0)
	fill.BackgroundColor3 = color
	fill.BorderSizePixel = 0
	fill.Parent = back
	dress(character, style)
end

local function refreshBar(model, hp, maxHp)
	local fill = model and model:FindFirstChild("Fill", true)
	if fill and fill:IsA("Frame") and fill.Parent and fill.Parent.Name == "Back" then
		fill.Size = UDim2.new(math.clamp(hp / math.max(maxHp, 1), 0, 1), 0, 1, 0)
	end
end

local function burst(position, color, size, life)
	local blob = Instance.new("Part")
	blob.Name = "Burst"
	blob.Shape = Enum.PartType.Ball
	blob.Size = Vector3.new(size, size, size)
	blob.CFrame = CFrame.new(position)
	blob.Anchored = true
	blob.CanCollide = false
	blob.CanQuery = false
	blob.Material = Enum.Material.Neon
	blob.Color = color
	blob.Parent = fxFolder
	Debris:AddItem(blob, life or 0.25)
end

