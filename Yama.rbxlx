		{ 0.08, { RightShoulder = CFrame.Angles(math.rad(75), math.rad(25), math.rad(-35)), LeftShoulder = CFrame.Angles(math.rad(20), 0, math.rad(30)), Waist = CFrame.Angles(0, math.rad(35), 0), Neck = CFrame.Angles(math.rad(10), math.rad(20), 0) } },
