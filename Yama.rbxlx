local function abilityBox(x, keyName, titleText)
	local box = Instance.new("Frame")
	box.Size = UDim2.fromOffset(92, 64)
	box.Position = UDim2.new(0.5, x, 1, -88)
	box.BackgroundColor3 = Color3.fromRGB(22, 22, 28)
